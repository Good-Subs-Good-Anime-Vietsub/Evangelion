Dialogue: 0,0:00:01.16,0:00:06.95,Default,,0,0,0,,♪ 残酷な天使のように
Dialogue: 0,0:00:07.08,0:00:14.09,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:00:15.05,0:00:22.05,Default,,0,0,0,,♪
Dialogue: 0,0:00:22.97,0:00:25.85,Default,,0,0,0,,♪ 蒼(あお)い風がいま
Dialogue: 0,0:00:25.97,0:00:29.56,Default,,0,0,0,,♪ 胸のドアを叩(たた)いても
Dialogue: 0,0:00:29.69,0:00:33.27,Default,,0,0,0,,♪ 私だけを\N　　　ただ見つめて
Dialogue: 0,0:00:33.40,0:00:37.57,Default,,0,0,0,,♪ 微(ほほ)笑(え)んでるあなた
Dialogue: 0,0:00:37.69,0:00:40.65,Default,,0,0,0,,♪ そっとふれるもの
Dialogue: 0,0:00:40.78,0:00:44.49,Default,,0,0,0,,♪ もとめることに\N　　　　　　　夢中で
Dialogue: 0,0:00:44.62,0:00:48.16,Default,,0,0,0,,♪ 運命さえ\N　　　まだ知らない
Dialogue: 0,0:00:48.29,0:00:52.04,Default,,0,0,0,,♪ いたいけな瞳
Dialogue: 0,0:00:52.17,0:00:55.79,Default,,0,0,0,,♪ だけどいつか\N　　　気付くでしょう
Dialogue: 0,0:00:55.92,0:00:58.76,Default,,0,0,0,,♪ その背中には
Dialogue: 0,0:00:59.72,0:01:01.51,Default,,0,0,0,,♪ 遥(はる)か未来
Dialogue: 0,0:01:01.63,0:01:06.72,Default,,0,0,0,,♪ めざすための\N　　　羽根があること
Dialogue: 0,0:01:07.10,0:01:10.85,Default,,0,0,0,,♪ 残酷な天使のテーゼ
Dialogue: 0,0:01:10.98,0:01:14.10,Default,,0,0,0,,♪ 窓辺から\N　　　やがて飛び立つ
Dialogue: 0,0:01:14.61,0:01:18.32,Default,,0,0,0,,♪ ほとばしる\N　　　熱いパトスで
Dialogue: 0,0:01:18.44,0:01:21.61,Default,,0,0,0,,♪ 思い出を裏切るなら
Dialogue: 0,0:01:22.07,0:01:25.66,Default,,0,0,0,,♪ この宇宙(そら)を\N　　　　抱いて輝く
Dialogue: 0,0:01:25.78,0:01:29.58,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:01:32.25,0:01:33.17,Default,,0,0,0,,Đúng vậy
Dialogue: 0,0:01:33.29,0:01:35.96,Default,,0,0,0,,Vấn đề đó thì đã báo cáo cho Ủy ban rồi
Dialogue: 0,0:01:36.67,0:01:40.88,Default,,0,0,0,,Hàng hóa đã rời cảng Sasebo hôm qua, hiện đang trên Thái Bình Dương
Dialogue: 0,0:01:41.09,0:01:43.88,Default,,0,0,0,,
Dialogue: 0,0:01:44.59,0:01:46.68,Default,,0,0,0,,Trực thăng vận tải Mil-55D!
Dialogue: 0,0:01:47.22,0:01:50.89,Default,,0,0,0,,Không nhờ việc này thì cả đời cũng không có cơ hội ngồi trên đây
Dialogue: 0,0:01:51.02,0:01:53.39,Default,,0,0,0,,Tất cả là nhờ có anh em chí cốt!
Dialogue: 0,0:01:53.52,0:01:54.56,Default,,0,0,0,,Ha? Shinji
Dialogue: 0,0:01:54.69,0:01:55.69,Default,,0,0,0,,Hả?
Dialogue: 0,0:01:55.81,0:01:57.44,Default,,0,0,0,,Ở trong cùng một vùng núi mỗi ngày
Dialogue: 0,0:01:57.56,0:01:59.23,Default,,0,0,0,,thì chắc ngột ngạt lắm ha
Dialogue: 0,0:01:59.36,0:02:02.03,Default,,0,0,0,,Hiếm khi có ngày chủ nhật nên các em đi chơi với chị không?
Dialogue: 0,0:02:02.40,0:02:04.15,Default,,0,0,0,,HẢ?? Vậy thì hôm nay
Dialogue: 0,0:02:04.28,0:02:06.70,Default,,0,0,0,,Tụi em thiệc sự được đi chơi với chị hả??
Dialogue: 0,0:02:06.82,0:02:09.74,Default,,0,0,0,,Em đã mua cái nón này riêng cho ngày hôm nay đó
Dialogue: 0,0:02:09.87,0:02:11.16,Default,,0,0,0,,Chị Misato~
Dialogue: 0,0:02:11.29,0:02:12.62,Default,,0,0,0,,Vậy giờ mình đi đâu?
Dialogue: 0,0:02:13.21,0:02:16.08,Default,,0,0,0,,Đi du ngoạn trên Thái Bình Dương bằng một con tàu sang chảnh đó!
Dialogue: 0,0:02:19.09,0:02:21.84,Default,,0,0,0,,Ôi! 5 tàu sân bay, 4 chiếm hạm!
Dialogue: 0,0:02:21.96,0:02:23.26,Default,,0,0,0,,Một hạm đội khổng lồ!
Dialogue: 0,0:02:23.38,0:02:26.09,Default,,0,0,0,,Thật sự là nhờ anh em chí cốt cả ha!
Dialogue: 0,0:02:26.22,0:02:27.93,Default,,0,0,0,,Này là con tàu sang chảnh á hả?
Dialogue: 0,0:02:28.26,0:02:29.68,Default,,0,0,0,,Sang thật mà!
Dialogue: 0,0:02:29.81,0:02:33.73,Default,,0,0,0,,Đúng là tàu sân bay chính quy mà lực lượng Liên Hợp Quốc tự hào: "Over the Rainbow"
Dialogue: 0,0:02:33.85,0:02:35.14,Default,,0,0,0,,Bự quá ha...
Dialogue: 0,0:02:35.27,0:02:38.27,Default,,0,0,0,,Con tàu cũ vậy mà sao nó vẫn nổi được ta
Dialogue: 0,0:02:38.40,0:02:39.65,Default,,0,0,0,,Không đâu
Dialogue: 0,0:02:39.77,0:02:42.69,Default,,0,0,0,,Này là đồ cổ từ trước Chấn động thứ hai đó
Dialogue: 0,0:02:43.74,0:02:45.86,Default,,0,0,0,,Hừ, khoái chí dữ ha.
Dialogue: 0,0:02:46.49,0:02:48.78,Default,,0,0,0,,Còn vác tới đây cái ổ cắm đồ chơi nữa
Dialogue: 0,0:02:49.32,0:02:50.28,Default,,0,0,0,,Lũ nhóc rách việc!
Dialogue: 0,0:03:00.04,0:03:03.30,Default,,0,0,0,,Ối!! Ngầu quá, ngầu quá, ngầu quá!
Dialogue: 0,0:03:03.51,0:03:05.72,Default,,0,0,0,,Ngầu quá, ngầu quá, ngầu quá!
Dialogue: 0,0:03:05.84,0:03:06.88,Default,,0,0,0,,Ngầu đét luôn!
Dialogue: 0,0:03:07.01,0:03:10.43,Default,,0,0,0,,Là đàn ông, phải rơi nước mắt khi thấy cảnh này thôi!
Dialogue: 0,0:03:10.55,0:03:12.81,Default,,0,0,0,,Á!! Ngầu quá, ngầu quá, ngầu quá!
Dialogue: 0,0:03:12.93,0:03:14.77,Default,,0,0,0,,Ngầu quá, ngầu quá!!
Dialogue: 0,0:03:14.89,0:03:17.60,Default,,0,0,0,,Á!! Chờ cái !!
Dialogue: 0,0:03:18.52,0:03:19.77,Default,,0,0,0,,Óap~
Dialogue: 0,0:03:19.90,0:03:21.57,Default,,0,0,0,,Hm...
Dialogue: 0,0:03:22.11,0:03:23.69,Default,,0,0,0,,Khỉ thật chứ!
Dialogue: 0,0:03:23.98,0:03:26.15,Default,,0,0,0,,Dừng lại, dừng lại coi!
Dialogue: 0,0:03:27.20,0:03:28.45,Default,,0,0,0,,Á!
Dialogue: 0,0:03:29.11,0:03:29.95,Default,,0,0,0,,Ơ...
Dialogue: 0,0:03:30.07,0:03:33.41,Default,,0,0,0,,Hello, Misato, chị vẫn khỏe chứ?
Dialogue: 0,0:03:33.95,0:03:36.71,Default,,0,0,0,,Cũng khỏe, mà hình như em cao lên rồi nhỉ
Dialogue: 0,0:03:36.83,0:03:40.63,Default,,0,0,0,,Ừ, mấy chỗ khác cũng ra dáng con gái hơn rồi á
Dialogue: 0,0:03:41.34,0:03:42.59,Default,,0,0,0,,Chị giới thiệu nha
Dialogue: 0,0:03:42.71,0:03:45.26,Default,,0,0,0,,Phi công chuyên trách Evangelion Unit-02
Dialogue: 0,0:03:45.38,0:03:49.30,Default,,0,0,0,,Đứa trẻ thứ hai: Sōryū Asuka Langley
Dialogue: 0,0:03:53.97,0:03:55.27,Default,,0,0,0,,Mày làm gì vậy hả?
Dialogue: 0,0:03:55.39,0:03:56.64,Default,,0,0,0,,Ah...
Dialogue: 0,0:03:57.48,0:03:59.60,Default,,0,0,0,,Cái giá cho việc nhìn đó, rẻ mà ha?
Dialogue: 0,0:03:59.85,0:04:00.90,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:04:01.02,0:04:02.77,Default,,0,0,0,,Cái đó thì tụi này cho xem cũng được vậy!
Dialogue: 0,0:04:03.73,0:04:04.57,Default,,0,0,0,,Á!!!
Dialogue: 0,0:04:05.28,0:04:06.61,Default,,0,0,0,,Làm gì vậy hả!
Dialogue: 0,0:04:08.53,0:04:11.66,Default,,0,0,0,,Vậy, Đứa trẻ thứ ba trong lời đồn đâu?
Dialogue: 0,0:04:11.99,0:04:13.37,Default,,0,0,0,,Không lẽ là cái gã...
Dialogue: 0,0:04:13.91,0:04:16.33,Default,,0,0,0,,Không, là cậu bé này
Dialogue: 0,0:04:17.25,0:04:19.42,Default,,0,0,0,,Hmm... Nhìn chán vậy?
Dialogue: 0,0:04:20.29,0:04:21.21,Default,,0,0,0,,Ôi dào ôi dào
Dialogue: 0,0:04:21.33,0:04:24.25,Default,,0,0,0,,Tôi cứ tưởng là chị cầm đầu đám nhóc đi hướng đạo sinh
Dialogue: 0,0:04:24.88,0:04:27.67,Default,,0,0,0,,Chắc là chúng tôi đã hiểu nhầm rồi
Dialogue: 0,0:04:28.38,0:04:31.09,Default,,0,0,0,,Ông hiểu cho là chúng tôi mừng rồi, thuyền trưởng
Dialogue: 0,0:04:31.68,0:04:33.18,Default,,0,0,0,,Không đâu, chúng tôi mới nên mừng, lâu ngày không gặp
Dialogue: 0,0:04:33.18,0:04:34.68,Default,,0,0,0,,Không đâu, chúng tôi mới nên mừng, lâu ngày không gặp
Dialogue: 0,0:04:33.18,0:04:34.68,Default,,0,0,0,,Woaa~ Ngầu quá, ngầu quá!
Dialogue: 0,0:04:34.68,0:04:34.81,Default,,0,0,0,,Woaa~ Ngầu quá, ngầu quá!
Dialogue: 0,0:04:34.81,0:04:37.02,Default,,0,0,0,,Woaa~ Ngầu quá, ngầu quá!
Dialogue: 0,0:04:34.81,0:04:37.02,Default,,0,0,0,,Được trông nom bọn trẻ tôi thấy vui lắm
Dialogue: 0,0:04:37.52,0:04:39.94,Default,,0,0,0,,Cảm ơn ông lần này đã hỗ trợ chúng tôi
Dialogue: 0,0:04:40.06,0:04:41.69,Default,,0,0,0,,vận chuyển Eva Unit-02
Dialogue: 0,0:04:42.19,0:04:44.77,Default,,0,0,0,,Đây là bản thông số kỹ thuật của ổ nguồn điện khẩn cấp.
Dialogue: 0,0:04:45.40,0:04:48.32,Default,,0,0,0,,Nói chung là tôi chưa hề nhận được yêu cầu nào
Dialogue: 0,0:04:48.44,0:04:50.95,Default,,0,0,0,,Về việc cho con búp bê kia hoạt động trên cái biển này cả.
Dialogue: 0,0:04:51.53,0:04:53.95,Default,,0,0,0,,"Phòng cháy hơn chữa cháy"
Dialogue: 0,0:04:54.07,0:04:55.49,Default,,0,0,0,,Ông có thể xem như là vậy được không?
Dialogue: 0,0:04:56.20,0:05:00.41,Default,,0,0,0,,Hạm đội Thái Bình Dương chúng tôi đang bảo vệ nhằm "Phòng cháy" rồi
Dialogue: 0,0:05:00.41,0:05:01.00,Default,,0,0,0,,Hạm đội Thái Bình Dương chúng tôi đang làm công tác "Phòng cháy" cô nói rồi
Dialogue: 0,0:05:00.41,0:05:01.00,Default,,0,0,0,,Ngầu quá, ngầu quá!
Dialogue: 0,0:05:01.00,0:05:01.37,Default,,0,0,0,,Ngầu quá, ngầu quá!
Dialogue: 0,0:05:01.37,0:05:02.17,Default,,0,0,0,,Ngầu quá, ngầu quá!
Dialogue: 0,0:05:01.37,0:05:02.17,Default,,0,0,0,,Từ bao giờ quân đội Liên Hợp Quốc đổi sang nghề chuyển phát nhanh vậy?
Dialogue: 0,0:05:02.17,0:05:02.29,Default,,0,0,0,,Từ bao giờ quân đội Liên Hợp Quốc đổi sang nghề chuyển phát nhanh vậy?
Dialogue: 0,0:05:02.29,0:05:03.63,Default,,0,0,0,,Từ bao giờ quân đội Liên Hợp Quốc đổi sang nghề chuyển phát nhanh vậy?
Dialogue: 0,0:05:02.29,0:05:03.63,Default,,0,0,0,,Ngầuuu quáaa
Dialogue: 0,0:05:03.63,0:05:03.75,Default,,0,0,0,,Từ bao giờ quân đội Liên Hợp Quốc đổi sang nghề chuyển phát nhanh vậy?
Dialogue: 0,0:05:03.75,0:05:05.21,Default,,0,0,0,,Từ bao giờ quân đội Liên Hợp Quốc đổi sang nghề chuyển phát nhanh vậy?
Dialogue: 0,0:05:03.75,0:05:05.21,Default,,0,0,0,,Woahh ngầuuu quáaa
Dialogue: 0,0:05:05.21,0:05:05.38,Default,,0,0,0,,Woahh ngầuuu quáaa
Dialogue: 0,0:05:05.38,0:05:05.67,Default,,0,0,0,,Woahh ngầuuu quáaa
Dialogue: 0,0:05:05.38,0:05:05.67,Default,,0,0,0,,（副長）\N某組織が結成されたあとだと\N記憶しておりますが Nhớ không lầm là từ khi tổ chức nào đó được thành lập
Dialogue: 0,0:05:05.67,0:05:05.79,Default,,0,0,0,,Nhớ không lầm là từ khi tổ chức nào đó được thành lập
Dialogue: 0,0:05:05.79,0:05:08.76,Default,,0,0,0,,Nhớ không lầm là từ khi tổ chức nào đó được thành lập
Dialogue: 0,0:05:05.79,0:05:08.76,Default,,0,0,0,,Ngầu quá!!
Dialogue: 0,0:05:09.55,0:05:12.55,Default,,0,0,0,,Chỉ để chở một món đồ chơi mà phải bố trí bảo vệ hoành tráng thế này
Dialogue: 0,0:05:12.68,0:05:14.93,Default,,0,0,0,,Hạm đội Thái Bình Dương phải có mặt vì lẽ này hả
Dialogue: 0,0:05:15.05,0:05:17.93,Default,,0,0,0,,Nếu xét thấy mức độ quan trọng của Eva là chưa đủ
Dialogue: 0,0:05:18.72,0:05:20.43,Default,,0,0,0,,Vậy xin hãy kí vào tờ...
Dialogue: 0,0:05:20.56,0:05:23.69,Default,,0,0,0,,Chưa đâu! Hạm đội này đang canh giữ
Dialogue: 0,0:05:23.81,0:05:26.61,Default,,0,0,0,,Eva Unit-02 và người điều khiển nó cho Chi nhánh 3 bên Đức
Dialogue: 0,0:05:26.73,0:05:28.32,Default,,0,0,0,,Các người không được phép tự tiện!
Dialogue: 0,0:05:29.03,0:05:30.53,Default,,0,0,0,,Vậy khi nào thì bàn giao?
Dialogue: 0,0:05:30.65,0:05:31.49,Default,,0,0,0,,Sau khi chở tới
Dialogue: 0,0:05:31.61,0:05:33.24,Default,,0,0,0,,Shin-Yokosuka
Dialogue: 0,0:05:33.78,0:05:36.37,Default,,0,0,0,,Biển này thuộc thẩm quyền của tôi
Dialogue: 0,0:05:36.49,0:05:37.91,Default,,0,0,0,,Hãy im lặng và tuân theo đi!
Dialogue: 0,0:05:38.41,0:05:39.87,Default,,0,0,0,,Chúng tôi hiểu rồi
Dialogue: 0,0:05:40.00,0:05:42.92,Default,,0,0,0,,Tuy nhiên, trong trường hợp khẩn cấp, quyền chỉ huy của NERV
Dialogue: 0,0:05:43.04,0:05:45.63,Default,,0,0,0,,là ưu tiên trên hết, mong ông đừng quên
Dialogue: 0,0:05:45.75,0:05:47.25,Default,,0,0,0,,Chất quá~
Dialogue: 0,0:05:47.38,0:05:48.80,Default,,0,0,0,,Cứ y như chị Ritsuko
Dialogue: 0,0:05:48.92,0:05:51.42,Default,,0,0,0,,Vẫn phong độ như mọi khi nhề!
Dialogue: 0,0:05:51.55,0:05:52.59,Default,,0,0,0,,Anh Kaji
Dialogue: 0,0:05:52.72,0:05:53.55,Default,,0,0,0,,Chào!
Dialogue: 0,0:05:53.88,0:05:54.72,Default,,0,0,0,,Ớ!?
Dialogue: 0,0:05:54.84,0:05:55.76,Default,,0,0,0,,Kaji!
Dialogue: 0,0:05:55.89,0:05:58.01,Default,,0,0,0,,Tôi đâu nhớ là có kêu anh lên buồng lái
Dialogue: 0,0:05:58.14,0:05:58.97,Default,,0,0,0,,Vậy cho tôi xin lỗi
Dialogue: 0,0:05:59.93,0:06:01.10,Default,,0,0,0,,Giờ thì, tôi xin phép
Dialogue: 0,0:06:01.10,0:06:01.89,Default,,0,0,0,,Giờ thì, tôi xin phép
Dialogue: 0,0:06:01.10,0:06:01.89,Default,,0,0,0,,Vầy mà là đi chơi hả?
Dialogue: 0,0:06:01.89,0:06:02.02,Default,,0,0,0,,Vầy mà là đi chơi hả?
Dialogue: 0,0:06:02.02,0:06:02.89,Default,,0,0,0,,Vầy mà là đi chơi hả?
Dialogue: 0,0:06:02.02,0:06:02.89,Default,,0,0,0,,Xin nhờ ông vận chuyển tới Shin-Yokosuka
Dialogue: 0,0:06:02.89,0:06:03.02,Default,,0,0,0,,Xin nhờ ông vận chuyển tới Shin-Yokosuka
Dialogue: 0,0:06:03.02,0:06:04.39,Default,,0,0,0,,Xin nhờ ông vận chuyển tới Shin-Yokosuka
Dialogue: 0,0:06:03.02,0:06:04.39,Default,,0,0,0,,Ngầu quá, NGẦU QUÁ!
Dialogue: 0,0:06:04.39,0:06:04.56,Default,,0,0,0,,Quá ngầu luôn!
Dialogue: 0,0:06:05.15,0:06:08.65,Default,,0,0,0,,Khỉ thật! Con nít mà lại đi bảo vệ thế giới à?
Dialogue: 0,0:06:08.77,0:06:10.73,Default,,0,0,0,,Chắc là thời thế đã thay đổi rồi
Dialogue: 0,0:06:10.86,0:06:14.03,Default,,0,0,0,,Nghe nói cả Quốc hội cũng đang kỳ vọng vào con robot đó
Dialogue: 0,0:06:14.15,0:06:16.66,Default,,0,0,0,,Món đồ chơi đó sao? Lũ ngốc!
Dialogue: 0,0:06:17.66,0:06:21.83,Default,,0,0,0,,Nhiều tiền vậy thì đưa cho chúng ta phải tốt hơn không
Dialogue: 0,0:06:25.58,0:06:28.21,Default,,0,0,0,,Sao anh lại ở đây cơ chứ?
Dialogue: 0,0:06:28.88,0:06:32.21,Default,,0,0,0,,Thì từ Đức đi công tác chung với con bé qua
Dialogue: 0,0:06:32.34,0:06:34.05,Default,,0,0,0,,Bất cẩn quá
Dialogue: 0,0:06:34.17,0:06:36.93,Default,,0,0,0,,Đáng lẽ phải nghĩ tới tình huống này...
Dialogue: 0,0:06:37.05,0:06:38.68,Default,,0,0,0,,Này! Không được đụng vào!
Dialogue: 0,0:06:38.80,0:06:40.06,Default,,0,0,0,,Đâu còn cách nào khác! \NHổng còn cách nào khác á!
Dialogue: 0,0:06:42.98,0:06:45.44,Default,,0,0,0,,Em đang hẹn hò với ai chứ?
Dialogue: 0,0:06:46.06,0:06:47.85,Default,,0,0,0,,Rồi liên quan gì tới anh?
Dialogue: 0,0:06:48.48,0:06:50.11,Default,,0,0,0,,Ơ kìa? Phũ vậy sao~
Dialogue: 0,0:06:50.23,0:06:51.07,Default,,0,0,0,,Hừ...
Dialogue: 0,0:06:51.78,0:06:53.99,Default,,0,0,0,,Em đang sống chung với Katsuragi hả?
Dialogue: 0,0:06:54.36,0:06:55.45,Default,,0,0,0,,Ưm... Dạ
Dialogue: 0,0:06:56.28,0:06:59.62,Default,,0,0,0,,Cô ấy sửa tật nằm lộn xộn khi ngủ rồi chứ?
Dialogue: 0,0:07:00.03,0:07:01.91,Default,,0,0,0,,HẢA!!??
Dialogue: 0,0:07:02.04,0:07:03.41,Default,,0,0,0,,A-... Anh...
Dialogue: 0,0:07:04.41,0:07:06.16,Default,,0,0,0,,Anh nói gì vậy hả !?
Dialogue: 0,0:07:07.12,0:07:09.33,Default,,0,0,0,,Như mọi khi ha, Shinji
Dialogue: 0,0:07:09.84,0:07:11.30,Default,,0,0,0,,Dạ
Dialogue: 0,0:07:11.42,0:07:13.59,Default,,0,0,0,,Ơ mà, sao anh biết tên em?
Dialogue: 0,0:07:13.71,0:07:14.88,Default,,0,0,0,,Điều đó anh phải biết chứ
Dialogue: 0,0:07:15.42,0:07:18.09,Default,,0,0,0,,Tại em nổi tiếng khắp thế giới này mà
Dialogue: 0,0:07:18.22,0:07:20.51,Default,,0,0,0,,Là Đứa trẻ thứ ba đã điều khiển Eva đi chiến đấu thực tế
Dialogue: 0,0:07:20.64,0:07:21.56,Default,,0,0,0,,mà không qua huấn luyện nào cả
Dialogue: 0,0:07:22.72,0:07:25.56,Default,,0,0,0,,Dạ, cái đó... tình cờ thôi ạ
Dialogue: 0,0:07:25.68,0:07:27.39,Default,,0,0,0,,Tình cờ cũng là một phần của duyên số đó
Dialogue: 0,0:07:27.52,0:07:28.94,Default,,0,0,0,,Đó là tài năng của em
Dialogue: 0,0:07:30.02,0:07:31.86,Default,,0,0,0,,Vậy nhé, hẹn gặp lại\N Dạ
Dialogue: 0,0:07:32.02,0:07:33.78,Default,,0,0,0,,Đùa sao... đây là ác mộng...
Dialogue: 0,0:07:36.86,0:07:38.99,Default,,0,0,0,,Sao rồi? Thấy Ikari Shinji như nào?
Dialogue: 0,0:07:39.11,0:07:40.28,Default,,0,0,0,,Thằng nhóc chán phèo
Dialogue: 0,0:07:40.41,0:07:42.74,Default,,0,0,0,,Như thế mà cũng là Đứa trẻ thứ ba được chọn sao?
Dialogue: 0,0:07:42.87,0:07:43.74,Default,,0,0,0,,Vỡ mộng thật
Dialogue: 0,0:07:43.87,0:07:46.50,Default,,0,0,0,,Thế nhưng trong một trận chiến khẩn cấp
Dialogue: 0,0:07:46.62,0:07:48.83,Default,,0,0,0,,Tỉ lệ đồng bộ của cậu ta dễ dàng vượt mức 40\NKhông thể!
Dialogue: 0,0:07:50.00,0:07:52.75,Default,,0,0,0,,Nói chứ, ông thuyền trưởng đó khó ưa ghê
Dialogue: 0,0:07:52.88,0:07:54.96,Default,,0,0,0,,Ổng là người tự kiêu mà
Dialogue: 0,0:07:55.09,0:07:57.59,Default,,0,0,0,,Nên ổng thích nói mỉa ít nhất vài câu
Dialogue: 0,0:07:57.72,0:08:00.72,Default,,0,0,0,,Anh Kaji nhiệt tình và thú vị nhỉ
Dialogue: 0,0:08:00.84,0:08:03.26,Default,,0,0,0,,Thì từ xưa đã vậy rồi... Tên ngốc đó
Dialogue: 0,0:08:03.39,0:08:04.43,Default,,0,0,0,,Đứa trẻ thứ ba! \NHửm?
Dialogue: 0,0:08:06.10,0:08:07.14,Default,,0,0,0,,Đi với tôi một lát
Dialogue: 0,0:08:15.57,0:08:17.53,Default,,0,0,0,,Unit-02 màu đỏ sao
Dialogue: 0,0:08:17.65,0:08:18.95,Default,,0,0,0,,Tớ không biết
Dialogue: 0,0:08:19.07,0:08:21.28,Default,,0,0,0,,Cái khác biệt không chỉ ở màu sắc đâu nha
Dialogue: 0,0:08:22.28,0:08:24.28,Default,,0,0,0,,Suy cho cùng, Unit-00 và Unit-01
Dialogue: 0,0:08:24.41,0:08:27.33,Default,,0,0,0,,là mẫu dùng thử và vật thí nghiệm trong quá trình phát triển
Dialogue: 0,0:08:27.45,0:08:30.12,Default,,0,0,0,,Việc mau chóng đồng bộ với người chưa qua huấn luyện như cậu thế kia
Dialogue: 0,0:08:30.25,0:08:31.21,Default,,0,0,0,,là minh chứng rõ nhất đó
Dialogue: 0,0:08:32.46,0:08:34.13,Default,,0,0,0,,Nhưng Unit-02 thì khác
Dialogue: 0,0:08:34.84,0:08:36.84,Default,,0,0,0,,Đây mới là Evangelion chính hãng đầu tiên trên thế giới
Dialogue: 0,0:08:36.96,0:08:40.13,Default,,0,0,0,,được chế tạo để dùng trong chiến đấu thực tế
Dialogue: 0,0:08:40.26,0:08:41.97,Default,,0,0,0,,Là bản chính thức đó
Dialogue: 0,0:08:42.09,0:08:43.01,Default,,0,0,0,,
Dialogue: 0,0:08:43.43,0:08:45.51,Default,,0,0,0,,Á! Gì thế?
Dialogue: 0,0:08:45.64,0:08:47.43,Default,,0,0,0,,Sóng xung kích dưới nước!
Dialogue: 0,0:08:48.23,0:08:49.23,Default,,0,0,0,,Nổ ở gần đây
Dialogue: 0,0:08:50.06,0:08:51.77,Default,,0,0,0,,Đó là?
Dialogue: 0,0:08:56.44,0:08:57.86,Default,,0,0,0,,Chẳng lẽ.... là Angel?
Dialogue: 0,0:08:57.98,0:08:59.44,Default,,0,0,0,,Là Angel thật luôn sao?
Dialogue: 0,0:08:59.61,0:09:01.36,Default,,0,0,0,,
Dialogue: 0,0:09:01.78,0:09:02.91,Default,,0,0,0,,Làm sao bây giờ
Dialogue: 0,0:09:03.03,0:09:05.16,Default,,0,0,0,,Phải quay lại chỗ chị Misato thôi!
Dialogue: 0,0:09:07.29,0:09:08.37,Default,,0,0,0,,Thời~ Cơ!
Dialogue: 0,0:09:14.21,0:09:16.92,Default,,0,0,0,,Các hạm đội chú ý giữ khoảng cách, đồng thời di chuyển tránh né
Dialogue: 0,0:09:17.55,0:09:19.05,Default,,0,0,0,,Báo cáo tình hình, sao rồi?
Dialogue: 0,0:09:19.17,0:09:20.34,Default,,0,0,0,,Cymbeline không phản hồi!
Dialogue: 0,0:09:20.47,0:09:23.30,Default,,0,0,0,,Titus Andronicus: không xác định được mục tiêu!
Dialogue: 0,0:09:23.43,0:09:26.14,Default,,0,0,0,,Khỉ thật, chuyện gì đang xảy ra vậy
Dialogue: 0,0:09:26.26,0:09:27.68,Default,,0,0,0,,Chào nha~ NERV đây
Dialogue: 0,0:09:27.81,0:09:31.35,Default,,0,0,0,,Thông tin của kẻ địch vô hình và cách xử lý tới đâu rồi ta?
Dialogue: 0,0:09:31.48,0:09:32.52,Default,,0,0,0,,Đang chiến đấu!
Dialogue: 0,0:09:32.64,0:09:34.27,Default,,0,0,0,,Không phận sự miễn vào!
Dialogue: 0,0:09:34.65,0:09:38.23,Default,,0,0,0,,Theo tôi thì, nhìn kiểu gì cũng thấy là Angel đang tấn công đó~
Dialogue: 0,0:09:38.36,0:09:40.24,Default,,0,0,0,,Toàn bộ hạm đội, tấn công linh hoạt!
Dialogue: 0,0:09:40.36,0:09:41.19,Default,,0,0,0,,Vô ích sao...
Dialogue: 0,0:09:45.41,0:09:47.66,Default,,0,0,0,,
Dialogue: 0,0:09:52.08,0:09:55.29,Default,,0,0,0,,Chừng này thì không phá được AT-Field đâu
Dialogue: 0,0:09:55.83,0:09:58.50,Default,,0,0,0,,Nhưng mà sao Angel ở đây...
Dialogue: 0,0:09:58.63,0:09:59.59,Default,,0,0,0,,Chẳng lẽ... Unit-02?
Dialogue: 0,0:10:03.22,0:10:05.05,Default,,0,0,0,,Này, đi đâu thế?
Dialogue: 0,0:10:05.18,0:10:06.39,Default,,0,0,0,,Hừ 
Dialogue: 0,0:10:07.05,0:10:08.43,Default,,0,0,0,,Chờ ở đây chút đi
Dialogue: 0,0:10:09.89,0:10:11.14,Default,,0,0,0,,Gì đây chứ...
Dialogue: 0,0:10:11.27,0:10:13.35,Default,,0,0,0,,
Dialogue: 0,0:10:18.61,0:10:19.44,Default,,0,0,0,,Kya!
Dialogue: 0,0:10:19.57,0:10:20.73,Default,,0,0,0,,Không được nhìn trộm!\N Tớ xin lỗi!
Dialogue: 0,0:10:20.86,0:10:21.82,Default,,0,0,0,,Biến thái!
Dialogue: 0,0:10:22.03,0:10:24.70,Default,,0,0,0,,Sao bọn con trai cứ ngốc nghếch và dê xồm vậy chứ
Dialogue: 0,0:10:26.66,0:10:27.62,Default,,0,0,0,,Ah...
Dialogue: 0,0:10:32.75,0:10:34.41,Default,,0,0,0,,Asuka, đi thôi 
Dialogue: 0,0:10:41.63,0:10:42.88,Default,,0,0,0,,Sao vẫn chưa chìm?
Dialogue: 0,0:10:43.01,0:10:45.38,Default,,0,0,0,,Đúng là hổng có Eva thì hổng thắng được he 
Dialogue: 0,0:10:45.51,0:10:46.34,Default,,0,0,0,,Hử?
Dialogue: 0,0:10:47.05,0:10:48.05,Default,,0,0,0,,Ơ
Dialogue: 0,0:10:49.97,0:10:50.81,Default,,0,0,0,,A?
Dialogue: 0,0:10:51.22,0:10:53.39,Default,,0,0,0,,Rồi, đi thôi?\NHả 
Dialogue: 0,0:10:53.73,0:10:55.81,Default,,0,0,0,,Cưng cũng đi luôn!
Dialogue: 0,0:10:56.98,0:10:57.81,Default,,0,0,0,,Ơ....
Dialogue: 0,0:10:58.27,0:11:01.69,Default,,0,0,0,,Này, thay Plug Suit để làm gì đây chứ 
Dialogue: 0,0:11:01.82,0:11:02.73,Default,,0,0,0,,Cưng bị ngốc à?
Dialogue: 0,0:11:03.24,0:11:06.61,Default,,0,0,0,,Còn phải hỏi sao, thì lấy Unit-02 dập nó!
Dialogue: 0,0:11:07.86,0:11:10.28,Default,,0,0,0,,Sao mà được! Chị Misato cho phép chưa?
Dialogue: 0,0:11:10.91,0:11:12.70,Default,,0,0,0,,Thắng xong rồi xin phép cũng có sao đâu
Dialogue: 0,0:11:15.62,0:11:20.09,Default,,0,0,0,,Rồi, giờ cho cậu xem tận mắt tài điều khiển cực đỉnh của tôi!
Dialogue: 0,0:11:20.50,0:11:22.13,Default,,0,0,0,,Nhưng mà đừng có cản trở đó
Dialogue: 0,0:11:27.97,0:11:30.51,Default,,0,0,0,,Lạ thật… cứ như là nó đang tìm kiếm thứ gì đó vậy.
Dialogue: 0,0:11:31.85,0:11:35.81,Default,,0,0,0,,Angel mà lại tấn công vào nơi như này? Hình như có hơi bất thường 
Dialogue: 0,0:11:35.93,0:11:37.81,Default,,0,0,0,,Nên mới có Unit-02 
Dialogue: 0,0:11:37.94,0:11:40.02,Default,,0,0,0,,Cũng có thêm phi công dự bị
Dialogue: 0,0:11:40.15,0:11:41.27,Default,,0,0,0,,
Dialogue: 0,0:11:41.27,0:11:42.65,Default,,0,0,0,,
Dialogue: 0,0:11:41.27,0:11:42.65,Default,,0,0,0,,Trong trường hợp xấu nhất, hãy trốn thoát dù chỉ có mình anh
Dialogue: 0,0:11:42.65,0:11:45.28,Default,,0,0,0,,Trong trường hợp xấu nhất, hãy trốn thoát dù chỉ có mình anh
Dialogue: 0,0:11:45.82,0:11:46.78,Default,,0,0,0,,Tôi hiểu rồi 
Dialogue: 0,0:11:49.74,0:11:51.83,Default,,0,0,0,,L.C.L. Fullung.\NBơm L.C.L.
Dialogue: 0,0:11:51.95,0:11:54.08,Default,,0,0,0,,Anfang der Bewegung.\NBắt đầu chuyển động.
Dialogue: 0,0:11:54.20,0:11:56.83,Default,,0,0,0,,Anfang des Nervenanschlusses.\NBắt đầu kết nối thần kinh.
Dialogue: 0,0:11:56.96,0:12:00.13,Default,,0,0,0,,AusulÖses von links-Kleigung.\NKhởi động, nghiêng sang trái.
Dialogue: 0,0:12:00.25,0:12:01.38,Default,,0,0,0,,Sinklo-start.\NBắt đầu đồng bộ.
Dialogue: 0,0:12:03.63,0:12:04.34,Default,,0,0,0,,
Dialogue: 0,0:12:04.34,0:12:05.42,Default,,0,0,0,,
Dialogue: 0,0:12:04.34,0:12:05.42,Default,,0,0,0,,Ơ
Dialogue: 0,0:12:05.42,0:12:05.55,Default,,0,0,0,,
Dialogue: 0,0:12:05.55,0:12:07.22,Default,,0,0,0,,
Dialogue: 0,0:12:05.55,0:12:07.22,Default,,0,0,0,,Bị lỗi rồi, sao vậy??
Dialogue: 0,0:12:07.34,0:12:08.38,Default,,0,0,0,,Bị nhiễu suy nghĩ!
Dialogue: 0,0:12:08.51,0:12:10.34,Default,,0,0,0,,Tôi đã nói là đừng cản trở rồi mà
Dialogue: 0,0:12:10.47,0:12:11.34,Default,,0,0,0,,Mà tại sao?
Dialogue: 0,0:12:11.47,0:12:13.60,Default,,0,0,0,,Tại cậu đang nghĩ bằng tiếng Nhật đó
Dialogue: 0,0:12:13.72,0:12:15.81,Default,,0,0,0,,Hãy cố suy nghĩ bằng tiếng Đức đi! 
Dialogue: 0,0:12:15.93,0:12:17.56,Default,,0,0,0,,T-Tớ biết rồi
Dialogue: 0,0:12:17.68,0:12:19.48,Default,,0,0,0,,Ba- Baumkuchen…
Dialogue: 0,0:12:19.60,0:12:21.73,Default,,0,0,0,,Ngốc thật chứ! Thôi được rồi!
Dialogue: 0,0:12:21.86,0:12:25.19,Default,,0,0,0,,Chuyển ngôn ngữ sang tiếng Nhật cơ bản!
Dialogue: 0,0:12:27.99,0:12:30.36,Default,,0,0,0,,Evangelion Unit-02, khởi động!
Dialogue: 0,0:12:31.24,0:12:33.78,Default,,0,0,0,,Có tín hiệu từ Othello. Eva Unit-02 đang khởi động!
Dialogue: 0,0:12:34.08,0:12:35.08,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:12:35.20,0:12:36.20,Default,,0,0,0,,Nice~ Asuka!
Dialogue: 0,0:12:39.16,0:12:42.00,Default,,0,0,0,,Không được! Dừng khởi động, về lại chỗ cũ!
Dialogue: 0,0:12:42.67,0:12:44.54,Default,,0,0,0,,Không sao đâu Asuka, xuất kích đi!
Dialogue: 0,0:12:44.67,0:12:46.05,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:12:46.17,0:12:48.67,Default,,0,0,0,,Eva và Phi công đều dưới quyền quản lí của tôi!
Dialogue: 0,0:12:48.80,0:12:49.97,Default,,0,0,0,,Không được tùy tiện!
Dialogue: 0,0:12:50.09,0:12:51.80,Default,,0,0,0,,Ông nói gì vậy hả? Lúc này rồi mà còn 
Dialogue: 0,0:12:51.93,0:12:53.55,Default,,0,0,0,,quan tâm mấy cái quy trình làm chi!
Dialogue: 0,0:12:53.72,0:12:54.72,Default,,0,0,0,,Ê này!
Dialogue: 0,0:12:54.85,0:12:57.77,Default,,0,0,0,,Cơ mà, thật luôn sao? Eva-02 vẫn đang trong trang bị loại B mà
Dialogue: 0,0:12:57.89,0:12:58.73,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:59.31,0:13:01.48,Default,,0,0,0,,Lỡ rơi xuống biển thì tiêu đời đó
Dialogue: 0,0:13:01.60,0:13:02.65,Default,,0,0,0,,Chỉ cần không rơi là được thôi
Dialogue: 0,0:13:03.15,0:13:04.56,Default,,0,0,0,,Shinji cũng lái luôn hả
Dialogue: 0,0:13:04.69,0:13:05.52,Default,,0,0,0,,Dạ!
Dialogue: 0,0:13:05.65,0:13:07.07,Default,,0,0,0,,2 đứa nhóc...
Dialogue: 0,0:13:07.19,0:13:08.82,Default,,0,0,0,,Hay là thử luôn...
Dialogue: 0,0:13:08.94,0:13:10.11,Default,,0,0,0,,Asuka! Tiến lên!
Dialogue: 0,0:13:12.86,0:13:14.41,Default,,0,0,0,,Đến rồi!\NĐi thôi!
Dialogue: 0,0:13:14.53,0:13:18.29,Default,,0,0,0,,♪
Dialogue: 0,0:13:18.29,0:13:19.95,Default,,0,0,0,,♪
Dialogue: 0,0:13:18.29,0:13:19.95,Default,,0,0,0,,Á!!!
Dialogue: 0,0:13:19.95,0:13:21.54,Default,,0,0,0,,♪
Dialogue: 0,0:13:22.21,0:13:23.58,Default,,0,0,0,,Đâu vậy?\NBên kia!
Dialogue: 0,0:13:25.38,0:13:26.92,Default,,0,0,0,,Chỉ còn 58 giây
Dialogue: 0,0:13:27.05,0:13:27.88,Default,,0,0,0,,Tôi biết rồi
Dialogue: 0,0:13:28.00,0:13:31.80,Default,,0,0,0,,Misato! Chuẩn bị sẵn trên boong tàu ổ cắm điện khẩn cấp ngoài nha!
Dialogue: 0,0:13:32.26,0:13:33.18,Default,,0,0,0,,Chị hiểu rồi!
Dialogue: 0,0:13:33.30,0:13:34.30,Default,,0,0,0,,Định làm gì vậy?
Dialogue: 0,0:13:34.55,0:13:36.76,Default,,0,0,0,,Rồi, nhảy thôi\NNhảy?
Dialogue: 0,0:13:40.73,0:13:42.10,Default,,0,0,0,,Oaa!! Chạy đi!
Dialogue: 0,0:13:55.16,0:13:56.49,Default,,0,0,0,,Nguồn điện dự phòng đã sẵn sàng!
Dialogue: 0,0:13:56.62,0:13:58.41,Default,,0,0,0,,Đã kết nối trực tiếp với lò phản ứng
Dialogue: 0,0:13:58.54,0:13:59.79,Default,,0,0,0,,Sơ tán khỏi sân đáp máy bay
Dialogue: 0,0:13:59.91,0:14:01.50,Default,,0,0,0,,Eva sắp sửa tiếp đất!
Dialogue: 0,0:14:01.91,0:14:03.58,Default,,0,0,0,,Tất cả vào tư thế, coi chừng rung lắc!
Dialogue: 0,0:14:03.71,0:14:04.54,Default,,0,0,0,,Loạn hết rồi!
Dialogue: 0,0:14:04.67,0:14:07.34,Default,,0,0,0,,Eva Unit-02 tiếp đất đây!
Dialogue: 0,0:14:07.59,0:14:08.42,Default,,0,0,0,,Hự!
Dialogue: 0,0:14:17.30,0:14:18.76,Default,,0,0,0,,Phí quá đi...
Dialogue: 0,0:14:18.89,0:14:21.14,Default,,0,0,0,,Mục tiêu, đang tiến nhanh đến tàu chúng ta!
Dialogue: 0,0:14:21.56,0:14:23.48,Default,,0,0,0,,Đang tới kìa! Phía 9 giờ bên mạn tàu trái
Dialogue: 0,0:14:23.60,0:14:24.81,Default,,0,0,0,,Thay điện khẩn cấp ngoài
Dialogue: 0,0:14:28.82,0:14:30.44,Default,,0,0,0,,Đã thay xong!
Dialogue: 0,0:14:31.48,0:14:32.65,Default,,0,0,0,,Nhưng ta không có vũ khí
Dialogue: 0,0:14:32.78,0:14:34.20,Default,,0,0,0,,Chỉ cần Dao cấp tiến là đủ
Dialogue: 0,0:14:43.16,0:14:44.33,Default,,0,0,0,,Khá là bự đó
Dialogue: 0,0:14:44.46,0:14:45.62,Default,,0,0,0,,Đúng như tôi nghĩ 
Dialogue: 0,0:14:48.04,0:14:49.29,Default,,0,0,0,,Các người định làm gì đó!
Dialogue: 0,0:14:49.42,0:14:51.96,Default,,0,0,0,,Để đánh bại Angel thì đấu cận chiến là lựa chọn tốt nhất.
Dialogue: 0,0:15:05.19,0:15:06.64,Default,,0,0,0,,Asuka giỏi quá, chặn nó được rồi! 
Dialogue: 0,0:15:06.77,0:15:07.77,Default,,0,0,0,,Đùa sao?
Dialogue: 0,0:15:07.90,0:15:09.81,Default,,0,0,0,,Tan tành cái sân đáp máy bay hết rồi kìa!
Dialogue: 0,0:15:11.82,0:15:13.28,Default,,0,0,0,,Áa!!
Dialogue: 0,0:15:17.11,0:15:18.49,Default,,0,0,0,,Rớt xuống rồi!
Dialogue: 0,0:15:18.62,0:15:21.91,Default,,0,0,0,,Asuka! Trang bị loại B thì không đấu dưới nước được đâu!
Dialogue: 0,0:15:22.37,0:15:23.70,Default,,0,0,0,,Chuyện đó thì phải thử
Dialogue: 0,0:15:24.00,0:15:25.37,Default,,0,0,0,,Mới biết được chứ?
Dialogue: 0,0:15:30.63,0:15:35.05,Default,,0,0,0,,
Dialogue: 0,0:15:43.85,0:15:45.64,Default,,0,0,0,,Phí quá...
Dialogue: 0,0:15:45.77,0:15:46.85,Default,,0,0,0,,Chiều dài dây cáp còn nhiêu?
Dialogue: 0,0:15:48.35,0:15:49.85,Default,,0,0,0,,Còn 1200!
Dialogue: 0,0:15:49.98,0:15:52.40,Default,,0,0,0,,Làm sao đây\N Sẽ xoay sở được thôi
Dialogue: 0,0:15:52.52,0:15:54.57,Default,,0,0,0,,Phải làm gì đó thôi 
Dialogue: 0,0:15:55.28,0:15:57.70,Default,,0,0,0,,
Dialogue: 0,0:15:58.86,0:16:01.28,Default,,0,0,0,,Cáp sắp hết rồi! Chuẩn bị chống sốc!
Dialogue: 0,0:16:02.87,0:16:03.70,Default,,0,0,0,,
Dialogue: 0,0:16:07.33,0:16:08.16,Default,,0,0,0,,Chết rồi 
Dialogue: 0,0:16:08.54,0:16:10.17,Default,,0,0,0,,Eva đã mất dấu mục tiêu!
Dialogue: 0,0:16:10.29,0:16:13.04,Default,,0,0,0,,Nhân lúc này phải lấy đĩa...
Dialogue: 0,0:16:13.17,0:16:15.76,Default,,0,0,0,,Aaa! Yak-38 Kai!
Dialogue: 0,0:16:15.88,0:16:17.51,Default,,0,0,0,,Này! Katsuragi
Dialogue: 0,0:16:17.92,0:16:18.97,Default,,0,0,0,,Kaji 
Dialogue: 0,0:16:19.76,0:16:22.26,Default,,0,0,0,,Tôi có đồ cần chuyển nên tôi đi trước nhé.
Dialogue: 0,0:16:22.55,0:16:23.97,Default,,0,0,0,,Hah....
Dialogue: 0,0:16:24.51,0:16:25.93,Default,,0,0,0,,Đi thôi 
Dialogue: 0,0:16:26.27,0:16:28.89,Default,,0,0,0,,Bảo trọng nhé Đại Úy Katsuragi!
Dialogue: 0,0:16:30.23,0:16:31.23,Default,,0,0,0,,Hah~
Dialogue: 0,0:16:31.35,0:16:32.65,Default,,0,0,0,,Bay mất tiêu òi...
Dialogue: 0,0:16:32.77,0:16:35.07,Default,,0,0,0,,Mục tiêu lại đang tiếp cận Eva!
Dialogue: 0,0:16:35.19,0:16:35.69,Default,,0,0,0,,♪
Dialogue: 0,0:16:35.69,0:16:36.53,Default,,0,0,0,,♪
Dialogue: 0,0:16:35.69,0:16:36.53,Default,,0,0,0,,Đến nữa rồi!
Dialogue: 0,0:16:36.53,0:16:37.03,Default,,0,0,0,,♪
Dialogue: 0,0:16:37.03,0:16:39.82,Default,,0,0,0,,♪
Dialogue: 0,0:16:37.03,0:16:39.82,Default,,0,0,0,,Hừ, lần này tôi sẽ giết nó cho bằng được!
Dialogue: 0,0:16:39.82,0:16:42.20,Default,,0,0,0,,♪
Dialogue: 0,0:16:43.12,0:16:45.29,Default,,0,0,0,,Gì chứ! Sao lại không di chuyển!
Dialogue: 0,0:16:45.41,0:16:46.74,Default,,0,0,0,,Thì trang bị loại B mà
Dialogue: 0,0:16:46.87,0:16:48.37,Default,,0,0,0,,Phải làm sao đây
Dialogue: 0,0:16:48.50,0:16:49.41,Default,,0,0,0,,Biết làm sao được...
Dialogue: 0,0:16:49.54,0:16:52.00,Default,,0,0,0,,Vô tích sự thật! Cậu là Đứa trẻ thứ ba kia mà!
Dialogue: 0,0:16:52.13,0:16:52.96,Default,,0,0,0,,Ah, đến rồi!
Dialogue: 0,0:16:57.92,0:16:59.51,Default,,0,0,0,,MIỆNG?
Dialogue: 0,0:16:59.63,0:17:00.88,Default,,0,0,0,,thì Angel mà...
Dialogue: 0,0:17:02.26,0:17:03.30,Default,,0,0,0,,Á!!
Dialogue: 0,0:17:03.93,0:17:06.60,Default,,0,0,0,,Eva Unit-02 đã vào trong cơ thể mục tiêu!
Dialogue: 0,0:17:06.72,0:17:08.47,Default,,0,0,0,,Chả lẽ bị ăn rồi hả?
Dialogue: 0,0:17:10.89,0:17:12.98,Default,,0,0,0,,Cái này giống như là câu cá ghê
Dialogue: 0,0:17:13.10,0:17:15.44,Default,,0,0,0,,Câu? Đúng! Là câu cá!
Dialogue: 0,0:17:17.94,0:17:19.61,Default,,0,0,0,,Như này thì rơi vào nguy hiểm rồi 
Dialogue: 0,0:17:19.69,0:17:21.15,Default,,0,0,0,,Im đi
Dialogue: 0,0:17:21.95,0:17:24.24,Default,,0,0,0,,Cậu định lái tới khi nào nữa, đồ biến thái!
Dialogue: 0,0:17:24.32,0:17:26.24,Default,,0,0,0,,Nhưng bằng mọi giá phải thoát ra 
Dialogue: 0,0:17:26.33,0:17:27.54,Default,,0,0,0,,Asuka, nghe được không?
Dialogue: 0,0:17:27.79,0:17:30.21,Default,,0,0,0,,Tuyệt đối đừng rời ra!\NHả?
Dialogue: 0,0:17:30.66,0:17:31.54,Default,,0,0,0,,Thuyền trưởng 
Dialogue: 0,0:17:31.66,0:17:32.58,Default,,0,0,0,,Chuyện gì 
Dialogue: 0,0:17:33.25,0:17:34.79,Default,,0,0,0,,Mong ông hãy hợp tác 
Dialogue: 0,0:17:36.92,0:17:40.13,Default,,0,0,0,,Bắn tỉa cự ly gần bằng hai chiến hạm còn sót lại?
Dialogue: 0,0:17:40.26,0:17:40.34,Default,,0,0,0,,♪
Dialogue: 0,0:17:40.34,0:17:41.30,Default,,0,0,0,,♪
Dialogue: 0,0:17:40.34,0:17:41.30,Default,,0,0,0,,Đúng thế 
Dialogue: 0,0:17:41.30,0:17:41.42,Default,,0,0,0,,♪
Dialogue: 0,0:17:41.42,0:17:45.47,Default,,0,0,0,,♪
Dialogue: 0,0:17:41.42,0:17:45.47,Default,,0,0,0,,Cho tự đánh chìm hai chiến hạm không người lái trên đường trục của cáp cầu nối 
Dialogue: 0,0:17:45.47,0:17:45.60,Default,,0,0,0,,♪
Dialogue: 0,0:17:45.60,0:17:46.64,Default,,0,0,0,,♪
Dialogue: 0,0:17:45.60,0:17:46.64,Default,,0,0,0,,Nhằm giăng bẫy
Dialogue: 0,0:17:46.64,0:17:47.26,Default,,0,0,0,,♪
Dialogue: 0,0:17:47.39,0:17:50.31,Default,,0,0,0,,Khi đó, Eva Unit-02 làm cho mục tiêu mở miệng
Dialogue: 0,0:17:50.93,0:17:52.48,Default,,0,0,0,,Toàn bộ chiến hạm sẽ xông vào trong đó
Dialogue: 0,0:17:52.60,0:17:56.40,Default,,0,0,0,,Cho các tháp pháo tập trung ở mũi tàu bắn trực tiếp, 
Dialogue: 0,0:17:56.52,0:17:58.32,Default,,0,0,0,,Sau đó cho tự nổ banh xác mục tiêu
Dialogue: 0,0:17:58.57,0:17:59.65,Default,,0,0,0,,Thế thì liều lĩnh quá!
Dialogue: 0,0:18:00.15,0:18:03.20,Default,,0,0,0,,Có liều lĩnh nhưng tôi nghĩ là có thể
Dialogue: 0,0:18:04.20,0:18:05.03,Default,,0,0,0,,Tôi hiểu rồi 
Dialogue: 0,0:18:05.41,0:18:08.91,Default,,0,0,0,,Tất cả ra khỏi tàu, lặp lại, tất cả ra khỏi tàu!
Dialogue: 0,0:18:09.33,0:18:12.33,Default,,0,0,0,,Các tàu cứu hộ mau cứu những người bị trôi dạt!
Dialogue: 0,0:18:12.62,0:18:14.50,Default,,0,0,0,,Nhưng mà Eva thì sao?
Dialogue: 0,0:18:14.62,0:18:16.83,Default,,0,0,0,,Không cần phải lo nếu là 2 người đó 
Dialogue: 0,0:18:17.25,0:18:18.84,Default,,0,0,0,,Ê này, cậu đừng có mà tùy tiện điều khiển 
Dialogue: 0,0:18:18.96,0:18:20.76,Default,,0,0,0,,Unit-02 của người khác chứ!
Dialogue: 0,0:18:21.34,0:18:23.42,Default,,0,0,0,,Cả hai người ổn với nội dung của chiến lược rồi chứ
Dialogue: 0,0:18:23.76,0:18:25.13,Default,,0,0,0,,Em sẽ cố bằng mọi giá
Dialogue: 0,0:18:25.26,0:18:26.09,Default,,0,0,0,,Nhờ các em!
Dialogue: 0,0:18:29.81,0:18:31.68,Default,,0,0,0,,Tất cả chiến hạm đã xả van Kings
Dialogue: 0,0:18:31.81,0:18:33.89,Default,,0,0,0,,Bắt đầu chìm xuống điểm Z 
Dialogue: 0,0:18:34.02,0:18:34.98,Default,,0,0,0,,Rõ 
Dialogue: 0,0:18:35.10,0:18:36.15,Default,,0,0,0,,Cuộn dây cáp lại!
Dialogue: 0,0:18:40.44,0:18:41.65,Default,,0,0,0,,Á!!
Dialogue: 0,0:18:44.03,0:18:46.86,Default,,0,0,0,,Eva bắt đầu nổi lên! Còn 70 nữa là va chạm 
Dialogue: 0,0:18:48.78,0:18:50.66,Default,,0,0,0,,Này! Định nghịch tới bao giờ nữa đây
Dialogue: 0,0:18:50.79,0:18:51.95,Default,,0,0,0,,Tránh ra đi!
Dialogue: 0,0:18:52.08,0:18:55.21,Default,,0,0,0,,Nhưng nếu không nhanh cạy miệng nó ra thì chúng ta cũng tiêu đời đó!
Dialogue: 0,0:18:59.00,0:19:00.63,Default,,0,0,0,,Còn 60 nữa là va chạm! 
Dialogue: 0,0:19:00.75,0:19:02.51,Default,,0,0,0,,Miệng của Angel sao rồi?\NChưa mở!
Dialogue: 0,0:19:05.34,0:19:08.39,Default,,0,0,0,,Hai chiến hạm đang chìm xuống hướng về mục tiêu.
Dialogue: 0,0:19:08.51,0:19:10.35,Default,,0,0,0,,Eva đang nổi lên, còn 50 nữa là va chạm 
Dialogue: 0,0:19:10.72,0:19:11.60,Default,,0,0,0,,Không được rồi!
Dialogue: 0,0:19:11.72,0:19:13.60,Default,,0,0,0,,Không còn thời gian đâu
Dialogue: 0,0:19:14.89,0:19:16.06,Default,,0,0,0,,Hừ!
Dialogue: 0,0:19:19.23,0:19:21.61,Default,,0,0,0,,Mục tiêu đang đi qua đáy tàu Tempest!
Dialogue: 0,0:19:22.40,0:19:23.78,Default,,0,0,0,,Sẽ không kịp mất, nhanh lên!
Dialogue: 0,0:19:24.36,0:19:25.95,Default,,0,0,0,,Đừng có nghĩ mấy cái điều quái dị đó
Dialogue: 0,0:19:26.07,0:19:26.90,Default,,0,0,0,,Gì cơ!
Dialogue: 0,0:19:27.03,0:19:28.99,Default,,0,0,0,,Dù sao thì cũng hãy tập trung suy nghĩ đi!
Dialogue: 0,0:19:29.12,0:19:29.95,Default,,0,0,0,,Tôi biết rồi 
Dialogue: 0,0:19:35.71,0:19:37.33,Default,,0,0,0,,Còn 20 là va chạm!
Dialogue: 0,0:19:37.54,0:19:40.00,Default,,0,0,0,,
Dialogue: 0,0:19:40.17,0:19:42.13,Default,,0,0,0,,Còn 15 là va chạm!
Dialogue: 0,0:19:42.30,0:19:44.30,Default,,0,0,0,,Mở ra mở ra mở ra mở ra!
Dialogue: 0,0:19:44.59,0:19:46.47,Default,,0,0,0,,mở ra 
Dialogue: 0,0:19:58.10,0:19:59.02,Default,,0,0,0,,Bắn!!
Dialogue: 0,0:20:04.78,0:20:07.53,Default,,0,0,0,,
Dialogue: 0,0:20:12.66,0:20:15.20,Default,,0,0,0,,
Dialogue: 0,0:20:17.04,0:20:20.46,Default,,0,0,0,,Shin-Yokosuka (Kyū Odawara)
Dialogue: 0,0:20:21.75,0:20:23.46,Default,,0,0,0,,Lại một trận quyết liệt nhỉ 
Dialogue: 0,0:20:23.59,0:20:26.96,Default,,0,0,0,,Lẽ ra phải tính trước chuyện chiến đấu dưới nước 
Dialogue: 0,0:20:27.22,0:20:29.30,Default,,0,0,0,,Hiếm thấy ghê, đang tự kiểm điểm à? 
Dialogue: 0,0:20:29.47,0:20:32.93,Default,,0,0,0,,Chẳng phải tốt sao, đã vậy còn lấy được dữ liệu đáng giá nữa
Dialogue: 0,0:20:33.05,0:20:33.97,Default,,0,0,0,,Đúng nhỉ 
Dialogue: 0,0:20:34.56,0:20:35.81,Default,,0,0,0,,Hửm? Misato 
Dialogue: 0,0:20:35.93,0:20:36.93,Default,,0,0,0,,Gì?
Dialogue: 0,0:20:37.06,0:20:38.39,Default,,0,0,0,,Cái này đáng giá thật đó!
Dialogue: 0,0:20:45.65,0:20:46.90,Default,,0,0,0,,Đ- đồ đôi !!
Dialogue: 0,0:20:47.03,0:20:48.32,Default,,0,0,0,,Ngại quá đii~
Dialogue: 0,0:20:49.15,0:20:51.36,Default,,0,0,0,,Giá trị đồng bộ lần này sẽ phá luôn kỉ lục đấy
Dialogue: 0,0:20:51.49,0:20:54.24,Default,,0,0,0,,Được có 7 giây thôi thì chắc là sức mạnh bộc phát lúc nguy cấp chăng
Dialogue: 0,0:20:54.37,0:20:55.83,Default,,0,0,0,,
Dialogue: 0,0:20:55.95,0:20:57.50,Default,,0,0,0,,Này, anh Kaji đâu?
Dialogue: 0,0:20:57.62,0:20:58.83,Default,,0,0,0,,Hắn chuồn trước rồi 
Dialogue: 0,0:20:58.96,0:21:01.46,Default,,0,0,0,,Và cái gã ngốc đó đã tới trụ sở luôn rồi
Dialogue: 0,0:21:03.00,0:21:05.88,Default,,0,0,0,,Ôi trời, chuyến tàu lần này thật đầy sóng gió 
Dialogue: 0,0:21:06.71,0:21:08.51,Default,,0,0,0,,Quả nhiên lỗi tại cái này phải không?
Dialogue: 0,0:21:08.67,0:21:12.51,Default,,0,0,0,,
Dialogue: 0,0:21:13.43,0:21:15.89,Default,,0,0,0,,Nó đã được phục hồi đến mức này rồi
Dialogue: 0,0:21:16.01,0:21:18.98,Default,,0,0,0,,Dù đã được cố định bằng nhựa Bakelite đông cứng
Dialogue: 0,0:21:19.10,0:21:21.10,Default,,0,0,0,,Nhưng nó còn sống, tôi chắc chắn 
Dialogue: 0,0:21:22.19,0:21:24.06,Default,,0,0,0,,Đây chính là then chốt cho Dự án hoàn thiện con người nhỉ
Dialogue: 0,0:21:24.19,0:21:25.02,Default,,0,0,0,,Đúng vậy
Dialogue: 0,0:21:25.23,0:21:28.23,Default,,0,0,0,,Là con người đầu tiên, Adam đấy
Dialogue: 0,0:21:28.36,0:21:29.53,Default,,0,0,0,,
Dialogue: 0,0:21:29.53,0:21:30.86,Default,,0,0,0,,
Dialogue: 0,0:21:29.53,0:21:30.86,Default,,0,0,0,,Thiệc hả?
