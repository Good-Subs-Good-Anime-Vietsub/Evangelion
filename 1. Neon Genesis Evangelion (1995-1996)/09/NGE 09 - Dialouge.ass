Dialogue: 0,0:00:01.16,0:00:06.95,Default,,0,0,0,,♪ 残酷な天使のように
Dialogue: 0,0:00:07.08,0:00:14.09,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:00:15.05,0:00:22.05,Default,,0,0,0,,♪
Dialogue: 0,0:00:22.97,0:00:25.85,Default,,0,0,0,,♪ 蒼(あお)い風がいま
Dialogue: 0,0:00:25.97,0:00:29.56,Default,,0,0,0,,♪ 胸のドアを叩(たた)いても
Dialogue: 0,0:00:29.69,0:00:33.27,Default,,0,0,0,,♪ 私だけを\N　　　ただ見つめて
Dialogue: 0,0:00:33.40,0:00:37.57,Default,,0,0,0,,♪ 微(ほほ)笑(え)んでるあなた
Dialogue: 0,0:00:37.69,0:00:40.65,Default,,0,0,0,,♪ そっとふれるもの
Dialogue: 0,0:00:40.78,0:00:44.49,Default,,0,0,0,,♪ もとめることに\N　　　　　　　夢中で
Dialogue: 0,0:00:44.62,0:00:48.16,Default,,0,0,0,,♪ 運命さえ\N　　　まだ知らない
Dialogue: 0,0:00:48.29,0:00:52.04,Default,,0,0,0,,♪ いたいけな瞳
Dialogue: 0,0:00:52.17,0:00:55.79,Default,,0,0,0,,♪ だけどいつか\N　　　気付くでしょう
Dialogue: 0,0:00:55.92,0:00:58.76,Default,,0,0,0,,♪ その背中には
Dialogue: 0,0:00:59.72,0:01:01.51,Default,,0,0,0,,♪ 遥(はる)か未来
Dialogue: 0,0:01:01.63,0:01:06.72,Default,,0,0,0,,♪ めざすための\N　　　羽根があること
Dialogue: 0,0:01:07.10,0:01:10.85,Default,,0,0,0,,♪ 残酷な天使のテーゼ
Dialogue: 0,0:01:10.98,0:01:14.10,Default,,0,0,0,,♪ 窓辺から\N　　　やがて飛び立つ
Dialogue: 0,0:01:14.61,0:01:18.32,Default,,0,0,0,,♪ ほとばしる\N　　　熱いパトスで
Dialogue: 0,0:01:18.44,0:01:21.61,Default,,0,0,0,,♪ 思い出を裏切るなら
Dialogue: 0,0:01:22.07,0:01:25.66,Default,,0,0,0,,♪ この宇宙(そら)を\N　　　　抱いて輝く
Dialogue: 0,0:01:25.78,0:01:29.58,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:01:31.66,0:01:32.71,Default,,0,0,0,,Ê, thấy chưa
Dialogue: 0,0:01:32.83,0:01:33.33,Default,,0,0,0,,
Dialogue: 0,0:01:33.33,0:01:33.67,Default,,0,0,0,,
Dialogue: 0,0:01:33.33,0:01:33.67,Default,,0,0,0,,Thấy rồi, thấy rồi!\NThấy gì?
Dialogue: 0,0:01:33.67,0:01:34.92,Default,,0,0,0,,Thấy rồi, thấy rồi!\NThấy gì?
Dialogue: 0,0:01:35.04,0:01:35.46,Default,,0,0,0,,
Dialogue: 0,0:01:35.46,0:01:35.88,Default,,0,0,0,,
Dialogue: 0,0:01:35.46,0:01:35.88,Default,,0,0,0,,Hông biết hả? Con bé người nước ngoài kia đó
Dialogue: 0,0:01:35.88,0:01:37.13,Default,,0,0,0,,Hông biết hả? Con bé người nước ngoài kia đó
Dialogue: 0,0:01:37.46,0:01:38.30,Default,,0,0,0,,Người nước ngoài?
Dialogue: 0,0:01:38.42,0:01:38.80,Default,,0,0,0,,Người nước ngoài?
Dialogue: 0,0:01:38.80,0:01:39.25,Default,,0,0,0,,
Dialogue: 0,0:01:38.80,0:01:39.25,Default,,0,0,0,,Ờ! Là cái con vừa chuyển tới lớp 2-A đó
Dialogue: 0,0:01:39.25,0:01:42.42,Default,,0,0,0,,Ờ! Là cái con vừa chuyển tới lớp 2-A đó
Dialogue: 0,0:01:42.55,0:01:42.84,Default,,0,0,0,,
Dialogue: 0,0:01:42.84,0:01:44.18,Default,,0,0,0,,
Dialogue: 0,0:01:42.84,0:01:44.18,Default,,0,0,0,,Hồi tuần trước!
Dialogue: 0,0:01:44.18,0:01:44.64,Default,,0,0,0,,
Dialogue: 0,0:01:44.64,0:01:45.05,Default,,0,0,0,,
Dialogue: 0,0:01:44.64,0:01:45.05,Default,,0,0,0,,Ngon vậy ta!
Dialogue: 0,0:01:45.05,0:01:46.51,Default,,0,0,0,,Ngon vậy ta!
Dialogue: 0,0:01:47.68,0:01:49.14,Default,,0,0,0,,Nghe nói con bé tên
Dialogue: 0,0:01:49.27,0:01:50.27,Default,,0,0,0,,Sōryū Asuka Langley
Dialogue: 0,0:01:50.98,0:01:52.64,Default,,0,0,0,,Dễ thương thật luôn á
Dialogue: 0,0:01:53.44,0:01:54.65,Default,,0,0,0,,Hình như là Nhật Kiều á
Dialogue: 0,0:01:55.27,0:01:56.90,Default,,0,0,0,,Hèn chi nhìn nó trưởng thành ghê
Dialogue: 0,0:01:57.23,0:01:58.48,Default,,0,0,0,,Ăn nói xàm xí!
Dialogue: 0,0:01:58.61,0:02:00.86,Default,,0,0,0,,Nhất định là mới vừa chia tay bên Đức
Dialogue: 0,0:02:00.99,0:02:03.78,Default,,0,0,0,,Rồi sống ở nơi đất khách với trái tim tổn thương chưa được chữa lành
Dialogue: 0,0:02:04.41,0:02:05.99,Default,,0,0,0,,Ồ!!
Dialogue: 0,0:02:08.24,0:02:09.66,Default,,0,0,0,,Haizzz
Dialogue: 0,0:02:10.24,0:02:12.16,Default,,0,0,0,,Người người nhà nhà, ai cũng cứ....
Dialogue: 0,0:02:12.75,0:02:15.21,Default,,0,0,0,,Asuka, Asuka quàii
Dialogue: 0,0:02:15.37,0:02:16.75,Default,,0,0,0,,Mọi người ai cũng chill ghê á
Dialogue: 0,0:02:16.88,0:02:18.63,Default,,0,0,0,,Cảm ơn nhiều!
Dialogue: 0,0:02:19.63,0:02:23.47,Default,,0,0,0,,Bức hình đâu có nói lên tính nết của nó đâu
Dialogue: 0,0:02:23.84,0:02:26.39,Default,,0,0,0,,Há lô! Shinji!
Dialogue: 0,0:02:26.93,0:02:28.05,Default,,0,0,0,,Guten Morgen!\N (Chào buổi sáng)
Dialogue: 0,0:02:26.93,0:02:28.05,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.05,0:02:28.64,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.64,0:02:30.22,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.64,0:02:30.22,Default,,0,0,0,,Gu-.. Gutenmorugen...
Dialogue: 0,0:02:30.22,0:02:30.51,Default,,0,0,0,,♪
Dialogue: 0,0:02:30.51,0:02:33.39,Default,,0,0,0,,♪
Dialogue: 0,0:02:30.51,0:02:33.39,Default,,0,0,0,,Lại nữa, từ sáng đã chưng cái mặt ủ rũ rồi
Dialogue: 0,0:02:33.39,0:02:33.52,Default,,0,0,0,,♪
Dialogue: 0,0:02:33.52,0:02:33.93,Default,,0,0,0,,♪
Dialogue: 0,0:02:33.52,0:02:33.93,Default,,0,0,0,,Tôi đây đang bắt chuyện với cậu đó
Dialogue: 0,0:02:33.93,0:02:35.64,Default,,0,0,0,,Tôi đây đang bắt chuyện với cậu đó
Dialogue: 0,0:02:35.77,0:02:38.73,Default,,0,0,0,,Ít ra thì cũng làm vẻ mặt vui lên đi chứ
Dialogue: 0,0:02:39.11,0:02:41.65,Default,,0,0,0,,Với lại, còn một người ở đây nữa phải không?
Dialogue: 0,0:02:41.78,0:02:42.61,Default,,0,0,0,,Ai cơ?
Dialogue: 0,0:02:43.36,0:02:44.57,Default,,0,0,0,,Cưng bị ngốc à?
Dialogue: 0,0:02:44.70,0:02:46.41,Default,,0,0,0,,Đương nhiên là Đứa trẻ thứ nhất rồi!
Dialogue: 0,0:02:47.07,0:02:49.53,Default,,0,0,0,,À nếu là Ayanami thì...
Dialogue: 0,0:02:53.54,0:02:55.33,Default,,0,0,0,,
Dialogue: 0,0:02:57.58,0:02:58.71,Default,,0,0,0,,
Dialogue: 0,0:02:58.83,0:03:00.25,Default,,0,0,0,,Há lô!
Dialogue: 0,0:03:00.84,0:03:04.13,Default,,0,0,0,,Cô là Ayanami Rei nhỉ? Phi công của Prototype
Dialogue: 0,0:03:06.68,0:03:08.89,Default,,0,0,0,,Tôi là Sōryū Asuka Langley
Dialogue: 0,0:03:09.60,0:03:12.22,Default,,0,0,0,,Phi công của Eva Unit-02. Hãy thân với nhau hơn
Dialogue: 0,0:03:12.93,0:03:13.77,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:03:14.39,0:03:17.19,Default,,0,0,0,,Tại thế thì tiện hơn cho nhiều chuyện mà.
Dialogue: 0,0:03:17.98,0:03:19.31,Default,,0,0,0,,Nếu có mệnh lệnh thì tôi sẽ làm thế
Dialogue: 0,0:03:20.27,0:03:21.19,Default,,0,0,0,,Con bé này lạ nhỉ
Dialogue: 0,0:03:21.69,0:03:23.94,Default,,0,0,0,,Thiệc tình, phi công Eva được tuyển chọn
Dialogue: 0,0:03:24.07,0:03:25.78,Default,,0,0,0,,toàn mấy đứa kì cục hong ha?
Dialogue: 0,0:03:31.41,0:03:34.83,Default,,0,0,0,,
Dialogue: 0,0:03:34.95,0:03:35.79,Default,,0,0,0,,Ơ
Dialogue: 0,0:03:35.91,0:03:37.71,Default,,0,0,0,,Em ốm đi chút rồi nhỉ?\N Vậy sao?
Dialogue: 0,0:03:38.42,0:03:40.21,Default,,0,0,0,,Tại em đang trong một mối tình sầu bi đấy
Dialogue: 0,0:03:40.33,0:03:43.75,Default,,0,0,0,,Sao anh biết những điều đó được?
Dialogue: 0,0:03:45.59,0:03:46.47,Default,,0,0,0,,Là vì
Dialogue: 0,0:03:46.59,0:03:48.93,Default,,0,0,0,,Những cô gái có nốt ruồi lệ thường bạc phận
Dialogue: 0,0:03:49.05,0:03:51.55,Default,,0,0,0,,phải rơi nước mắt cả đời đó em
Dialogue: 0,0:03:51.68,0:03:53.10,Default,,0,0,0,,Anh đang định cua em đấy à?
Dialogue: 0,0:03:53.22,0:03:54.06,Default,,0,0,0,,Nhưng không được đâu
Dialogue: 0,0:03:54.72,0:03:57.43,Default,,0,0,0,,Sợ quá cơ~ Có bà chị đang dòm kìa
Dialogue: 0,0:03:58.23,0:03:59.65,Default,,0,0,0,,Hừ...
Dialogue: 0,0:04:00.98,0:04:02.52,Default,,0,0,0,,Lâu không gặp, anh Kaji
Dialogue: 0,0:04:02.98,0:04:04.48,Default,,0,0,0,,Ừ, lâu rồi nhỉ
Dialogue: 0,0:04:04.61,0:04:06.53,Default,,0,0,0,,Nhưng không ngờ anh Kaji bất cẩn quá đấy
Dialogue: 0,0:04:06.53,0:04:07.40,Default,,0,0,0,,Nhưng không ngờ anh Kaji bất cẩn quá đấy
Dialogue: 0,0:04:06.53,0:04:07.40,Default,,0,0,0,,
Dialogue: 0,0:04:07.40,0:04:07.53,Default,,0,0,0,,
Dialogue: 0,0:04:07.53,0:04:07.99,Default,,0,0,0,,
Dialogue: 0,0:04:07.53,0:04:07.99,Default,,0,0,0,,Gã ngốc này vẫn chứng nào tật nấy!
Dialogue: 0,0:04:07.99,0:04:09.99,Default,,0,0,0,,Gã ngốc này vẫn chứng nào tật nấy!
Dialogue: 0,0:04:10.11,0:04:11.95,Default,,0,0,0,,Anh đã bàn giao xong Unit-02 rồi thì
Dialogue: 0,0:04:12.07,0:04:13.28,Default,,0,0,0,,mau chóng đi về đi!
Dialogue: 0,0:04:13.95,0:04:17.66,Default,,0,0,0,,Sáng nay tôi được phái đi công tác đấy, tôi sẽ tiếp tục ở đây
Dialogue: 0,0:04:17.79,0:04:20.50,Default,,0,0,0,,Ba chúng ta lại bên nhau như ngày xưa
Dialogue: 0,0:04:21.13,0:04:22.58,Default,,0,0,0,,Ai mà đi với anh chứ!
Dialogue: 0,0:04:22.58,0:04:22.92,Default,,0,0,0,,Ai mà đi với anh chứ!
Dialogue: 0,0:04:22.58,0:04:22.92,Default,,0,0,0,,
Dialogue: 0,0:04:22.92,0:04:23.04,Default,,0,0,0,,
Dialogue: 0,0:04:23.04,0:04:25.38,Default,,0,0,0,,
Dialogue: 0,0:04:23.04,0:04:25.38,Default,,0,0,0,,Hả? Địch tấn công?
Dialogue: 0,0:04:25.80,0:04:28.42,Default,,0,0,0,,Có điện báo từ tuần dương hạm ‘Haruna’ đang cảnh giới
Dialogue: 0,0:04:28.55,0:04:31.34,Default,,0,0,0,,"Chúng tôi phát hiện một vật thể lặn khổng lồ ở bán đảo Kii
Dialogue: 0,0:04:31.47,0:04:32.30,Default,,0,0,0,,"Gửi dữ liệu"
Dialogue: 0,0:04:32.93,0:04:34.18,Default,,0,0,0,,Chiếu lên dữ liệu vừa nhận được
Dialogue: 0,0:04:35.01,0:04:36.85,Default,,0,0,0,,Dạng bước sóng màu xanh. Xác định là Angel
Dialogue: 0,0:04:37.31,0:04:39.27,Default,,0,0,0,,Toàn bộ tập hợp, vào vị trí chiến đấu
Dialogue: 0,0:04:39.39,0:04:44.77,Default,,0,0,0,,♪
Dialogue: 0,0:04:44.77,0:04:46.32,Default,,0,0,0,,♪
Dialogue: 0,0:04:44.77,0:04:46.32,Default,,0,0,0,,Do cuộc chiến lần trước
Dialogue: 0,0:04:46.44,0:04:50.20,Default,,0,0,0,,Hệ thống đánh chặn của Thành phố Tokyo-3 đã chịu thiệt hại lớn
Dialogue: 0,0:04:50.32,0:04:52.82,Default,,0,0,0,,Đến bây giờ, tỉ lệ hồi phục là 26%
Dialogue: 0,0:04:53.37,0:04:56.24,Default,,0,0,0,,Trong thực chiến, tỉ lệ vận hành cứ cho bằng 0 cũng được
Dialogue: 0,0:04:56.83,0:04:57.91,Default,,0,0,0,,Thế nhưng lần này thì ta sẽ
Dialogue: 0,0:04:58.62,0:05:01.58,Default,,0,0,0,,đánh phủ đầu mục tiêu ở ven bờ ngay trước khi chúng đổ bộ
Dialogue: 0,0:05:02.33,0:05:06.17,Default,,0,0,0,,Unit-01 sẽ thay phiên với Unit-02 tấn công từng đợt vào mục tiêu
Dialogue: 0,0:05:06.30,0:05:07.55,Default,,0,0,0,,Ta sẽ đấu cận chiến
Dialogue: 0,0:05:07.67,0:05:08.51,Default,,0,0,0,,Đã rõ
Dialogue: 0,0:05:08.92,0:05:11.97,Default,,0,0,0,,Haizz... đây là lần đấu debut của tôi mà...
Dialogue: 0,0:05:12.09,0:05:15.18,Default,,0,0,0,,Sao lại không giao cho một mình tôi chứ?
Dialogue: 0,0:05:15.51,0:05:18.18,Default,,0,0,0,,Cũng phải chịu thôi, vì chiến lược mà
Dialogue: 0,0:05:18.31,0:05:19.89,Default,,0,0,0,,Nói trước nha!
Dialogue: 0,0:05:20.02,0:05:22.23,Default,,0,0,0,,Tôi rất mong cậu đừng gây cản trở nhá!
Dialogue: 0,0:05:22.35,0:05:23.19,Default,,0,0,0,,Ừ... ừm
Dialogue: 0,0:05:24.23,0:05:26.65,Default,,0,0,0,,Như thế mà sao lại được chọn làm phi công chứ
Dialogue: 0,0:05:40.04,0:05:42.58,Default,,0,0,0,,Hai chọi một thật hèn hạ, chán quá đi
Dialogue: 0,0:05:42.71,0:05:43.92,Default,,0,0,0,,Chẳng hay gì cả
Dialogue: 0,0:05:44.63,0:05:46.75,Default,,0,0,0,,Chúng ta không dư hơi để kén chọn đâu
Dialogue: 0,0:05:47.38,0:05:49.21,Default,,0,0,0,,Là cách để sống sót đó
Dialogue: 0,0:05:52.01,0:05:53.18,Default,,0,0,0,,A! Đến rồi!
Dialogue: 0,0:06:00.06,0:06:00.93,Default,,0,0,0,,Bắt đầu tấn công!
Dialogue: 0,0:06:01.68,0:06:03.81,Default,,0,0,0,,Tôi đi trước nhé, cậu hỗ trợ tôi!
Dialogue: 0,0:06:04.10,0:06:05.27,Default,,0,0,0,,Ơ... Hỗ trợ?
Dialogue: 0,0:06:05.40,0:06:06.81,Default,,0,0,0,,Ladies first mà!
Dialogue: 0,0:06:06.94,0:06:09.48,Default,,0,0,0,,Hứ! Mới tới mà bày đặt chỉ huy
Dialogue: 0,0:06:15.03,0:06:16.24,Default,,0,0,0,,Tiến lên! \NHả?
Dialogue: 0,0:06:23.87,0:06:25.37,Default,,0,0,0,,
Dialogue: 0,0:06:29.59,0:06:30.42,Default,,0,0,0,,Tuyệt quá!
Dialogue: 0,0:06:33.63,0:06:35.63,Default,,0,0,0,,Sao? Đứa trẻ thứ ba
Dialogue: 0,0:06:35.93,0:06:38.35,Default,,0,0,0,,Chiến đấu là phải luôn gọn lẹ, đẹp đẽ!
Dialogue: 0,0:06:40.51,0:06:41.77,Default,,0,0,0,,Ơ?
Dialogue: 0,0:06:45.69,0:06:50.82,Default,,0,0,0,,♪
Dialogue: 0,0:06:50.82,0:06:52.69,Default,,0,0,0,,♪
Dialogue: 0,0:06:50.82,0:06:52.69,Default,,0,0,0,,Ăn gian vậy má!
Dialogue: 0,0:06:52.69,0:06:52.86,Default,,0,0,0,,Ăn gian vậy má!
Dialogue: 0,0:06:53.78,0:06:58.03,Default,,0,0,0,,
Dialogue: 0,0:06:58.16,0:07:01.03,Default,,0,0,0,,Hôm nay, lúc 10:58:15 sáng
Dialogue: 0,0:07:01.16,0:07:02.37,Default,,0,0,0,,Unit- 01 bị tấn công
Dialogue: 0,0:07:02.49,0:07:04.29,Default,,0,0,0,,bởi mục tiêu A vốn bị tách làm đôi
Dialogue: 0,0:07:04.62,0:07:07.25,Default,,0,0,0,,Bị dìm xuống biển cách 2km ngoài khơi Vịnh Suraga
Dialogue: 0,0:07:07.79,0:07:09.38,Default,,0,0,0,,Đúng 20 giây sau
Dialogue: 0,0:07:09.50,0:07:11.96,Default,,0,0,0,,Unit-02 ngưng hoạt động do mục tiêu B tấn công
Dialogue: 0,0:07:12.25,0:07:15.30,Default,,0,0,0,,Ý kiến của người phụ trách dự án E đối với tình huống này là:
Dialogue: 0,0:07:15.42,0:07:16.38,Default,,0,0,0,,Thật thảm hại!
Dialogue: 0,0:07:16.51,0:07:19.26,Default,,0,0,0,,Ôi trời! Tại cậu mà trận debut tâm huyết này của tôi
Dialogue: 0,0:07:19.39,0:07:20.68,Default,,0,0,0,,tầy quầy rồi kìa!
Dialogue: 0,0:07:20.85,0:07:21.97,Default,,0,0,0,,Nói gì đó!
Dialogue: 0,0:07:22.14,0:07:24.64,Default,,0,0,0,,Là tại Sōryū làm ba cái trò ngốc ngếch đó chứ!
Dialogue: 0,0:07:24.77,0:07:25.98,Default,,0,0,0,,Ngốc nghếch?
Dialogue: 0,0:07:26.10,0:07:28.19,Default,,0,0,0,,Thằng đần như cậu mà dám nói thế sao hả?
Dialogue: 0,0:07:28.31,0:07:29.40,Default,,0,0,0,,Cái đồ mặt dày
Dialogue: 0,0:07:29.52,0:07:30.40,Default,,0,0,0,,Gì hả!
Dialogue: 0,0:07:30.52,0:07:31.65,Default,,0,0,0,,Chẳng phải tại cậu cứ muốn đánh nhanh, thắng nhanh,
Dialogue: 0,0:07:31.77,0:07:33.03,Default,,0,0,0,,nên mới nguy khốn vầy sao!
Dialogue: 0,0:07:33.19,0:07:34.19,Default,,0,0,0,,Cái gì kia
Dialogue: 0,0:07:34.32,0:07:34.82,Default,,0,0,0,,trông như con Doraemon trôi giữa biển, quê sệ!
Dialogue: 0,0:07:34.82,0:07:36.57,Default,,0,0,0,,trông như con Doraemon trôi giữa biển, quê sệ!\N Tính đến 11:03 sáng,
Dialogue: 0,0:07:36.57,0:07:36.65,Default,,0,0,0,,Tính đến 11:03 sáng,
Dialogue: 0,0:07:36.78,0:07:39.07,Default,,0,0,0,,NERV đã ngừng chiến dịch\NBản thân cậu mà lại đi nói người khác!
Dialogue: 0,0:07:39.07,0:07:39.49,Default,,0,0,0,,Bản thân cậu mà lại đi nói người khác!
Dialogue: 0,0:07:39.78,0:07:42.37,Default,,0,0,0,,Trao quyền chỉ huy cho Tập đoàn quân số 2 của Liên Hiệp Quốc.
Dialogue: 0,0:07:42.87,0:07:45.12,Default,,0,0,0,,Thật tình, quá là mất mặt!
Dialogue: 0,0:07:45.25,0:07:46.08,Default,,0,0,0,,Đúng 5 phút sau
Dialogue: 0,0:07:46.37,0:07:48.83,Default,,0,0,0,,Tập đoàn quân tấn công mục tiêu bằng mìn N2
Dialogue: 0,0:07:49.79,0:07:52.50,Default,,0,0,0,,Lại phải vẽ lại bản đồ rồi
Dialogue: 0,0:07:52.67,0:07:55.17,Default,,0,0,0,,thành công đốt cháy 28% vật chất cấu thành mục tiêu
Dialogue: 0,0:07:55.55,0:07:57.17,Default,,0,0,0,,Ta thắng chứ? \NChỉ cầm chân được thôi
Dialogue: 0,0:07:57.30,0:07:59.01,Default,,0,0,0,,Sẽ sớm tấn công lần nữa thôi
Dialogue: 0,0:07:59.68,0:08:02.05,Default,,0,0,0,,Chà, chỉ cần câu thêm thời gian để phục hồi
Dialogue: 0,0:08:02.18,0:08:03.51,Default,,0,0,0,,là cũng may rồi
Dialogue: 0,0:08:03.64,0:08:04.72,Default,,0,0,0,,Được rồi, hai người
Dialogue: 0,0:08:05.56,0:08:08.10,Default,,0,0,0,,Hai người có hiểu công việc mình là gì không?
Dialogue: 0,0:08:08.23,0:08:09.14,Default,,0,0,0,,Điều khiển Eva
Dialogue: 0,0:08:09.27,0:08:11.15,Default,,0,0,0,,Sai rồi, là đánh thắng Angel
Dialogue: 0,0:08:11.56,0:08:13.07,Default,,0,0,0,,NERV chúng tồn tại không phải để
Dialogue: 0,0:08:13.19,0:08:15.53,Default,,0,0,0,,chưng bộ dạng tệ hại như này!
Dialogue: 0,0:08:15.65,0:08:17.78,Default,,0,0,0,,Vì lẽ đó, hai người phải phối hợp cùng nhau
Dialogue: 0,0:08:17.90,0:08:19.70,Default,,0,0,0,,Sao lại là với nó!
Dialogue: 0,0:08:19.82,0:08:21.24,Default,,0,0,0,,Quá đủ rồi
Dialogue: 0,0:08:23.74,0:08:25.87,Default,,0,0,0,,Sao mọi người lại dễ nổi giận thế nhỉ?
Dialogue: 0,0:08:25.99,0:08:28.41,Default,,0,0,0,,大人は恥をかきたくないのさ Người lớn không muốn bị muối mặt đâu
Dialogue: 0,0:08:28.54,0:08:30.83,Default,,0,0,0,,À vậy, chị Misato sao rồi?
Dialogue: 0,0:08:31.12,0:08:32.13,Default,,0,0,0,,Đang sắp xếp lại
Dialogue: 0,0:08:32.25,0:08:35.34,Default,,0,0,0,,Người phụ trách là để chịu trách nhiệm mà.
Dialogue: 0,0:08:35.88,0:08:36.71,Default,,0,0,0,,♪
Dialogue: 0,0:08:36.71,0:08:39.72,Default,,0,0,0,,♪
Dialogue: 0,0:08:36.71,0:08:39.72,Default,,0,0,0,,Thư khiếu nại và báo cáo thiệt hại từ các bên liên quan
Dialogue: 0,0:08:39.72,0:08:39.84,Default,,0,0,0,,♪
Dialogue: 0,0:08:39.84,0:08:42.47,Default,,0,0,0,,♪
Dialogue: 0,0:08:39.84,0:08:42.47,Default,,0,0,0,,Còn đây là hóa đơn từ Liên Hợp Quốc
Dialogue: 0,0:08:42.47,0:08:42.59,Default,,0,0,0,,♪
Dialogue: 0,0:08:42.59,0:08:42.89,Default,,0,0,0,,♪
Dialogue: 0,0:08:42.59,0:08:42.89,Default,,0,0,0,,Bộ Đối ngoại cũng khiếu nại luôn này
Dialogue: 0,0:08:42.89,0:08:44.47,Default,,0,0,0,,Bộ Đối ngoại cũng khiếu nại luôn này
Dialogue: 0,0:08:44.60,0:08:45.51,Default,,0,0,0,,Hmm...
Dialogue: 0,0:08:45.64,0:08:47.14,Default,,0,0,0,,Nhìn qua trước cho kĩ nha
Dialogue: 0,0:08:47.27,0:08:49.60,Default,,0,0,0,,Dù không đọc cũng biết mà
Dialogue: 0,0:08:49.73,0:08:52.23,Default,,0,0,0,,Chắc lại ghi trong đó kiểu "Muốn đánh nhau thì sang đây đánh này"
Dialogue: 0,0:08:52.35,0:08:53.19,Default,,0,0,0,,Chuẩn không cần chỉnh
Dialogue: 0,0:08:53.65,0:08:57.07,Default,,0,0,0,,Chẳng cần họ phải nói, dọn dẹp xong lũ Angel tôi sang đó tẩn luôn
Dialogue: 0,0:08:57.61,0:08:59.99,Default,,0,0,0,,Tôi chắc chắn sẽ đánh bại lũ Angel đó
Dialogue: 0,0:09:00.15,0:09:02.32,Default,,0,0,0,,Phó chỉ huy đang điên tiết đấy
Dialogue: 0,0:09:02.45,0:09:05.45,Default,,0,0,0,,Lần sau mà còn muối mặt ổng nữa là cho giáng chức cô luôn, chắc chắn
Dialogue: 0,0:09:06.41,0:09:07.70,Default,,0,0,0,,Chỉ huy Ikari vắng mặt thì thật đúng là
Dialogue: 0,0:09:07.83,0:09:09.79,Default,,0,0,0,,trong cái rủi có cái may mà ha
Dialogue: 0,0:09:09.91,0:09:13.00,Default,,0,0,0,,Ổng ở đây là đuổi việc cô lập tức rồi, không có mà đọc mấy này đâu
Dialogue: 0,0:09:13.42,0:09:17.17,Default,,0,0,0,,Vậy rồi, chị đem ý tưởng giải cứu tôi tới chưa?
Dialogue: 0,0:09:17.63,0:09:18.71,Default,,0,0,0,,Chỉ có 1 thôi nhá
Dialogue: 0,0:09:19.30,0:09:20.97,Default,,0,0,0,,Đúng là Tiến sĩ Akagi!
Dialogue: 0,0:09:21.51,0:09:24.26,Default,,0,0,0,,Bạn cũ đúng là bạn chí cốt đó nha!
Dialogue: 0,0:09:24.39,0:09:26.93,Default,,0,0,0,,Đáng tiếc thay, người cứu cô khỏi hoạn nạn
Dialogue: 0,0:09:27.06,0:09:27.89,Default,,0,0,0,,Không phải tôi đâu
Dialogue: 0,0:09:28.31,0:09:30.06,Default,,0,0,0,,Ý tưởng này là của Kaji đấy
Dialogue: 0,0:09:30.64,0:09:32.10,Default,,0,0,0,,Của Kaji?
Dialogue: 0,0:09:36.15,0:09:39.03,Default,,0,0,0,,
Dialogue: 0,0:09:45.74,0:09:47.24,Default,,0,0,0,,Em về rồi!!
Dialogue: 0,0:09:47.37,0:09:51.75,Default,,0,0,0,,Nói vậy chứ có ai ở nhà đâu...
Dialogue: 0,0:09:52.16,0:09:53.00,Default,,0,0,0,,G-...
Dialogue: 0,0:09:53.46,0:09:54.54,Default,,0,0,0,,Gì đây trời!
Dialogue: 0,0:09:54.67,0:09:55.92,Default,,0,0,0,,Xin phép ha
Dialogue: 0,0:09:56.17,0:09:57.79,Default,,0,0,0,,Hành lí của tôi đó
Dialogue: 0,0:09:56.17,0:09:57.79,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.79,0:09:57.92,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.92,0:10:00.38,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.92,0:10:00.38,Default,,0,0,0,,Sao Sōryū lại ở đây!?
Dialogue: 0,0:10:00.38,0:10:01.88,Default,,0,0,0,,♪
Dialogue: 0,0:10:01.88,0:10:03.05,Default,,0,0,0,,♪
Dialogue: 0,0:10:01.88,0:10:03.05,Default,,0,0,0,,Cậu mà cũng còn ở đây cơ á?
Dialogue: 0,0:10:03.05,0:10:03.18,Default,,0,0,0,,♪
Dialogue: 0,0:10:03.38,0:10:05.26,Default,,0,0,0,,"Còn" là sao?
Dialogue: 0,0:10:05.97,0:10:07.60,Default,,0,0,0,,Từ hôm nay ông sẽ bị đuổi cổ
Dialogue: 0,0:10:08.10,0:10:09.35,Default,,0,0,0,,Hả?
Dialogue: 0,0:10:09.47,0:10:11.60,Default,,0,0,0,,Misato sẽ sống với tôi
Dialogue: 0,0:10:11.73,0:10:15.60,Default,,0,0,0,,Mà nếu nói ai ưu tú hơn thì đây là lựa chọn hiển nhiên rồi
Dialogue: 0,0:10:15.73,0:10:17.77,Default,,0,0,0,,Thật sự sẽ tốt hơn nếu sống cùng anh Kaji ha
Dialogue: 0,0:10:18.23,0:10:21.49,Default,,0,0,0,,Nhưng mà sao phòng ốc bên Nhật lại chật thế này
Dialogue: 0,0:10:22.28,0:10:24.20,Default,,0,0,0,,Còn chưa đem vào được một nửa số hành lí cơ
Dialogue: 0,0:10:24.32,0:10:25.16,Default,,0,0,0,,Ơ
Dialogue: 0,0:10:25.36,0:10:27.07,Default,,0,0,0,,Á!!
Dialogue: 0,0:10:27.53,0:10:30.12,Default,,0,0,0,,Đã thế, sao mà người Nhật
Dialogue: 0,0:10:30.24,0:10:31.95,Default,,0,0,0,,chẳng biết quan ngại là gì ta
Dialogue: 0,0:10:32.08,0:10:34.75,Default,,0,0,0,,Có thể sống trong căn phòng không chìa khóa vầy thật sao
Dialogue: 0,0:10:34.87,0:10:35.71,Default,,0,0,0,,Không thể tin được
Dialogue: 0,0:10:35.83,0:10:38.92,Default,,0,0,0,,Vì người Nhật sống biết quan tâm và thấu hiểu cho nhau đó
Dialogue: 0,0:10:39.54,0:10:40.38,Default,,0,0,0,,Misato\NChị Misato
Dialogue: 0,0:10:40.80,0:10:43.59,Default,,0,0,0,,Chị về rồi đây, ăn khớp với nhau nhanh đó
Dialogue: 0,0:10:44.01,0:10:45.01,Default,,0,0,0,,Gì? \NGì cơ chứ?
Dialogue: 0,0:10:45.30,0:10:46.72,Default,,0,0,0,,Chuẩn bị cho chiến dịch lần sau
Dialogue: 0,0:10:47.26,0:10:48.51,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:10:48.64,0:10:49.30,Default,,0,0,0,,♪
Dialogue: 0,0:10:49.30,0:10:51.60,Default,,0,0,0,,♪
Dialogue: 0,0:10:49.30,0:10:51.60,Default,,0,0,0,,Nhược điểm của Angel thứ 7 chỉ có 1!
Dialogue: 0,0:10:51.60,0:10:51.72,Default,,0,0,0,,♪
Dialogue: 0,0:10:51.72,0:10:55.19,Default,,0,0,0,,♪
Dialogue: 0,0:10:51.72,0:10:55.19,Default,,0,0,0,,Dồn lực tấn công vào 2 mảnh hạt nhân khi nó đang tách ra
Dialogue: 0,0:10:55.19,0:10:55.31,Default,,0,0,0,,♪
Dialogue: 0,0:10:55.31,0:10:55.64,Default,,0,0,0,,♪
Dialogue: 0,0:10:55.31,0:10:55.64,Default,,0,0,0,,Chỉ có vậy thôi
Dialogue: 0,0:10:55.64,0:10:56.14,Default,,0,0,0,,Chỉ có vậy thôi
Dialogue: 0,0:10:57.48,0:10:58.90,Default,,0,0,0,,Nói cách khác
Dialogue: 0,0:10:59.02,0:11:01.78,Default,,0,0,0,,Đây là đòn tấn công mà 2 Eva phải căn thời gian khớp đến hoàn hảo
Dialogue: 0,0:11:02.32,0:11:06.49,Default,,0,0,0,,Để được thế thì cả 2 phải phối hợp, cần phải đồng bộ hoàn toàn
Dialogue: 0,0:11:06.91,0:11:08.37,Default,,0,0,0,,Chính - vì - vậy
Dialogue: 0,0:11:08.49,0:11:10.78,Default,,0,0,0,,Từ giờ hai đứa phải sống cùng nhau đấy
Dialogue: 0,0:11:11.03,0:11:12.33,Default,,0,0,0,,Hả!?
Dialogue: 0,0:11:13.20,0:11:14.45,Default,,0,0,0,,Không chịu! Từ xưa đã có câu
Dialogue: 0,0:11:14.58,0:11:16.71,Default,,0,0,0,,"Nam nữ thụ thụ bất thân" mà!
Dialogue: 0,0:11:17.04,0:11:19.29,Default,,0,0,0,,Angel hiện đang tự hồi phục
Dialogue: 0,0:11:19.42,0:11:21.38,Default,,0,0,0,,Sẽ tấn công lần 2 sau 6 ngày nữa, không còn thời gian đâu
Dialogue: 0,0:11:21.71,0:11:24.26,Default,,0,0,0,,Không thể nào vậy được...
Dialogue: 0,0:11:24.80,0:11:27.13,Default,,0,0,0,,Vậy nên, có cách để biến điều không thể thành có thể
Dialogue: 0,0:11:27.76,0:11:30.55,Default,,0,0,0,,Ghi nhớ động tác tấn công khớp với bài nhạc này
Dialogue: 0,0:11:30.68,0:11:32.89,Default,,0,0,0,,Để cho 2 người đạt được mức đồng bộ hoàn hảo đó
Dialogue: 0,0:11:33.52,0:11:36.31,Default,,0,0,0,,Trong vòng 6 ngày, càng sớm càng tốt
Dialogue: 0,0:11:36.43,0:11:37.85,Default,,0,0,0,,
Dialogue: 0,0:11:38.27,0:11:39.15,Default,,0,0,0,,Hứ!
Dialogue: 0,0:11:47.15,0:11:49.82,Default,,0,0,0,,Mà thằng Shinji đó bị gì vậy trời
Dialogue: 0,0:11:49.95,0:11:52.33,Default,,0,0,0,,Nghỉ học được 3 ngày rồi đó
Dialogue: 0,0:11:56.12,0:11:57.33,Default,,0,0,0,,Ơ, lớp trưởng kìa
Dialogue: 0,0:11:57.46,0:11:59.00,Default,,0,0,0,,Hai người trong bộ ba ngốc nghếch?
Dialogue: 0,0:11:59.12,0:12:01.17,Default,,0,0,0,,Sao mà lớp trưởng cũng ở đây vậy?
Dialogue: 0,0:12:01.29,0:12:02.71,Default,,0,0,0,,Đến thăm Sōryū
Dialogue: 0,0:12:02.84,0:12:04.59,Default,,0,0,0,,Sao các cậu cũng ở đây?
Dialogue: 0,0:12:04.71,0:12:06.76,Default,,0,0,0,,Đến thăm Ikari
Dialogue: 0,0:12:06.92,0:12:08.72,Default,,0,0,0,,Sao ngừng ở đây thế?\N Toji: Sao dừng ở đây zậy?
Dialogue: 0,0:12:06.92,0:12:08.72,Default,,0,0,0,,
Dialogue: 0,0:12:09.72,0:12:11.30,Default,,0,0,0,,
Dialogue: 0,0:12:11.68,0:12:12.85,Default,,0,0,0,,Ra đây!
Dialogue: 0,0:12:12.97,0:12:13.81,Default,,0,0,0,,
Dialogue: 0,0:12:16.18,0:12:19.31,Default,,0,0,0,,Đồ phản bạn!
Dialogue: 0,0:12:19.44,0:12:21.40,Default,,0,0,0,,Giờ lại tông xẹt tông nữa hả!
Dialogue: 0,0:12:21.90,0:12:23.57,Default,,0,0,0,,Thấy ngượng quó đi ~
Dialogue: 0,0:12:24.15,0:12:25.32,Default,,0,0,0,,Này là vì...
Dialogue: 0,0:12:25.44,0:12:27.78,Default,,0,0,0,,Chị Misato ép! Nói là người Nhật quan trọng hình thức!
Dialogue: 0,0:12:27.90,0:12:29.49,Default,,0,0,0,,Chị Misato ép! Nói là người Nhật quan trọng hình thức!
Dialogue: 0,0:12:29.61,0:12:30.74,Default,,0,0,0,,
Dialogue: 0,0:12:30.86,0:12:32.66,Default,,0,0,0,,Cả 2 tởm lợn quá!
Dialogue: 0,0:12:32.95,0:12:34.49,Default,,0,0,0,,Hiểu lầm rồi!
Dialogue: 0,0:12:32.95,0:12:34.49,Default,,0,0,0,,Hiểu lầm rồi!
Dialogue: 0,0:12:34.78,0:12:36.16,Default,,0,0,0,,Không có hiểu lầm hiểu lộn gì hết á!
Dialogue: 0,0:12:36.29,0:12:37.83,Default,,0,0,0,,Ơ này~ Chào các em
Dialogue: 0,0:12:38.04,0:12:38.91,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:39.25,0:12:41.54,Default,,0,0,0,,Chị giải thích cho tụi như này là sao đi
