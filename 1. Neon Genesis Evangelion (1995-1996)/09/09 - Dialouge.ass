Dialogue: 0,0:00:01.16,0:00:06.95,Default,,0,0,0,,♪ 残酷な天使のように
Dialogue: 0,0:00:07.08,0:00:14.09,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:00:15.05,0:00:22.05,Default,,0,0,0,,♪
Dialogue: 0,0:00:22.97,0:00:25.85,Default,,0,0,0,,♪ 蒼(あお)い風がいま
Dialogue: 0,0:00:25.97,0:00:29.56,Default,,0,0,0,,♪ 胸のドアを叩(たた)いても
Dialogue: 0,0:00:29.69,0:00:33.27,Default,,0,0,0,,♪ 私だけを\N　　　ただ見つめて
Dialogue: 0,0:00:33.40,0:00:37.57,Default,,0,0,0,,♪ 微(ほほ)笑(え)んでるあなた
Dialogue: 0,0:00:37.69,0:00:40.65,Default,,0,0,0,,♪ そっとふれるもの
Dialogue: 0,0:00:40.78,0:00:44.49,Default,,0,0,0,,♪ もとめることに\N　　　　　　　夢中で
Dialogue: 0,0:00:44.62,0:00:48.16,Default,,0,0,0,,♪ 運命さえ\N　　　まだ知らない
Dialogue: 0,0:00:48.29,0:00:52.04,Default,,0,0,0,,♪ いたいけな瞳
Dialogue: 0,0:00:52.17,0:00:55.79,Default,,0,0,0,,♪ だけどいつか\N　　　気付くでしょう
Dialogue: 0,0:00:55.92,0:00:58.76,Default,,0,0,0,,♪ その背中には
Dialogue: 0,0:00:59.72,0:01:01.51,Default,,0,0,0,,♪ 遥(はる)か未来
Dialogue: 0,0:01:01.63,0:01:06.72,Default,,0,0,0,,♪ めざすための\N　　　羽根があること
Dialogue: 0,0:01:07.10,0:01:10.85,Default,,0,0,0,,♪ 残酷な天使のテーゼ
Dialogue: 0,0:01:10.98,0:01:14.10,Default,,0,0,0,,♪ 窓辺から\N　　　やがて飛び立つ
Dialogue: 0,0:01:14.61,0:01:18.32,Default,,0,0,0,,♪ ほとばしる\N　　　熱いパトスで
Dialogue: 0,0:01:18.44,0:01:21.61,Default,,0,0,0,,♪ 思い出を裏切るなら
Dialogue: 0,0:01:22.07,0:01:25.66,Default,,0,0,0,,♪ この宇宙(そら)を\N　　　　抱いて輝く
Dialogue: 0,0:01:25.78,0:01:29.58,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:01:31.66,0:01:32.71,Default,,0,0,0,,（男子生徒１）おい 見たかよ
Dialogue: 0,0:01:32.83,0:01:33.33,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:33.33,0:01:33.67,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:33.33,0:01:33.67,Default,,0,0,0,,（男子生徒２）見た見た！\N（男子生徒３）何が？
Dialogue: 0,0:01:33.67,0:01:34.92,Default,,0,0,0,,（男子生徒２）見た見た！\N（男子生徒３）何が？
Dialogue: 0,0:01:35.04,0:01:35.46,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:35.46,0:01:35.88,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:35.46,0:01:35.88,Default,,0,0,0,,（男子生徒２）\N知らねーのか？　あの外人
Dialogue: 0,0:01:35.88,0:01:37.13,Default,,0,0,0,,（男子生徒２）\N知らねーのか？　あの外人
Dialogue: 0,0:01:37.46,0:01:38.30,Default,,0,0,0,,（男子生徒３）外人？
Dialogue: 0,0:01:38.42,0:01:38.80,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:38.80,0:01:39.25,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:38.80,0:01:39.25,Default,,0,0,0,,（男子生徒２）\Nああ\N２年Ａ組に転校してきたんだよ
Dialogue: 0,0:01:39.25,0:01:42.42,Default,,0,0,0,,（男子生徒２）\Nああ\N２年Ａ組に転校してきたんだよ
Dialogue: 0,0:01:42.55,0:01:42.84,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:42.84,0:01:44.18,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:42.84,0:01:44.18,Default,,0,0,0,,先週！
Dialogue: 0,0:01:44.18,0:01:44.64,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:44.64,0:01:45.05,Default,,0,0,0,,（シャッター音）
Dialogue: 0,0:01:44.64,0:01:45.05,Default,,0,0,0,,（男子生徒４）グーだよなぁ
Dialogue: 0,0:01:45.05,0:01:46.51,Default,,0,0,0,,（男子生徒４）グーだよなぁ
Dialogue: 0,0:01:47.68,0:01:49.14,Default,,0,0,0,,（男子生徒５）\N惣流(そうりゅう)･アスカ･ラングレー
Dialogue: 0,0:01:49.27,0:01:50.27,Default,,0,0,0,,ていうんだってさ
Dialogue: 0,0:01:50.98,0:01:52.64,Default,,0,0,0,,（男子生徒１）\Nマジにかわいいじゃん
Dialogue: 0,0:01:53.44,0:01:54.65,Default,,0,0,0,,（男子生徒４）帰国子女だろ？
Dialogue: 0,0:01:55.27,0:01:56.90,Default,,0,0,0,,やっぱ進んでんのかなぁ
Dialogue: 0,0:01:57.23,0:01:58.48,Default,,0,0,0,,（男子生徒５）バカ言え！
Dialogue: 0,0:01:58.61,0:02:00.86,Default,,0,0,0,,きっとドイツで\Nつらーい別れがあったんだ
Dialogue: 0,0:02:00.99,0:02:03.78,Default,,0,0,0,,見知らぬ土地で 傷ついた心も\N癒やせずにいるんだよ
Dialogue: 0,0:02:04.41,0:02:05.99,Default,,0,0,0,,（男子生徒たち）おおー
Dialogue: 0,0:02:08.24,0:02:09.66,Default,,0,0,0,,（ケンスケ）あーあ
Dialogue: 0,0:02:10.24,0:02:12.16,Default,,0,0,0,,猫もシャクシも
Dialogue: 0,0:02:12.75,0:02:15.21,Default,,0,0,0,,アスカ アスカかぁ
Dialogue: 0,0:02:15.37,0:02:16.75,Default,,0,0,0,,（トウジ）皆 平和なもんや
Dialogue: 0,0:02:16.88,0:02:18.63,Default,,0,0,0,,（ケンスケ）毎度ありぃ
Dialogue: 0,0:02:19.63,0:02:23.47,Default,,0,0,0,,写真に あの性格は\Nあらへんからなぁ
Dialogue: 0,0:02:23.84,0:02:26.39,Default,,0,0,0,,（アスカ）ハロー シンジ！
Dialogue: 0,0:02:26.93,0:02:28.05,Default,,0,0,0,,グーテンモルゲン
Dialogue: 0,0:02:26.93,0:02:28.05,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.05,0:02:28.64,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.64,0:02:30.22,Default,,0,0,0,,♪
Dialogue: 0,0:02:28.64,0:02:30.22,Default,,0,0,0,,（シンジ）ぐ… ぐーてんもるげん
Dialogue: 0,0:02:30.22,0:02:30.51,Default,,0,0,0,,♪
Dialogue: 0,0:02:30.51,0:02:33.39,Default,,0,0,0,,♪
Dialogue: 0,0:02:30.51,0:02:33.39,Default,,0,0,0,,まーた 朝から辛気くさい顔して
Dialogue: 0,0:02:33.39,0:02:33.52,Default,,0,0,0,,♪
Dialogue: 0,0:02:33.52,0:02:33.93,Default,,0,0,0,,♪
Dialogue: 0,0:02:33.52,0:02:33.93,Default,,0,0,0,,この あたしが声かけてんのよ
Dialogue: 0,0:02:33.93,0:02:35.64,Default,,0,0,0,,この あたしが声かけてんのよ
Dialogue: 0,0:02:35.77,0:02:38.73,Default,,0,0,0,,ちったぁ\Nうれしそうな顔しなさいよ
Dialogue: 0,0:02:39.11,0:02:41.65,Default,,0,0,0,,で ここにいるんでしょ？\Nもう１人
Dialogue: 0,0:02:41.78,0:02:42.61,Default,,0,0,0,,（シンジ）誰が？
Dialogue: 0,0:02:43.36,0:02:44.57,Default,,0,0,0,,（アスカ）あんたバカ？
Dialogue: 0,0:02:44.70,0:02:46.41,Default,,0,0,0,,ファーストチルドレンに\N決まってるじゃない
Dialogue: 0,0:02:47.07,0:02:49.53,Default,,0,0,0,,（シンジ）ああ 綾波(あやなみ)なら…
Dialogue: 0,0:02:53.54,0:02:55.33,Default,,0,0,0,,（近づく足音）
Dialogue: 0,0:02:57.58,0:02:58.71,Default,,0,0,0,,（足音）
Dialogue: 0,0:02:58.83,0:03:00.25,Default,,0,0,0,,（アスカ）ハロー！
Dialogue: 0,0:03:00.84,0:03:04.13,Default,,0,0,0,,あなたが綾波レイね\Nプロトタイプのパイロット
Dialogue: 0,0:03:06.68,0:03:08.89,Default,,0,0,0,,あたし アスカ\N惣流･アスカ･ラングレー
Dialogue: 0,0:03:09.60,0:03:12.22,Default,,0,0,0,,エヴァ弐(に)号機のパイロット\N仲よくしましょ
Dialogue: 0,0:03:12.93,0:03:13.77,Default,,0,0,0,,（レイ）どうして？
Dialogue: 0,0:03:14.39,0:03:17.19,Default,,0,0,0,,そのほうが都合がいいからよ\Nいろいろとね
Dialogue: 0,0:03:17.98,0:03:19.31,Default,,0,0,0,,命令があれば そうするわ
Dialogue: 0,0:03:20.27,0:03:21.19,Default,,0,0,0,,変わった子ね
Dialogue: 0,0:03:21.69,0:03:23.94,Default,,0,0,0,,（トウジ）\Nほんま エヴァのパイロットって
Dialogue: 0,0:03:24.07,0:03:25.78,Default,,0,0,0,,変わり者(もん)が選ばれるんちゃうか？
Dialogue: 0,0:03:31.41,0:03:34.83,Default,,0,0,0,,（キーボードを叩く音）\N（足音）
Dialogue: 0,0:03:34.95,0:03:35.79,Default,,0,0,0,,（リツコ）あっ
Dialogue: 0,0:03:35.91,0:03:37.71,Default,,0,0,0,,（加持(かじ)）少し痩せたかな？\N（リツコ）そう？
Dialogue: 0,0:03:38.42,0:03:40.21,Default,,0,0,0,,（加持）悲しい恋をしてるからだ
Dialogue: 0,0:03:40.33,0:03:43.75,Default,,0,0,0,,どうして そんなことが分かるの？
Dialogue: 0,0:03:45.59,0:03:46.47,Default,,0,0,0,,それはね
Dialogue: 0,0:03:46.59,0:03:48.93,Default,,0,0,0,,涙の通り道にホクロのある人は
Dialogue: 0,0:03:49.05,0:03:51.55,Default,,0,0,0,,一生 泣き続ける運命に\Nあるからだよ
Dialogue: 0,0:03:51.68,0:03:53.10,Default,,0,0,0,,これから口説くつもり？
Dialogue: 0,0:03:53.22,0:03:54.06,Default,,0,0,0,,でも ダメよ
Dialogue: 0,0:03:54.72,0:03:57.43,Default,,0,0,0,,怖〜い お姉さんが見ているわ
Dialogue: 0,0:03:58.23,0:03:59.65,Default,,0,0,0,,（ミサト）はぁ〜
Dialogue: 0,0:04:00.98,0:04:02.52,Default,,0,0,0,,お久しぶり 加持君
Dialogue: 0,0:04:02.98,0:04:04.48,Default,,0,0,0,,やっ しばらく
Dialogue: 0,0:04:04.61,0:04:06.53,Default,,0,0,0,,しかし加持君も意外と うかつね
Dialogue: 0,0:04:06.53,0:04:07.40,Default,,0,0,0,,しかし加持君も意外と うかつね
Dialogue: 0,0:04:06.53,0:04:07.40,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:04:07.40,0:04:07.53,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:04:07.53,0:04:07.99,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:04:07.53,0:04:07.99,Default,,0,0,0,,（ミサト）\Nこいつのバカは 相変わらずなのよ
Dialogue: 0,0:04:07.99,0:04:09.99,Default,,0,0,0,,（ミサト）\Nこいつのバカは 相変わらずなのよ
Dialogue: 0,0:04:10.11,0:04:11.95,Default,,0,0,0,,あんた 弐号機の\N引き渡し済んだんなら
Dialogue: 0,0:04:12.07,0:04:13.28,Default,,0,0,0,,さっさと帰りなさいよ！
Dialogue: 0,0:04:13.95,0:04:17.66,Default,,0,0,0,,（加持）\N今朝 出向の辞令が届いてね\Nここに居続けだよ
Dialogue: 0,0:04:17.79,0:04:20.50,Default,,0,0,0,,また３人で つるめるな\N昔みたいに
Dialogue: 0,0:04:21.13,0:04:22.58,Default,,0,0,0,,誰が あんたなんかと！
Dialogue: 0,0:04:22.58,0:04:22.92,Default,,0,0,0,,誰が あんたなんかと！
Dialogue: 0,0:04:22.58,0:04:22.92,Default,,0,0,0,,（警告音）
Dialogue: 0,0:04:22.92,0:04:23.04,Default,,0,0,0,,（警告音）
Dialogue: 0,0:04:23.04,0:04:25.38,Default,,0,0,0,,（警告音）
Dialogue: 0,0:04:23.04,0:04:25.38,Default,,0,0,0,,ハッ！　敵襲!?
Dialogue: 0,0:04:25.80,0:04:28.42,Default,,0,0,0,,（青(あお)葉(ば)）\N警戒中の巡洋艦\N“はるな”より入電
Dialogue: 0,0:04:28.55,0:04:31.34,Default,,0,0,0,,“我 紀伊(きい)半島沖にて\N巨大な潜航物体を発見”
Dialogue: 0,0:04:31.47,0:04:32.30,Default,,0,0,0,,“データ送る”
Dialogue: 0,0:04:32.93,0:04:34.18,Default,,0,0,0,,（日向(ひゅうが)）受信データを照合
Dialogue: 0,0:04:35.01,0:04:36.85,Default,,0,0,0,,波長パターン青 使徒(しと)と確認
Dialogue: 0,0:04:37.31,0:04:39.27,Default,,0,0,0,,（冬月(ふゆつき)）総員 第１種戦闘配置
Dialogue: 0,0:04:39.39,0:04:44.77,Default,,0,0,0,,♪
Dialogue: 0,0:04:44.77,0:04:46.32,Default,,0,0,0,,♪
Dialogue: 0,0:04:44.77,0:04:46.32,Default,,0,0,0,,（ミサト）先の戦闘によって
Dialogue: 0,0:04:46.44,0:04:50.20,Default,,0,0,0,,第３新東京(しんとうきょう)市の迎撃システムは\N大きなダメージを受け
Dialogue: 0,0:04:50.32,0:04:52.82,Default,,0,0,0,,現在までの復旧率は26パーセント
Dialogue: 0,0:04:53.37,0:04:56.24,Default,,0,0,0,,実戦における稼働率は\Nゼロと言っていいわ
Dialogue: 0,0:04:56.83,0:04:57.91,Default,,0,0,0,,したがって今回は
Dialogue: 0,0:04:58.62,0:05:01.58,Default,,0,0,0,,上陸直前の目標を水際で一気に叩く
Dialogue: 0,0:05:02.33,0:05:06.17,Default,,0,0,0,,初号機ならびに弐号機は\N交互に目標に対し波状攻撃
Dialogue: 0,0:05:06.30,0:05:07.55,Default,,0,0,0,,近接戦闘でいくわよ
Dialogue: 0,0:05:07.67,0:05:08.51,Default,,0,0,0,,（アスカ･シンジ）\N了解
Dialogue: 0,0:05:08.92,0:05:11.97,Default,,0,0,0,,あーあ　日本での\Nデビュー戦だっていうのに
Dialogue: 0,0:05:12.09,0:05:15.18,Default,,0,0,0,,どぉして\N私 一人に任せてくれないの？
Dialogue: 0,0:05:15.51,0:05:18.18,Default,,0,0,0,,（シンジ）\Nしかたないよ 作戦なんだから
Dialogue: 0,0:05:18.31,0:05:19.89,Default,,0,0,0,,言っとくけど くれぐれも
Dialogue: 0,0:05:20.02,0:05:22.23,Default,,0,0,0,,足手まといになるようなことは\Nしないでね！
Dialogue: 0,0:05:22.35,0:05:23.19,Default,,0,0,0,,（シンジ）\Nう… うん
Dialogue: 0,0:05:24.23,0:05:26.65,Default,,0,0,0,,なーんで あんなのが\Nパイロットに選ばれたの？
Dialogue: 0,0:05:40.04,0:05:42.58,Default,,0,0,0,,２人がかりなんて\Nひきょうで やだな
Dialogue: 0,0:05:42.71,0:05:43.92,Default,,0,0,0,,趣味じゃない
Dialogue: 0,0:05:44.63,0:05:46.75,Default,,0,0,0,,（ミサト）\N私たちは 選ぶ余裕なんてないのよ
Dialogue: 0,0:05:47.38,0:05:49.21,Default,,0,0,0,,生き残るための手段をね
Dialogue: 0,0:05:52.01,0:05:53.18,Default,,0,0,0,,（シンジ）あっ 来た！
Dialogue: 0,0:06:00.06,0:06:00.93,Default,,0,0,0,,攻撃開始！
Dialogue: 0,0:06:01.68,0:06:03.81,Default,,0,0,0,,じゃ あたしから行くわ\N援護してね！
Dialogue: 0,0:06:04.10,0:06:05.27,Default,,0,0,0,,え… 援護？
Dialogue: 0,0:06:05.40,0:06:06.81,Default,,0,0,0,,（アスカ）\Nレディーファーストよ！
Dialogue: 0,0:06:06.94,0:06:09.48,Default,,0,0,0,,チェッ あとから来たくせに\N仕切んなよな
Dialogue: 0,0:06:15.03,0:06:16.24,Default,,0,0,0,,（アスカ）いける！\N（シンジ）ええっ？
Dialogue: 0,0:06:23.87,0:06:25.37,Default,,0,0,0,,うわぁぁー！
Dialogue: 0,0:06:29.59,0:06:30.42,Default,,0,0,0,,お見事
Dialogue: 0,0:06:33.63,0:06:35.63,Default,,0,0,0,,どう？　サードチルドレン
Dialogue: 0,0:06:35.93,0:06:38.35,Default,,0,0,0,,戦いは常にムダなく美しくよ！
Dialogue: 0,0:06:40.51,0:06:41.77,Default,,0,0,0,,（シンジ）あっ\N（アスカ）ハッ！
Dialogue: 0,0:06:45.69,0:06:50.82,Default,,0,0,0,,♪
Dialogue: 0,0:06:50.82,0:06:52.69,Default,,0,0,0,,♪
Dialogue: 0,0:06:50.82,0:06:52.69,Default,,0,0,0,,なんてインチキ！
Dialogue: 0,0:06:52.69,0:06:52.86,Default,,0,0,0,,なんてインチキ！
Dialogue: 0,0:06:53.78,0:06:58.03,Default,,0,0,0,,（プロジェクターの作動音）
Dialogue: 0,0:06:58.16,0:07:01.03,Default,,0,0,0,,（マヤ）\N本日 午前10時58分15秒
Dialogue: 0,0:07:01.16,0:07:02.37,Default,,0,0,0,,２体に分離した目標—
Dialogue: 0,0:07:02.49,0:07:04.29,Default,,0,0,0,,甲(こう)の攻撃を受けた\N初号機は
Dialogue: 0,0:07:04.62,0:07:07.25,Default,,0,0,0,,駿(する)河(が)湾沖合２キロの\N海上に水没
Dialogue: 0,0:07:07.79,0:07:09.38,Default,,0,0,0,,同20秒 弐号機は
Dialogue: 0,0:07:09.50,0:07:11.96,Default,,0,0,0,,目標 乙(おつ)の攻撃により\N活動停止
Dialogue: 0,0:07:12.25,0:07:15.30,Default,,0,0,0,,この状況に対する\NＥ計画責任者のコメント
Dialogue: 0,0:07:15.42,0:07:16.38,Default,,0,0,0,,（リツコ）\Nブザマね
Dialogue: 0,0:07:16.51,0:07:19.26,Default,,0,0,0,,（アスカ）\Nもぉ！　あんたのせいで\Nせっかくのデビュー戦が
Dialogue: 0,0:07:19.39,0:07:20.68,Default,,0,0,0,,メチャメチャに\Nなっちゃったじゃない！
Dialogue: 0,0:07:20.85,0:07:21.97,Default,,0,0,0,,（シンジ）\N何 言ってんだよ
Dialogue: 0,0:07:22.14,0:07:24.64,Default,,0,0,0,,惣流がマヌケなこと\Nしただけじゃないか！
Dialogue: 0,0:07:24.77,0:07:25.98,Default,,0,0,0,,（アスカ）マヌケェ!?
Dialogue: 0,0:07:26.10,0:07:28.19,Default,,0,0,0,,どうしてグズのあんたが\Nそんなこと言えるのよ！
Dialogue: 0,0:07:28.31,0:07:29.40,Default,,0,0,0,,図々しいわねぇ
Dialogue: 0,0:07:29.52,0:07:30.40,Default,,0,0,0,,（シンジ）何だよ！
Dialogue: 0,0:07:30.52,0:07:31.65,Default,,0,0,0,,焦って倒そうとするから
Dialogue: 0,0:07:31.77,0:07:33.03,Default,,0,0,0,,大変なことに\Nなるんだろ？
Dialogue: 0,0:07:33.19,0:07:34.19,Default,,0,0,0,,何よ あれ！
Dialogue: 0,0:07:34.32,0:07:34.82,Default,,0,0,0,,海ん中でドザエモン\Nみたいに　ダサ〜
Dialogue: 0,0:07:34.82,0:07:36.57,Default,,0,0,0,,海ん中でドザエモン\Nみたいに　ダサ〜\N（マヤ）\N午前11時３分をもって
Dialogue: 0,0:07:36.57,0:07:36.65,Default,,0,0,0,,（マヤ）\N午前11時３分をもって
Dialogue: 0,0:07:36.78,0:07:39.07,Default,,0,0,0,,ネルフは\N作戦遂行を断念\N（シンジ）\N自分だって 人のこと\N言えないくせに！
Dialogue: 0,0:07:39.07,0:07:39.49,Default,,0,0,0,,（シンジ）\N自分だって 人のこと\N言えないくせに！
Dialogue: 0,0:07:39.78,0:07:42.37,Default,,0,0,0,,国連第２方面軍に\N指揮権を譲渡
Dialogue: 0,0:07:42.87,0:07:45.12,Default,,0,0,0,,（冬月）\Nまったく 恥をかかせおって
Dialogue: 0,0:07:45.25,0:07:46.08,Default,,0,0,0,,（マヤ）\N同05分
Dialogue: 0,0:07:46.37,0:07:48.83,Default,,0,0,0,,Ｎ２(エヌツー) 爆雷により目標を攻撃
Dialogue: 0,0:07:49.79,0:07:52.50,Default,,0,0,0,,（冬月）\Nまた地図を書き直さなきゃならんな
Dialogue: 0,0:07:52.67,0:07:55.17,Default,,0,0,0,,（マヤ）\N構成物質の28パーセントを\N焼却に成功
Dialogue: 0,0:07:55.55,0:07:57.17,Default,,0,0,0,,（アスカ）やったの？\N（冬月）足止めにすぎん
Dialogue: 0,0:07:57.30,0:07:59.01,Default,,0,0,0,,（冬月）再度侵攻は時間の問題だ
Dialogue: 0,0:07:59.68,0:08:02.05,Default,,0,0,0,,（加持）\Nまっ\N建て直しの時間が稼げただけでも
Dialogue: 0,0:08:02.18,0:08:03.51,Default,,0,0,0,,もうけものっすよ
Dialogue: 0,0:08:03.64,0:08:04.72,Default,,0,0,0,,（冬月）いいか 君たち
Dialogue: 0,0:08:05.56,0:08:08.10,Default,,0,0,0,,君たちの仕事は何だか分かるか？
Dialogue: 0,0:08:08.23,0:08:09.14,Default,,0,0,0,,（アスカ）エヴァの操縦
Dialogue: 0,0:08:09.27,0:08:11.15,Default,,0,0,0,,（冬月）違う　使徒に勝つことだ
Dialogue: 0,0:08:11.56,0:08:13.07,Default,,0,0,0,,こんな醜態をさらすために
Dialogue: 0,0:08:13.19,0:08:15.53,Default,,0,0,0,,我々 ネルフは\N存在しているわけではない
Dialogue: 0,0:08:15.65,0:08:17.78,Default,,0,0,0,,そのためには\N君たちが協力し合って…
Dialogue: 0,0:08:17.90,0:08:19.70,Default,,0,0,0,,（２人）なんで こんなヤツと！
Dialogue: 0,0:08:19.82,0:08:21.24,Default,,0,0,0,,（冬月）もういい
Dialogue: 0,0:08:23.74,0:08:25.87,Default,,0,0,0,,どうして みんな すぐに怒るの？
Dialogue: 0,0:08:25.99,0:08:28.41,Default,,0,0,0,,大人は恥をかきたくないのさ
Dialogue: 0,0:08:28.54,0:08:30.83,Default,,0,0,0,,（シンジ）あの ミサトさんは？
Dialogue: 0,0:08:31.12,0:08:32.13,Default,,0,0,0,,後片づけ
Dialogue: 0,0:08:32.25,0:08:35.34,Default,,0,0,0,,責任者は\N責任 取るためにいるからな
Dialogue: 0,0:08:35.88,0:08:36.71,Default,,0,0,0,,♪
Dialogue: 0,0:08:36.71,0:08:39.72,Default,,0,0,0,,♪
Dialogue: 0,0:08:36.71,0:08:39.72,Default,,0,0,0,,（リツコ）\N関係各省からの\N抗議文と被害報告書
Dialogue: 0,0:08:39.72,0:08:39.84,Default,,0,0,0,,♪
Dialogue: 0,0:08:39.84,0:08:42.47,Default,,0,0,0,,♪
Dialogue: 0,0:08:39.84,0:08:42.47,Default,,0,0,0,,で これがＵＮ(ユーエヌ)からの請求書
Dialogue: 0,0:08:42.47,0:08:42.59,Default,,0,0,0,,♪
Dialogue: 0,0:08:42.59,0:08:42.89,Default,,0,0,0,,♪
Dialogue: 0,0:08:42.59,0:08:42.89,Default,,0,0,0,,広報部からの苦情もあるわよ
Dialogue: 0,0:08:42.89,0:08:44.47,Default,,0,0,0,,広報部からの苦情もあるわよ
Dialogue: 0,0:08:44.60,0:08:45.51,Default,,0,0,0,,（ミサト）はぁ〜
Dialogue: 0,0:08:45.64,0:08:47.14,Default,,0,0,0,,（リツコ）\Nちゃんと 目 通しておいてね
Dialogue: 0,0:08:47.27,0:08:49.60,Default,,0,0,0,,（ミサト）\N読まなくても分かってるわよ
Dialogue: 0,0:08:49.73,0:08:52.23,Default,,0,0,0,,ケンカをするなら\Nここでやれって言うんでしょ
Dialogue: 0,0:08:52.35,0:08:53.19,Default,,0,0,0,,（リツコ）ご明察
Dialogue: 0,0:08:53.65,0:08:57.07,Default,,0,0,0,,（ミサト）\N言われなくったって\N使徒が片づけば ここでやるわよ
Dialogue: 0,0:08:57.61,0:08:59.99,Default,,0,0,0,,使徒は必ず私が倒すわ
Dialogue: 0,0:09:00.15,0:09:02.32,Default,,0,0,0,,（リツコ）副司令官はカンカンよ
Dialogue: 0,0:09:02.45,0:09:05.45,Default,,0,0,0,,今度 恥かかせたら左遷ね\N間違いなく
Dialogue: 0,0:09:06.41,0:09:07.70,Default,,0,0,0,,（ミサト）碇(いかり)司令が留守だったのは
Dialogue: 0,0:09:07.83,0:09:09.79,Default,,0,0,0,,不幸中の幸いだったけどさ
Dialogue: 0,0:09:09.91,0:09:13.00,Default,,0,0,0,,（リツコ）\Nいたら即刻クビよ\Nこれを見ることもなくね
Dialogue: 0,0:09:13.42,0:09:17.17,Default,,0,0,0,,で 私の首がつながるアイデア\N持ってきてくれたんでしょ？
Dialogue: 0,0:09:17.63,0:09:18.71,Default,,0,0,0,,１つだけね
Dialogue: 0,0:09:19.30,0:09:20.97,Default,,0,0,0,,（ミサト）\Nさっすが 赤(あか)木(ぎ)リツコ博士
Dialogue: 0,0:09:21.51,0:09:24.26,Default,,0,0,0,,持つべきものは心優しき旧友ねぇ
Dialogue: 0,0:09:24.39,0:09:26.93,Default,,0,0,0,,残念ながら\N旧友のピンチを救うのは
Dialogue: 0,0:09:27.06,0:09:27.89,Default,,0,0,0,,私じゃないわ
Dialogue: 0,0:09:28.31,0:09:30.06,Default,,0,0,0,,このアイデアは加持君よ
Dialogue: 0,0:09:30.64,0:09:32.10,Default,,0,0,0,,加持の？
Dialogue: 0,0:09:36.15,0:09:39.03,Default,,0,0,0,,（セミの鳴き声）
Dialogue: 0,0:09:45.74,0:09:47.24,Default,,0,0,0,,（シンジ）ただいまー
Dialogue: 0,0:09:47.37,0:09:51.75,Default,,0,0,0,,って言ったって誰もいない… か
Dialogue: 0,0:09:52.16,0:09:53.00,Default,,0,0,0,,なっ…
Dialogue: 0,0:09:53.46,0:09:54.54,Default,,0,0,0,,何だ これ！
Dialogue: 0,0:09:54.67,0:09:55.92,Default,,0,0,0,,（アスカ）失礼ね
Dialogue: 0,0:09:56.17,0:09:57.79,Default,,0,0,0,,あたしの荷物よ
Dialogue: 0,0:09:56.17,0:09:57.79,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.79,0:09:57.92,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.92,0:10:00.38,Default,,0,0,0,,♪
Dialogue: 0,0:09:57.92,0:10:00.38,Default,,0,0,0,,な… なんで\N惣流がここにいるんだよ
Dialogue: 0,0:10:00.38,0:10:01.88,Default,,0,0,0,,♪
Dialogue: 0,0:10:01.88,0:10:03.05,Default,,0,0,0,,♪
Dialogue: 0,0:10:01.88,0:10:03.05,Default,,0,0,0,,あんたこそ まだいたの？
Dialogue: 0,0:10:03.05,0:10:03.18,Default,,0,0,0,,♪
Dialogue: 0,0:10:03.38,0:10:05.26,Default,,0,0,0,,まだって… え？
Dialogue: 0,0:10:05.97,0:10:07.60,Default,,0,0,0,,あんた 今日からお払い箱よ
Dialogue: 0,0:10:08.10,0:10:09.35,Default,,0,0,0,,え？　あっ
Dialogue: 0,0:10:09.47,0:10:11.60,Default,,0,0,0,,ミサトは あたしと暮らすの
Dialogue: 0,0:10:11.73,0:10:15.60,Default,,0,0,0,,まぁ どっちが優秀かを考えれば\N当然の選択よね
Dialogue: 0,0:10:15.73,0:10:17.77,Default,,0,0,0,,ホントは加持さんと一緒のほうが\Nいいんだけど
Dialogue: 0,0:10:18.23,0:10:21.49,Default,,0,0,0,,しっかし どうして日本の部屋って\Nこう狭いのかしら
Dialogue: 0,0:10:22.28,0:10:24.20,Default,,0,0,0,,荷物が半分も入らないじゃない
Dialogue: 0,0:10:24.32,0:10:25.16,Default,,0,0,0,,（シンジ）あっ
Dialogue: 0,0:10:25.36,0:10:27.07,Default,,0,0,0,,ああー！
Dialogue: 0,0:10:27.53,0:10:30.12,Default,,0,0,0,,おまけに\Nどうして こう 日本人って
Dialogue: 0,0:10:30.24,0:10:31.95,Default,,0,0,0,,危機感 足りないのかしら？
Dialogue: 0,0:10:32.08,0:10:34.75,Default,,0,0,0,,よく こんな鍵のない部屋で\N暮らせるわね
Dialogue: 0,0:10:34.87,0:10:35.71,Default,,0,0,0,,信じらんない
Dialogue: 0,0:10:35.83,0:10:38.92,Default,,0,0,0,,日本人の心情は\N察しと思いやりだからよ
Dialogue: 0,0:10:39.54,0:10:40.38,Default,,0,0,0,,（アスカ）ミサト\N（シンジ）ミサトさん
Dialogue: 0,0:10:40.80,0:10:43.59,Default,,0,0,0,,おかえりなさーい\N早速 うまくやってるじゃない
Dialogue: 0,0:10:44.01,0:10:45.01,Default,,0,0,0,,（アスカ）何が？\N（シンジ）何がですか？
Dialogue: 0,0:10:45.30,0:10:46.72,Default,,0,0,0,,今度の作戦準備
Dialogue: 0,0:10:47.26,0:10:48.51,Default,,0,0,0,,（２人）どうして？
Dialogue: 0,0:10:48.64,0:10:49.30,Default,,0,0,0,,♪
Dialogue: 0,0:10:49.30,0:10:51.60,Default,,0,0,0,,♪
Dialogue: 0,0:10:49.30,0:10:51.60,Default,,0,0,0,,（ミサト）第７使徒の弱点は１つ！
Dialogue: 0,0:10:51.60,0:10:51.72,Default,,0,0,0,,♪
Dialogue: 0,0:10:51.72,0:10:55.19,Default,,0,0,0,,♪
Dialogue: 0,0:10:51.72,0:10:55.19,Default,,0,0,0,,分離中のコアに対する\N２点同時の荷重(かじゅう)攻撃
Dialogue: 0,0:10:55.19,0:10:55.31,Default,,0,0,0,,♪
Dialogue: 0,0:10:55.31,0:10:55.64,Default,,0,0,0,,♪
Dialogue: 0,0:10:55.31,0:10:55.64,Default,,0,0,0,,これしかないわ
Dialogue: 0,0:10:55.64,0:10:56.14,Default,,0,0,0,,これしかないわ
Dialogue: 0,0:10:57.48,0:10:58.90,Default,,0,0,0,,つまり—
Dialogue: 0,0:10:59.02,0:11:01.78,Default,,0,0,0,,エヴァ ２体のタイミングを\N完璧に合わせた攻撃よ
Dialogue: 0,0:11:02.32,0:11:06.49,Default,,0,0,0,,そのためには ２人の協調\N完璧なユニゾンが必要なの
Dialogue: 0,0:11:06.91,0:11:08.37,Default,,0,0,0,,そ こ で
Dialogue: 0,0:11:08.49,0:11:10.78,Default,,0,0,0,,あなたたちに これから\N一緒に暮らしてもらうわ
Dialogue: 0,0:11:11.03,0:11:12.33,Default,,0,0,0,,（２人）えぇ〜！
Dialogue: 0,0:11:13.20,0:11:14.45,Default,,0,0,0,,嫌よ！　昔から—
Dialogue: 0,0:11:14.58,0:11:16.71,Default,,0,0,0,,“男女７歳にして同衾(どうきん)せず”\Nってね！
Dialogue: 0,0:11:17.04,0:11:19.29,Default,,0,0,0,,使徒は現在 自己修復中
Dialogue: 0,0:11:19.42,0:11:21.38,Default,,0,0,0,,第２波は６日後 時間がないの
Dialogue: 0,0:11:21.71,0:11:24.26,Default,,0,0,0,,そんな ムチャなぁ
Dialogue: 0,0:11:24.80,0:11:27.13,Default,,0,0,0,,そこで ムチャを可能にする方法
Dialogue: 0,0:11:27.76,0:11:30.55,Default,,0,0,0,,２人の完璧なユニゾンを\Nマスターするため
Dialogue: 0,0:11:30.68,0:11:32.89,Default,,0,0,0,,この曲に合わせた攻撃パターンを\N覚え込むのよ
Dialogue: 0,0:11:33.52,0:11:36.31,Default,,0,0,0,,６日以内に １秒でも早く
Dialogue: 0,0:11:36.43,0:11:37.85,Default,,0,0,0,,（シンジ）あ…
Dialogue: 0,0:11:38.27,0:11:39.15,Default,,0,0,0,,（アスカ）ぷいっ！
Dialogue: 0,0:11:47.15,0:11:49.82,Default,,0,0,0,,（トウジ）\Nしかし シンジのヤツ\Nどないしたんやろ？
Dialogue: 0,0:11:49.95,0:11:52.33,Default,,0,0,0,,学校休んで もう３日か
Dialogue: 0,0:11:56.12,0:11:57.33,Default,,0,0,0,,（トウジ）あれ？　委員長やんか
Dialogue: 0,0:11:57.46,0:11:59.00,Default,,0,0,0,,（ヒカリ）３バカトリオの２人
Dialogue: 0,0:11:59.12,0:12:01.17,Default,,0,0,0,,（トウジ）\Nなんで委員長が ここにおるんや？
Dialogue: 0,0:12:01.29,0:12:02.71,Default,,0,0,0,,（ヒカリ）惣流さんのお見舞い
Dialogue: 0,0:12:02.84,0:12:04.59,Default,,0,0,0,,あなたたちこそ どうして ここに？
Dialogue: 0,0:12:04.71,0:12:06.76,Default,,0,0,0,,（ケンスケ）碇君のお見舞い
Dialogue: 0,0:12:06.92,0:12:08.72,Default,,0,0,0,,（トウジ）\Nなんで ここで止まるんや？
Dialogue: 0,0:12:06.92,0:12:08.72,Default,,0,0,0,,（ヒカリ）\Nなんで\Nここで止まるの？
Dialogue: 0,0:12:09.72,0:12:11.30,Default,,0,0,0,,（玄関チャイム）
Dialogue: 0,0:12:11.68,0:12:12.85,Default,,0,0,0,,（シンジ･アスカ）\Nはーい！
Dialogue: 0,0:12:12.97,0:12:13.81,Default,,0,0,0,,（解錠音）
Dialogue: 0,0:12:16.18,0:12:19.31,Default,,0,0,0,,（トウジ）\Nう… う… 裏切りもん！
Dialogue: 0,0:12:19.44,0:12:21.40,Default,,0,0,0,,（ケンスケ）\Nまたしても\N今どきペアルック
Dialogue: 0,0:12:21.90,0:12:23.57,Default,,0,0,0,,イヤ〜ンな感じ
Dialogue: 0,0:12:24.15,0:12:25.32,Default,,0,0,0,,（シンジ･アスカ）\Nこ… これは
Dialogue: 0,0:12:25.44,0:12:27.78,Default,,0,0,0,,日本人は\N形から入るものだって
Dialogue: 0,0:12:27.90,0:12:29.49,Default,,0,0,0,,無理やりミサトさんが…
Dialogue: 0,0:12:29.61,0:12:30.74,Default,,0,0,0,,（ヒカリ）う…
Dialogue: 0,0:12:30.86,0:12:32.66,Default,,0,0,0,,不潔よ！　２人とも！
Dialogue: 0,0:12:32.95,0:12:34.49,Default,,0,0,0,,（シンジ）ご… 誤解だよ！
Dialogue: 0,0:12:32.95,0:12:34.49,Default,,0,0,0,,（アスカ）\Nご… 誤解だわ！
Dialogue: 0,0:12:34.78,0:12:36.16,Default,,0,0,0,,（ヒカリ）\N５階も６階もないわ！
Dialogue: 0,0:12:36.29,0:12:37.83,Default,,0,0,0,,（ミサト）\Nあらぁ いらっしゃい
Dialogue: 0,0:12:38.04,0:12:38.91,Default,,0,0,0,,（ヒカリ）え？
Dialogue: 0,0:12:39.25,0:12:41.54,Default,,0,0,0,,（トウジ）\Nこれはどういうことか\N説明してください
Dialogue: 0,0:12:41.67,0:12:43.46,Default,,0,0,0,,（トウジたちの笑い声）
Dialogue: 0,0:12:41.67,0:12:43.46,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:43.46,0:12:43.67,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:43.67,0:12:44.71,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:43.67,0:12:44.71,Default,,0,0,0,,（トウジ）そんならそうと
Dialogue: 0,0:12:44.71,0:12:44.84,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:44.84,0:12:46.71,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:44.84,0:12:46.71,Default,,0,0,0,,はよ言うてくれたら よかったのに
Dialogue: 0,0:12:46.71,0:12:46.84,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:46.84,0:12:48.67,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:46.84,0:12:48.67,Default,,0,0,0,,（ヒカリ）\Nで ユニゾンは\Nうまくいってるんですか？
Dialogue: 0,0:12:48.67,0:12:49.38,Default,,0,0,0,,（ヒカリ）\Nで ユニゾンは\Nうまくいってるんですか？
Dialogue: 0,0:12:49.51,0:12:52.18,Default,,0,0,0,,（ミサト）\Nそれは見てのとおりなのよ
Dialogue: 0,0:12:53.30,0:12:53.39,Default,,0,0,0,,（ミサトたち）はぁ〜
Dialogue: 0,0:12:53.39,0:12:54.89,Default,,0,0,0,,（ミサトたち）はぁ〜
Dialogue: 0,0:12:53.39,0:12:54.89,Default,,0,0,0,,（ブザー）
Dialogue: 0,0:12:55.01,0:12:55.85,Default,,0,0,0,,（ヒカリ）ハッ！
Dialogue: 0,0:12:55.97,0:12:56.22,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:56.22,0:12:57.56,Default,,0,0,0,,♪（ぎこちない\Nテンポの音）
Dialogue: 0,0:12:56.22,0:12:57.56,Default,,0,0,0,,（アスカ）当(あ)ったり前じゃない！
Dialogue: 0,0:12:57.68,0:12:57.81,Default,,0,0,0,,このシンジに合わせて\Nレベル下げるなんて
Dialogue: 0,0:12:57.81,0:12:59.48,Default,,0,0,0,,このシンジに合わせて\Nレベル下げるなんて
Dialogue: 0,0:12:57.81,0:12:59.48,Default,,0,0,0,,（ブザー）
Dialogue: 0,0:12:59.48,0:12:59.89,Default,,0,0,0,,このシンジに合わせて\Nレベル下げるなんて
Dialogue: 0,0:13:00.02,0:13:01.27,Default,,0,0,0,,うまく いくわけないわ！
Dialogue: 0,0:13:01.44,0:13:02.94,Default,,0,0,0,,どだい無理な話なのよ
Dialogue: 0,0:13:03.90,0:13:05.11,Default,,0,0,0,,じゃあ やめとく？
Dialogue: 0,0:13:06.32,0:13:07.90,Default,,0,0,0,,他に人 いないんでしょ？
Dialogue: 0,0:13:09.53,0:13:10.78,Default,,0,0,0,,（ミサト）レイ\N（レイ）はい
Dialogue: 0,0:13:10.95,0:13:12.11,Default,,0,0,0,,（ミサト）やってみて
Dialogue: 0,0:13:12.24,0:13:13.20,Default,,0,0,0,,（レイ）はい
Dialogue: 0,0:13:13.99,0:13:15.24,Default,,0,0,0,,あ…
Dialogue: 0,0:13:17.83,0:13:19.75,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:19.75,0:13:21.08,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:19.75,0:13:21.08,Default,,0,0,0,,はぁ… ハッ
Dialogue: 0,0:13:21.08,0:13:22.96,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:22.96,0:13:24.42,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:22.96,0:13:24.42,Default,,0,0,0,,（トウジたち）おぉ〜！
Dialogue: 0,0:13:24.42,0:13:24.54,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:24.54,0:13:24.83,Default,,0,0,0,,♪（テンポが合った音）
Dialogue: 0,0:13:24.54,0:13:24.83,Default,,0,0,0,,（ミサト）\Nこれは作戦変更して\Nレイと組んだほうが いいかもね
Dialogue: 0,0:13:24.83,0:13:27.67,Default,,0,0,0,,（ミサト）\Nこれは作戦変更して\Nレイと組んだほうが いいかもね
Dialogue: 0,0:13:28.13,0:13:29.34,Default,,0,0,0,,え？
Dialogue: 0,0:13:31.42,0:13:32.34,Default,,0,0,0,,ええっ？
Dialogue: 0,0:13:33.30,0:13:35.47,Default,,0,0,0,,（アスカ）\Nもう嫌！　やってらんないわ！
Dialogue: 0,0:13:35.60,0:13:36.43,Default,,0,0,0,,（シンジ）あっ
Dialogue: 0,0:13:39.22,0:13:40.10,Default,,0,0,0,,（ヒカリ）アスカさん！
Dialogue: 0,0:13:40.23,0:13:42.14,Default,,0,0,0,,（トウジ）鬼の目ぇにも涙や
Dialogue: 0,0:13:42.27,0:13:45.27,Default,,0,0,0,,（ヒカリ）い〜か〜り〜くーん！
Dialogue: 0,0:13:46.61,0:13:47.44,Default,,0,0,0,,あ…
Dialogue: 0,0:13:47.57,0:13:49.11,Default,,0,0,0,,（ヒカリ）追いかけて！\N（シンジ）え？
Dialogue: 0,0:13:50.03,0:13:53.03,Default,,0,0,0,,女の子 泣かせたのよ\N責任 取りなさいよ！
Dialogue: 0,0:13:53.15,0:13:53.32,Default,,0,0,0,,♪
Dialogue: 0,0:13:53.32,0:13:55.45,Default,,0,0,0,,♪
Dialogue: 0,0:13:53.32,0:13:55.45,Default,,0,0,0,,（チャイム）
Dialogue: 0,0:13:55.45,0:13:56.78,Default,,0,0,0,,♪
Dialogue: 0,0:13:56.78,0:14:00.16,Default,,0,0,0,,♪
Dialogue: 0,0:13:56.78,0:14:00.16,Default,,0,0,0,,（足音）
Dialogue: 0,0:14:01.87,0:14:03.67,Default,,0,0,0,,（シンジ）あの…\N（アスカ）何も言わないで
Dialogue: 0,0:14:08.46,0:14:09.80,Default,,0,0,0,,（アスカ）分かってるわ
Dialogue: 0,0:14:09.92,0:14:11.84,Default,,0,0,0,,私はエヴァに乗るしかないのよ
Dialogue: 0,0:14:15.05,0:14:16.93,Default,,0,0,0,,やるわ 私
Dialogue: 0,0:14:18.10,0:14:19.47,Default,,0,0,0,,（アスカ）\Nこうなったら 何としても
Dialogue: 0,0:14:19.60,0:14:21.68,Default,,0,0,0,,レイやミサトを見返してやるのよ！
Dialogue: 0,0:14:22.02,0:14:24.06,Default,,0,0,0,,（シンジ）\Nそんな 見返すだなんて…
Dialogue: 0,0:14:24.19,0:14:25.98,Default,,0,0,0,,（アスカ）\Nなーに甘いこと言ってんのよ！
Dialogue: 0,0:14:26.27,0:14:27.40,Default,,0,0,0,,男のくせに！
Dialogue: 0,0:14:27.98,0:14:31.44,Default,,0,0,0,,傷つけられた プライドは
Dialogue: 0,0:14:31.57,0:14:34.53,Default,,0,0,0,,10倍にして返してやるのよ！
Dialogue: 0,0:14:34.65,0:14:36.66,Default,,0,0,0,,んぐ んぐ んぐ
Dialogue: 0,0:14:37.32,0:14:38.16,Default,,0,0,0,,ふっ
Dialogue: 0,0:14:41.83,0:14:48.84,Default,,0,0,0,,♪
Dialogue: 0,0:15:14.40,0:15:15.24,Default,,0,0,0,,ミサトは？
Dialogue: 0,0:15:15.36,0:15:15.57,Default,,0,0,0,,（イヤホンから\N漏れる音楽）
Dialogue: 0,0:15:15.57,0:15:16.74,Default,,0,0,0,,（イヤホンから\N漏れる音楽）
Dialogue: 0,0:15:15.57,0:15:16.74,Default,,0,0,0,,仕事
Dialogue: 0,0:15:16.74,0:15:16.86,Default,,0,0,0,,（イヤホンから\N漏れる音楽）
Dialogue: 0,0:15:16.86,0:15:18.95,Default,,0,0,0,,（イヤホンから\N漏れる音楽）
Dialogue: 0,0:15:16.86,0:15:18.95,Default,,0,0,0,,今夜は徹夜だって さっき電話が
Dialogue: 0,0:15:19.91,0:15:22.33,Default,,0,0,0,,じゃあ 今夜は\N２人っきりってわけね
Dialogue: 0,0:15:22.70,0:15:23.91,Default,,0,0,0,,（シンジ）えっ
Dialogue: 0,0:15:26.41,0:15:27.25,Default,,0,0,0,,あ…
Dialogue: 0,0:15:35.47,0:15:38.26,Default,,0,0,0,,これは 決して崩れることのない\Nジェリコの壁
Dialogue: 0,0:15:38.84,0:15:39.68,Default,,0,0,0,,はぁ
Dialogue: 0,0:15:40.22,0:15:42.31,Default,,0,0,0,,（アスカ）\Nこの壁を\Nちょっとでも越えたら死刑よ！
Dialogue: 0,0:15:42.97,0:15:45.77,Default,,0,0,0,,子どもは夜更かししないで\N寝なさい！
Dialogue: 0,0:15:47.23,0:15:50.11,Default,,0,0,0,,（アスカ）\Nどうして日本人は\N床の上で寝られるのかしら
Dialogue: 0,0:15:50.23,0:15:51.69,Default,,0,0,0,,信じらんない
Dialogue: 0,0:15:55.78,0:16:00.99,Default,,0,0,0,,（イヤホンから漏れる音楽）
Dialogue: 0,0:16:01.24,0:16:07.29,Default,,0,0,0,,（止める音）\N（遠ざかる足音）
Dialogue: 0,0:16:07.41,0:16:09.08,Default,,0,0,0,,（ドアの開閉音）
Dialogue: 0,0:16:09.58,0:16:10.42,Default,,0,0,0,,はぁ…
Dialogue: 0,0:16:10.54,0:16:12.04,Default,,0,0,0,,（物音）
Dialogue: 0,0:16:12.17,0:16:13.09,Default,,0,0,0,,ん…
Dialogue: 0,0:16:13.21,0:16:15.17,Default,,0,0,0,,（トイレの水洗音）
Dialogue: 0,0:16:15.30,0:16:16.71,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:16:19.18,0:16:21.30,Default,,0,0,0,,（近づく足音）
Dialogue: 0,0:16:21.43,0:16:23.01,Default,,0,0,0,,（ドサッという音）
Dialogue: 0,0:16:24.43,0:16:25.27,Default,,0,0,0,,うっ！
Dialogue: 0,0:16:25.47,0:16:30.02,Default,,0,0,0,,（テープを巻き戻す音）
Dialogue: 0,0:16:32.06,0:16:32.94,Default,,0,0,0,,あ…
Dialogue: 0,0:16:39.15,0:16:40.07,Default,,0,0,0,,（アスカ）んっ…
Dialogue: 0,0:16:58.80,0:16:59.76,Default,,0,0,0,,（アスカ）ママ…
Dialogue: 0,0:17:01.34,0:17:02.18,Default,,0,0,0,,ママ…
Dialogue: 0,0:17:10.31,0:17:11.77,Default,,0,0,0,,（アスカ）んんっ
Dialogue: 0,0:17:13.31,0:17:15.52,Default,,0,0,0,,自分だって子どものくせに…
Dialogue: 0,0:17:16.94,0:17:18.40,Default,,0,0,0,,（ミサト）やっだ 見てる！
Dialogue: 0,0:17:18.53,0:17:21.15,Default,,0,0,0,,（加持）誰が？\N（ミサト）誰って… んんっ
Dialogue: 0,0:17:21.32,0:17:22.61,Default,,0,0,0,,（ミサト）んっ
Dialogue: 0,0:17:24.24,0:17:26.49,Default,,0,0,0,,ん… んんっ
Dialogue: 0,0:17:24.24,0:17:26.49,Default,,0,0,0,,（書類が落ちる音）
Dialogue: 0,0:17:28.20,0:17:29.29,Default,,0,0,0,,ん…
Dialogue: 0,0:17:37.67,0:17:38.67,Default,,0,0,0,,（エレベーターの到着音）
Dialogue: 0,0:17:40.34,0:17:41.42,Default,,0,0,0,,（ミサト）んっ
Dialogue: 0,0:17:42.55,0:17:45.14,Default,,0,0,0,,もう 加持君とは\N何でもないんだから
Dialogue: 0,0:17:45.26,0:17:46.80,Default,,0,0,0,,こういうの やめてくれる？
Dialogue: 0,0:17:46.93,0:17:50.14,Default,,0,0,0,,（加持）\Nでも 君の唇は\Nやめてくれとは言わなかったよ
Dialogue: 0,0:17:51.64,0:17:54.02,Default,,0,0,0,,君の唇と君の言葉
Dialogue: 0,0:17:54.27,0:17:56.52,Default,,0,0,0,,どっちを信用したらいいのかな？
Dialogue: 0,0:18:08.37,0:18:09.74,Default,,0,0,0,,ふぅ…
Dialogue: 0,0:18:10.87,0:18:11.83,Default,,0,0,0,,（ミサト）うっ
Dialogue: 0,0:18:11.96,0:18:15.25,Default,,0,0,0,,♪
Dialogue: 0,0:18:15.25,0:18:17.54,Default,,0,0,0,,♪
Dialogue: 0,0:18:15.25,0:18:17.54,Default,,0,0,0,,（足音）
Dialogue: 0,0:18:17.54,0:18:17.67,Default,,0,0,0,,♪
Dialogue: 0,0:18:17.67,0:18:18.96,Default,,0,0,0,,♪
Dialogue: 0,0:18:17.67,0:18:18.96,Default,,0,0,0,,（リツコ）はい
Dialogue: 0,0:18:19.17,0:18:20.00,Default,,0,0,0,,ありがと
Dialogue: 0,0:18:20.88,0:18:22.42,Default,,0,0,0,,今日は 珍しくシラフじゃない？
Dialogue: 0,0:18:22.72,0:18:24.80,Default,,0,0,0,,うーん　ちょっちね
Dialogue: 0,0:18:24.93,0:18:27.64,Default,,0,0,0,,（リツコ）仕事？　それとも男？
Dialogue: 0,0:18:27.76,0:18:29.18,Default,,0,0,0,,（ミサト）う… いろいろ
Dialogue: 0,0:18:29.31,0:18:32.27,Default,,0,0,0,,（リツコ）\Nふーん まだ好きなのかしら？
Dialogue: 0,0:18:32.39,0:18:33.39,Default,,0,0,0,,（ミサト）ぶっ！
Dialogue: 0,0:18:33.52,0:18:35.14,Default,,0,0,0,,へ… 変なこと言わないでよ！
Dialogue: 0,0:18:35.85,0:18:37.61,Default,,0,0,0,,誰が あんなヤツと！
Dialogue: 0,0:18:38.31,0:18:39.27,Default,,0,0,0,,ああっ
Dialogue: 0,0:18:39.40,0:18:41.32,Default,,0,0,0,,いくら若気の至りとはいえ
Dialogue: 0,0:18:41.44,0:18:43.61,Default,,0,0,0,,あんなのと つきあっていたなんて
Dialogue: 0,0:18:43.74,0:18:45.32,Default,,0,0,0,,我が人生最大の汚点だわ
Dialogue: 0,0:18:46.20,0:18:49.87,Default,,0,0,0,,（リツコ）\N私が言ったのは“加持君が”よ\N動揺させちゃった？
Dialogue: 0,0:18:49.99,0:18:51.16,Default,,0,0,0,,（ミサト）あんたねぇ〜！
Dialogue: 0,0:18:51.29,0:18:52.87,Default,,0,0,0,,（リツコ）\N怒るのは図星を突かれた証拠よ
Dialogue: 0,0:18:53.16,0:18:54.12,Default,,0,0,0,,（ミサト）うぅ
Dialogue: 0,0:18:54.25,0:18:56.71,Default,,0,0,0,,今度は もう少し素直になったら？
Dialogue: 0,0:18:56.83,0:18:58.46,Default,,0,0,0,,８年前とは違うんだから
Dialogue: 0,0:18:59.04,0:19:01.38,Default,,0,0,0,,（ミサト）\N変わってないわ ちっとも
Dialogue: 0,0:19:01.50,0:19:02.55,Default,,0,0,0,,大人になってない
Dialogue: 0,0:19:03.92,0:19:06.68,Default,,0,0,0,,さぁ〜て！　仕事仕事
Dialogue: 0,0:19:06.80,0:19:08.47,Default,,0,0,0,,あしたは決戦だもんね
Dialogue: 0,0:19:19.27,0:19:19.65,Default,,0,0,0,,♪
Dialogue: 0,0:19:19.65,0:19:22.69,Default,,0,0,0,,♪
Dialogue: 0,0:19:19.65,0:19:22.69,Default,,0,0,0,,（青葉）\N目標は強(ごう)羅(ら)絶対防衛線を突破
Dialogue: 0,0:19:22.69,0:19:22.82,Default,,0,0,0,,♪
Dialogue: 0,0:19:22.82,0:19:24.07,Default,,0,0,0,,♪
Dialogue: 0,0:19:22.82,0:19:24.07,Default,,0,0,0,,（ミサト）来たわね
Dialogue: 0,0:19:24.07,0:19:24.65,Default,,0,0,0,,♪
Dialogue: 0,0:19:24.65,0:19:25.86,Default,,0,0,0,,♪
Dialogue: 0,0:19:24.65,0:19:25.86,Default,,0,0,0,,今度は抜かりないわよ
Dialogue: 0,0:19:25.86,0:19:26.28,Default,,0,0,0,,♪
Dialogue: 0,0:19:26.65,0:19:29.24,Default,,0,0,0,,音楽スタートと同時に\NＡ(エー).Ｔ(ティー).フィールドを展開
Dialogue: 0,0:19:29.74,0:19:32.66,Default,,0,0,0,,あとは作戦どおりに\N２人とも いいわね？
Dialogue: 0,0:19:33.04,0:19:33.87,Default,,0,0,0,,（アスカ･シンジ）\N了解！
Dialogue: 0,0:19:34.62,0:19:36.29,Default,,0,0,0,,（青葉）目標は山間部に侵入
Dialogue: 0,0:19:36.91,0:19:38.92,Default,,0,0,0,,いいわね？　最初からフル稼働
Dialogue: 0,0:19:39.04,0:19:40.21,Default,,0,0,0,,最大戦速で行くわよ！
Dialogue: 0,0:19:40.63,0:19:43.38,Default,,0,0,0,,分かってるよ\N62秒でケリをつける
Dialogue: 0,0:19:43.71,0:19:46.30,Default,,0,0,0,,（青葉）\N目標 ゼロ地点に到達します！
Dialogue: 0,0:19:46.42,0:19:47.30,Default,,0,0,0,,（ミサト）外電源パージ
Dialogue: 0,0:19:49.84,0:19:50.97,Default,,0,0,0,,発進！
Dialogue: 0,0:19:53.60,0:20:00.61,Default,,0,0,0,,♪（オーケストラの\N音楽が流れる）
Dialogue: 0,0:20:03.73,0:20:10.74,Default,,0,0,0,,♪
Dialogue: 0,0:20:55.58,0:20:57.79,Default,,0,0,0,,（爆発音）
Dialogue: 0,0:21:03.75,0:21:05.21,Default,,0,0,0,,（マヤ）エヴァ両機 確認
Dialogue: 0,0:21:08.21,0:21:10.51,Default,,0,0,0,,（ミサト）あっちゃぁ〜\N（リツコ）ブザマね
Dialogue: 0,0:21:12.05,0:21:12.55,Default,,0,0,0,,んぁ！　ん？
Dialogue: 0,0:21:12.55,0:21:13.93,Default,,0,0,0,,んぁ！　ん？
Dialogue: 0,0:21:12.55,0:21:13.93,Default,,0,0,0,,（着信音）
Dialogue: 0,0:21:15.68,0:21:16.85,Default,,0,0,0,,（アスカ）ちょっとぉ！
Dialogue: 0,0:21:16.97,0:21:18.81,Default,,0,0,0,,あたしの弐号機に\N何てことすんのよ！
Dialogue: 0,0:21:18.81,0:21:19.10,Default,,0,0,0,,あたしの弐号機に\N何てことすんのよ！
Dialogue: 0,0:21:18.81,0:21:19.10,Default,,0,0,0,,♪
Dialogue: 0,0:21:19.10,0:21:19.23,Default,,0,0,0,,♪
Dialogue: 0,0:21:19.23,0:21:20.10,Default,,0,0,0,,♪
Dialogue: 0,0:21:19.23,0:21:20.10,Default,,0,0,0,,（シンジ）そんな！
Dialogue: 0,0:21:20.10,0:21:20.23,Default,,0,0,0,,♪
Dialogue: 0,0:21:20.23,0:21:21.73,Default,,0,0,0,,♪
Dialogue: 0,0:21:20.23,0:21:21.73,Default,,0,0,0,,そっちが\N突っ掛かってきたんじゃないか！
Dialogue: 0,0:21:21.73,0:21:22.10,Default,,0,0,0,,♪
Dialogue: 0,0:21:22.10,0:21:24.40,Default,,0,0,0,,♪
Dialogue: 0,0:21:22.10,0:21:24.40,Default,,0,0,0,,最後にタイミング外したの\Nそっちでしょ！
Dialogue: 0,0:21:24.40,0:21:25.06,Default,,0,0,0,,♪
Dialogue: 0,0:21:25.06,0:21:25.82,Default,,0,0,0,,♪
Dialogue: 0,0:21:25.06,0:21:25.82,Default,,0,0,0,,（アスカ）\Nふだんから\Nボケボケっとしてるからよ！
Dialogue: 0,0:21:25.82,0:21:26.94,Default,,0,0,0,,（アスカ）\Nふだんから\Nボケボケっとしてるからよ！
Dialogue: 0,0:21:27.07,0:21:29.32,Default,,0,0,0,,昨日の夜だって\N寝ないで何してたの!?
Dialogue: 0,0:21:29.49,0:21:31.57,Default,,0,0,0,,（シンジ）\Nうっ…\Nきょ… 今日の戦いのための—
Dialogue: 0,0:21:31.70,0:21:32.74,Default,,0,0,0,,イメージトレーニングだよ
Dialogue: 0,0:21:32.95,0:21:34.03,Default,,0,0,0,,（アスカ）\Nウソばっかし！
Dialogue: 0,0:21:34.16,0:21:36.58,Default,,0,0,0,,寝てるすきに\N私の唇 奪おうとしたくせに！
Dialogue: 0,0:21:36.70,0:21:39.16,Default,,0,0,0,,（シンジ）\Nズ… ズルいよ！\N起きてたなんて！
Dialogue: 0,0:21:39.29,0:21:40.41,Default,,0,0,0,,（アスカ）\Nひっど〜い！
Dialogue: 0,0:21:40.54,0:21:42.46,Default,,0,0,0,,冗談で言っただけなのに\Nホントだったの!?
Dialogue: 0,0:21:42.58,0:21:43.58,Default,,0,0,0,,キスしたのねー！
Dialogue: 0,0:21:44.42,0:21:46.25,Default,,0,0,0,,（シンジ）\Nしてないよ\N途中で やめたんだよ！
Dialogue: 0,0:21:46.38,0:21:48.50,Default,,0,0,0,,エッチ チカン ヘンタイ！\N信じらんない！
Dialogue: 0,0:21:48.63,0:21:50.63,Default,,0,0,0,,（シンジ）あ… そっちこそ！\N（職員たちの笑い声）
Dialogue: 0,0:21:50.76,0:21:54.18,Default,,0,0,0,,（シンジ）\N寝言と寝相が悪いのが\N悪いんじゃないか！
Dialogue: 0,0:21:54.93,0:21:56.89,Default,,0,0,0,,また恥をかかせおって…
Dialogue: 0,0:22:00.48,0:22:03.23,Default,,0,0,0,,♪ Fly me to the moon
Dialogue: 0,0:22:03.35,0:22:07.94,Default,,0,0,0,,♪ And let me play\Namong the stars
Dialogue: 0,0:22:09.11,0:22:12.07,Default,,0,0,0,,♪ Let me see\Nwhat Spring is like
Dialogue: 0,0:22:12.20,0:22:15.57,Default,,0,0,0,,♪ On Jupiter and Mars
Dialogue: 0,0:22:16.37,0:22:23.29,Default,,0,0,0,,♪ In other words,\Nhold my hand!
Dialogue: 0,0:22:24.58,0:22:31.34,Default,,0,0,0,,♪ In other words,\Ndarling, kiss me!
Dialogue: 0,0:22:32.88,0:22:35.55,Default,,0,0,0,,♪ Fill my heart\Nwith song
Dialogue: 0,0:22:35.93,0:22:40.06,Default,,0,0,0,,♪ And let me sing\Nforevermore
Dialogue: 0,0:22:41.64,0:22:44.23,Default,,0,0,0,,♪ You are all I long for
Dialogue: 0,0:22:44.35,0:22:47.81,Default,,0,0,0,,♪ All I worship\Nand adore
Dialogue: 0,0:22:48.73,0:22:55.74,Default,,0,0,0,,♪ In other words,\Nplease be true
Dialogue: 0,0:22:56.82,0:23:02.83,Default,,0,0,0,,♪ In other words,\NI love you
Dialogue: 0,0:23:03.20,0:23:04.83,Default,,0,0,0,,♪ I love you
Dialogue: 0,0:23:05.58,0:23:06.62,Default,,0,0,0,,♪
Dialogue: 0,0:23:06.62,0:23:09.09,Default,,0,0,0,,♪
Dialogue: 0,0:23:06.62,0:23:09.09,Default,,0,0,0,,（ミサト）\N羽化直前の使徒が眠る浅(あさ)間(ま)山(さん)火口
Dialogue: 0,0:23:09.09,0:23:09.29,Default,,0,0,0,,♪
Dialogue: 0,0:23:09.29,0:23:11.75,Default,,0,0,0,,♪
Dialogue: 0,0:23:09.29,0:23:11.75,Default,,0,0,0,,ネルフは初の捕獲を試みる
Dialogue: 0,0:23:11.75,0:23:11.88,Default,,0,0,0,,♪
Dialogue: 0,0:23:11.88,0:23:12.59,Default,,0,0,0,,♪
Dialogue: 0,0:23:11.88,0:23:12.59,Default,,0,0,0,,極地仕様のエヴァ弐号機が\Nしゃく熱の地獄へ挑む
Dialogue: 0,0:23:12.59,0:23:15.17,Default,,0,0,0,,極地仕様のエヴァ弐号機が\Nしゃく熱の地獄へ挑む
Dialogue: 0,0:23:15.38,0:23:17.55,Default,,0,0,0,,次回 「マグマダイバー」
Dialogue: 0,0:23:17.84,0:23:20.35,Default,,0,0,0,,この次もサービス サービス！
