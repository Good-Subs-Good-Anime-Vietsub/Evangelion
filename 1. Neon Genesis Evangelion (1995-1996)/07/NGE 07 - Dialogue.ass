Dialogue: 0,0:00:01.16,0:00:06.95,Default,,0,0,0,,♪ 残酷な天使のように
Dialogue: 0,0:00:07.08,0:00:14.09,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:00:15.05,0:00:22.05,Default,,0,0,0,,♪
Dialogue: 0,0:00:22.93,0:00:25.85,Default,,0,0,0,,♪ 蒼(あお)い風がいま
Dialogue: 0,0:00:25.97,0:00:29.56,Default,,0,0,0,,♪ 胸のドアを叩(たた)いても
Dialogue: 0,0:00:29.69,0:00:33.27,Default,,0,0,0,,♪ 私だけを\N　　　ただ見つめて
Dialogue: 0,0:00:33.40,0:00:37.57,Default,,0,0,0,,♪ 微(ほほ)笑(え)んでるあなた
Dialogue: 0,0:00:37.69,0:00:40.65,Default,,0,0,0,,♪ そっとふれるもの
Dialogue: 0,0:00:40.78,0:00:44.49,Default,,0,0,0,,♪ もとめることに\N　　　　　　　夢中で
Dialogue: 0,0:00:44.62,0:00:48.16,Default,,0,0,0,,♪ 運命さえ\N　　　まだ知らない
Dialogue: 0,0:00:48.29,0:00:52.04,Default,,0,0,0,,♪ いたいけな瞳
Dialogue: 0,0:00:52.17,0:00:55.79,Default,,0,0,0,,♪ だけどいつか\N　　　気付くでしょう
Dialogue: 0,0:00:55.92,0:00:58.76,Default,,0,0,0,,♪ その背中には
Dialogue: 0,0:00:59.72,0:01:01.51,Default,,0,0,0,,♪ 遥(はる)か未来
Dialogue: 0,0:01:01.63,0:01:06.72,Default,,0,0,0,,♪ めざすための\N　　　羽根があること
Dialogue: 0,0:01:07.10,0:01:10.85,Default,,0,0,0,,♪ 残酷な天使のテーゼ
Dialogue: 0,0:01:10.98,0:01:14.10,Default,,0,0,0,,♪ 窓辺から\N　　　やがて飛び立つ
Dialogue: 0,0:01:14.61,0:01:18.32,Default,,0,0,0,,♪ ほとばしる\N　　　熱いパトスで
Dialogue: 0,0:01:18.44,0:01:21.61,Default,,0,0,0,,♪ 思い出を裏切るなら
Dialogue: 0,0:01:22.07,0:01:25.66,Default,,0,0,0,,♪ この宇宙(そら)を\N　　　　抱いて輝く
Dialogue: 0,0:01:25.78,0:01:29.58,Default,,0,0,0,,♪ 少年よ 神話になれ
Dialogue: 0,0:01:31.91,0:01:34.17,Default,,0,0,0,,Lại nợ anh rồi
Dialogue: 0,0:01:34.29,0:01:35.88,Default,,0,0,0,,Anh cũng không tính trả nợ sao?
Dialogue: 0,0:01:36.42,0:01:39.55,Default,,0,0,0,,Đây là tài liệu mà họ đã dùng quyền tự do báo chí làm lá chắn để gây áp lực
Dialogue: 0,0:01:40.05,0:01:42.34,Default,,0,0,0,,(TUYỆT MẬT - Báo cáo tiến độ lần thứ nhất về Dự án hoàn thiện loài người và vật thể được gọi là Angel "
Dialogue: 0,0:01:42.84,0:01:45.51,Default,,0,0,0,,Chính phủ đang ngầm tiến hành chỉnh sửa bộ luật.
Dialogue: 0,0:01:45.64,0:01:47.60,Default,,0,0,0,,Nhưng trong vài ngày tới dự là sẽ bị đình trệ.
Dialogue: 0,0:01:47.72,0:01:50.02,Default,,0,0,0,,Sao rồi, về cái kế hoạch đó
Dialogue: 0,0:01:50.14,0:01:51.77,Default,,0,0,0,,Cần chúng tôi ra tay không?
Dialogue: 0,0:01:52.39,0:01:55.27,Default,,0,0,0,,Không, xem qua tài liệu của anh thì chắc là không có vấn đề gì cả.
Dialogue: 0,0:01:55.85,0:01:57.69,Default,,0,0,0,,Vậy cứ theo kịch bản mà làm
Dialogue: 0,0:02:03.07,0:02:08.03,Default,,0,0,0,,♪
Dialogue: 0,0:02:08.03,0:02:08.91,Default,,0,0,0,,♪
Dialogue: 0,0:02:08.03,0:02:08.91,Default,,0,0,0,,
Dialogue: 0,0:02:08.91,0:02:10.08,Default,,0,0,0,,♪
Dialogue: 0,0:02:10.62,0:02:12.96,Default,,0,0,0,,Chào chị buổi sáng
Dialogue: 0,0:02:13.08,0:02:15.67,Default,,0,0,0,,
Dialogue: 0,0:02:15.79,0:02:16.63,Default,,0,0,0,,Chào em
Dialogue: 0,0:02:17.25,0:02:20.13,Default,,0,0,0,,
Dialogue: 0,0:02:20.25,0:02:21.59,Default,,0,0,0,,
Dialogue: 0,0:02:21.71,0:02:24.55,Default,,0,0,0,,
Dialogue: 0,0:02:24.68,0:02:26.26,Default,,0,0,0,,
Dialogue: 0,0:02:26.39,0:02:28.01,Default,,0,0,0,,Sáng sớm thì phải như này mới đỉnh chớ!~
Dialogue: 0,0:02:29.14,0:02:30.39,Default,,0,0,0,,Chị không uống cà phê sao?
Dialogue: 0,0:02:30.81,0:02:34.81,Default,,0,0,0,,Người Nhật từ xưa, vào buổi sáng, đã có thói quen
Dialogue: 0,0:02:34.94,0:02:37.48,Default,,0,0,0,,ăn cơm với súp Miso xong rồi nhất định phải uống rượu đó
Dialogue: 0,0:02:37.60,0:02:38.81,Default,,0,0,0,,Chị Misato đang tự nói mình à?
Dialogue: 0,0:02:39.32,0:02:40.23,Default,,0,0,0,,Hứ, nói gì đó
Dialogue: 0,0:02:41.40,0:02:44.49,Default,,0,0,0,,Với lại, sáng nay tới lượt ai nấu cơm vậy nhỉ?
Dialogue: 0,0:02:45.53,0:02:48.57,Default,,0,0,0,,Dường như em đã hiểu sao mà đến từng tuổi này
Dialogue: 0,0:02:48.70,0:02:49.91,Default,,0,0,0,,mà chị vẫn còn độc thân
Dialogue: 0,0:02:50.37,0:02:52.12,Default,,0,0,0,,Xin lỗi ha, chị bầy hầy vậy đó
Dialogue: 0,0:02:52.91,0:02:53.79,Default,,0,0,0,,Với cả luộm thuộm nữa
Dialogue: 0,0:02:54.46,0:02:56.46,Default,,0,0,0,,Lắm mồm quá rồi đó
Dialogue: 0,0:02:57.00,0:02:57.92,Default,,0,0,0,,Cảm ơn vì bữa ăn
Dialogue: 0,0:03:00.71,0:03:02.67,Default,,0,0,0,,Hôm nay chị định tới trường thật sao?
Dialogue: 0,0:03:02.80,0:03:04.21,Default,,0,0,0,,Đương nhiên rồi
Dialogue: 0,0:03:04.34,0:03:06.18,Default,,0,0,0,,lên đó để tư vấn hướng nghiệp
Dialogue: 0,0:03:06.30,0:03:08.01,Default,,0,0,0,,Nhưng chị còn bận công chuyện vậy mà
Dialogue: 0,0:03:08.14,0:03:11.22,Default,,0,0,0,,Hỏng sao, hỏng sao! Này cũng là công việc đấy thôi
Dialogue: 0,0:03:11.35,0:03:12.77,Default,,0,0,0,,Công việc sao
Dialogue: 0,0:03:14.10,0:03:16.35,Default,,0,0,0,,
Dialogue: 0,0:03:16.48,0:03:17.44,Default,,0,0,0,,Rồi~
Dialogue: 0,0:03:18.15,0:03:20.65,Default,,0,0,0,,Ôi chao~ Cám ơn các em đã đến
Dialogue: 0,0:03:20.77,0:03:22.11,Default,,0,0,0,,Ừ, chờ chị xíu nhé
Dialogue: 0,0:03:22.61,0:03:25.86,Default,,0,0,0,,Chị Misato, đừng ra ngoài với bộ dạng đó
Dialogue: 0,0:03:25.99,0:03:27.11,Default,,0,0,0,,ngại lắm đó
Dialogue: 0,0:03:27.24,0:03:28.07,Default,,0,0,0,,Ừ, ừ~
Dialogue: 0,0:03:31.58,0:03:33.16,Default,,0,0,0,,Chào buổi sáng Ikari!
Dialogue: 0,0:03:33.66,0:03:35.58,Default,,0,0,0,,Chị Misato! Bọn em đi đây!
Dialogue: 0,0:03:36.12,0:03:37.25,Default,,0,0,0,,Các em bảo trọng nhé!
Dialogue: 0,0:03:37.37,0:03:39.38,Default,,0,0,0,, Ồ~~
Dialogue: 0,0:03:39.50,0:03:40.67,Default,,0,0,0,,Đi lẹ đi!
Dialogue: 0,0:03:41.34,0:03:42.75,Default,,0,0,0,,Phù
Dialogue: 0,0:03:45.51,0:03:46.97,Default,,0,0,0,,Giỡn mặt sao
Dialogue: 0,0:03:47.09,0:03:49.89,Default,,0,0,0,,Nhưng... cởi mở hơn, biểu lộ cảm xúc nhiều hơn, vậy là đang thay đổi
Dialogue: 0,0:03:50.01,0:03:51.01,Default,,0,0,0,,theo chiều hướng tốt nhỉ?
Dialogue: 0,0:03:54.35,0:03:55.93,Default,,0,0,0,,
Dialogue: 0,0:03:56.14,0:03:57.06,Default,,0,0,0,,Alo
Dialogue: 0,0:03:57.18,0:04:00.19,Default,,0,0,0,,Nó vừa mới ra khỏi nhà, nhờ anh bảo vệ nó từ giờ
Dialogue: 0,0:04:06.07,0:04:07.03,Default,,0,0,0,,
Dialogue: 0,0:04:07.15,0:04:07.99,Default,,0,0,0,,
Dialogue: 0,0:04:12.07,0:04:14.33,Default,,0,0,0,,Áa! Tới rồi kìa!
Dialogue: 0,0:04:16.41,0:04:17.70,Default,,0,0,0,,Ồ~~
Dialogue: 0,0:04:20.83,0:04:22.50,Default,,0,0,0,,Ngầu đét! Ai vậy?
Dialogue: 0,0:04:22.63,0:04:23.71,Default,,0,0,0,,Người giám hộ của Ikari hả?
Dialogue: 0,0:04:23.92,0:04:26.42,Default,,0,0,0,,Gì chớ? Ikari mà được chị đẹp thế kia giám hộ cho á?
Dialogue: 0,0:04:26.55,0:04:27.38,Default,,0,0,0,,Mấy thằng khờ...
Dialogue: 0,0:04:28.51,0:04:29.93,Default,,0,0,0,,
Dialogue: 0,0:04:30.05,0:04:32.93,Default,,0,0,0,,Không hổ là chị Misato~
Dialogue: 0,0:04:33.05,0:04:34.43,Default,,0,0,0,,Thế sao?
Dialogue: 0,0:04:34.56,0:04:37.85,Default,,0,0,0,,Giám đốc chiến lược của NERV mà cỡ đó đó, ngon thật!
Dialogue: 0,0:04:37.98,0:04:38.98,Default,,0,0,0,,Vậy luôn...
Dialogue: 0,0:04:39.10,0:04:39.98,Default,,0,0,0,,
Dialogue: 0,0:04:41.10,0:04:43.81,Default,,0,0,0,,Hên ha Kensuke! Mừng là Shinji còn con nít
Dialogue: 0,0:04:43.94,0:04:45.90,Default,,0,0,0,,Ừa, xem như bớt một đối thủ
Dialogue: 0,0:04:46.78,0:04:50.24,Default,,0,0,0,,Bọn Toji không biết chị ta luộm thuộm cỡ nào đâu
Dialogue: 0,0:04:50.40,0:04:51.32,Default,,0,0,0,,Ahhh~
Dialogue: 0,0:04:51.45,0:04:54.24,Default,,0,0,0,,Ước gì chị ấy làm ghệ mình~ Moak!
Dialogue: 0,0:04:54.37,0:04:56.20,Default,,0,0,0,,Rồi sẽ khổ lắm đó
Dialogue: 0,0:04:56.33,0:04:57.79,Default,,0,0,0,,Sư phụ chẳng biết gì cả
Dialogue: 0,0:04:58.16,0:05:01.25,Default,,0,0,0,,Được rồi, hòa bình thế giới này giao cho cậu
Dialogue: 0,0:05:01.37,0:05:04.29,Default,,0,0,0,,Vậy nên chị Misato để tụi này lo!
Dialogue: 0,0:05:04.84,0:05:05.92,Default,,0,0,0,,
Dialogue: 0,0:05:06.34,0:05:09.63,Default,,0,0,0,,Unit-01, đã làm lạnh xong
Dialogue: 0,0:05:09.76,0:05:11.88,Default,,0,0,0,,Hòa bình thế giới sao...
Dialogue: 0,0:05:12.01,0:05:13.09,Default,,0,0,0,,Eva vì lẽ đó sao
Dialogue: 0,0:05:14.60,0:05:16.60,Default,,0,0,0,,Eva rốt cuộc là gì chứ
Dialogue: 0,0:05:16.72,0:05:18.81,Default,,0,0,0,,Entry Plug toàn bốc mùi máu
Dialogue: 0,0:05:18.93,0:05:22.19,Default,,0,0,0,,mà sao mình bình tĩnh thế
Dialogue: 0,0:05:22.85,0:05:25.81,Default,,0,0,0,,Rốt cuộc thì mình chẳng hiểu gì cả
Dialogue: 0,0:05:26.65,0:05:29.32,Default,,0,0,0,,Các bộ phận sinh học ở ngực của Unit-00 sao rồi?
Dialogue: 0,0:05:29.44,0:05:30.90,Default,,0,0,0,,Hư hỏng nặng rồi
Dialogue: 0,0:05:31.03,0:05:34.45,Default,,0,0,0,,Sẽ làm mới lại nhưng vừa đủ trong ngân sách bổ sung thôi
Dialogue: 0,0:05:34.57,0:05:36.53,Default,,0,0,0,,Lúc này mà Unit-02 bên Đức tới đây
Dialogue: 0,0:05:36.66,0:05:38.54,Default,,0,0,0,,thì biết đâu yên tâm hơn
Dialogue: 0,0:05:38.66,0:05:40.16,Default,,0,0,0,,Chưa chắc, trái lại
Dialogue: 0,0:05:40.29,0:05:43.17,Default,,0,0,0,,Việc xử lí mấy con Angel trên mặt đất đâu có miễn phí?
Dialogue: 0,0:05:43.29,0:05:46.25,Default,,0,0,0,,Đúng là.... keo kiệt về khoản tiền nong thật á
Dialogue: 0,0:05:46.38,0:05:48.59,Default,,0,0,0,,Chẳng phải nơi này đang đánh cược cả mạng sống con người sao?
Dialogue: 0,0:05:48.71,0:05:49.92,Default,,0,0,0,,Cũng phải chịu thôi
Dialogue: 0,0:05:50.05,0:05:52.17,Default,,0,0,0,,Con người không chỉ sống nhờ vào Eva
Dialogue: 0,0:05:52.30,0:05:55.39,Default,,0,0,0,,Mà vì sự sống còn của loài người cũng phải bỏ tiền ra thôi
Dialogue: 0,0:05:55.51,0:05:58.60,Default,,0,0,0,,Về ngân sách ha... Vậy chỉ huy lại họp nữa sao?
Dialogue: 0,0:05:58.72,0:06:00.68,Default,,0,0,0,,Ừ, ông ấy đang trên máy bay rồi
Dialogue: 0,0:06:01.31,0:06:04.10,Default,,0,0,0,,Chỉ huy vắng mặt cái ở đây cũng yên tĩnh hẳn ha
Dialogue: 0,0:06:04.23,0:06:06.52,Default,,0,0,0,,
Dialogue: 0,0:06:10.73,0:06:11.82,Default,,0,0,0,,
Dialogue: 0,0:06:11.82,0:06:13.11,Default,,0,0,0,,
Dialogue: 0,0:06:11.82,0:06:13.11,Default,,0,0,0,,Xin phép anh
Dialogue: 0,0:06:13.28,0:06:15.61,Default,,0,0,0,,Tiện thể, cho tôi ngồi đây được không?
Dialogue: 0,0:06:17.82,0:06:21.79,Default,,0,0,0,,Việc điều chỉnh ngân sách cho việc thu hồi sản phẩm mẫu được duyệt nhanh nhỉ
Dialogue: 0,0:06:21.91,0:06:25.54,Default,,0,0,0,,Ban chấp hành cũng chỉ lo ưu tiên sự sống còn của chính mình.
Dialogue: 0,0:06:25.67,0:06:27.67,Default,,0,0,0,,Về khoản đó thì chẳng tiếc đâu
Dialogue: 0,0:06:27.79,0:06:31.67,Default,,0,0,0,,Vì lập luận của họ là "Angel sẽ không xuất hiện nữa" mà
Dialogue: 0,0:06:31.80,0:06:33.84,Default,,0,0,0,,Ah... Lại thêm 1 tin tốt
Dialogue: 0,0:06:34.13,0:06:39.39,Default,,0,0,0,,Trừ Mỹ ra, các nước thành viên thuộc Hội đồng Bảo an đã duyệt ngân sách cho Eva Unit-06
Dialogue: 0,0:06:39.51,0:06:42.47,Default,,0,0,0,,Sớm muộn gì Mỹ cũng duyệt luôn thôi
Dialogue: 0,0:06:42.85,0:06:46.52,Default,,0,0,0,,Tụi Mỹ kì thị người thất nghiệp mà
Dialogue: 0,0:06:47.02,0:06:48.27,Default,,0,0,0,,Còn nước của anh thì sao?
Dialogue: 0,0:06:48.40,0:06:50.48,Default,,0,0,0,,Sẽ tham gia chế tạo từ Unit-08 trở đi
Dialogue: 0,0:06:50.61,0:06:53.82,Default,,0,0,0,,Kế hoạch bảo trì cho Giai đoạn 2 vẫn còn hiệu lực
Dialogue: 0,0:06:53.94,0:06:55.90,Default,,0,0,0,,Nhưng vẫn còn vấn đề là chưa tìm được phi công
Dialogue: 0,0:06:56.03,0:06:57.86,Default,,0,0,0,,Nhưng vẫn còn vấn đề là chưa tìm được phi công
Dialogue: 0,0:06:58.07,0:07:00.53,Default,,0,0,0,,Angel lại xuất hiện rồi
Dialogue: 0,0:07:01.03,0:07:03.45,Default,,0,0,0,,Có lẽ chúng ta chỉ còn cách đánh bại họ thôi
Dialogue: 0,0:07:04.20,0:07:07.62,Default,,0,0,0,,Tôi cũng không muốn Chấn động thứ hai lặp lại lần nữa đâu
Dialogue: 0,0:07:08.63,0:07:13.01,Default,,0,0,0,,Vậy, Chấn động thứ hai, thứ khiến cho lục địa Nam Cực bốc hơi...
Dialogue: 0,0:07:13.59,0:07:15.59,Default,,0,0,0,,Đúng, trong sách giáo khoa lịch sử ghi rằng
Dialogue: 0,0:07:15.72,0:07:18.47,Default,,0,0,0,,đây là một đại thảm họa do một thiên thạch khối lượng lớn rơi xuống
Dialogue: 0,0:07:18.89,0:07:21.89,Default,,0,0,0,,Nhưng sự thật thường bị che giấu
Dialogue: 0,0:07:22.01,0:07:24.02,Default,,0,0,0,,Loài người vào 15 năm trước
Dialogue: 0,0:07:24.14,0:07:26.52,Default,,0,0,0,,Đã phát hiện ra một vật thể hình người
Dialogue: 0,0:07:26.64,0:07:27.69,Default,,0,0,0,,được gọi là Angel đầu tiên
Dialogue: 0,0:07:28.44,0:07:32.36,Default,,0,0,0,,Nhưng trong khi điều tra, đã xảy ra một vụ nổ lớn không rõ nguyên nhân
Dialogue: 0,0:07:32.90,0:07:35.24,Default,,0,0,0,,Đó mới chính là sự thật về Chấn động thứ hai
Dialogue: 0,0:07:35.69,0:07:37.53,Default,,0,0,0,,Vậy, những việc chúng ta đang làm là...
Dialogue: 0,0:07:38.28,0:07:41.45,Default,,0,0,0,,Ngăn chặn Chấn động thứ ba được dự đoán là có thể xảy ra
Dialogue: 0,0:07:41.58,0:07:43.29,Default,,0,0,0,,Đó là mục đích của NERV
Dialogue: 0,0:07:43.41,0:07:44.95,Default,,0,0,0,,Cũng như Evangelion
Dialogue: 0,0:07:45.66,0:07:48.12,Default,,0,0,0,,Với lại, nghe nói là ngày mai sẽ triển theo đúng kế hoạch
Dialogue: 0,0:07:50.08,0:07:50.92,Default,,0,0,0,,Tôi hiểu rồi
Dialogue: 0,0:07:51.04,0:07:53.34,Default,,0,0,0,,
Dialogue: 0,0:07:54.71,0:08:01.72,Default,,0,0,0,,♪
Dialogue: 0,0:08:02.80,0:08:03.64,Default,,0,0,0,,Éc!...
Dialogue: 0,0:08:03.76,0:08:04.60,Default,,0,0,0,,Chào em
Dialogue: 0,0:08:05.68,0:08:07.02,Default,,0,0,0,,Em... chào chị
Dialogue: 0,0:08:07.43,0:08:09.73,Default,,0,0,0,,Chị đi Tokyo cũ có việc đây
Dialogue: 0,0:08:10.10,0:08:12.52,Default,,0,0,0,,Chắc chị sẽ về trễ nên em order gì đó về ăn đi
Dialogue: 0,0:08:13.36,0:08:13.57,Default,,0,0,0,,Bye em
Dialogue: 0,0:08:13.57,0:08:14.44,Default,,0,0,0,,Bye em
Dialogue: 0,0:08:13.57,0:08:14.44,Default,,0,0,0,,
Dialogue: 0,0:08:14.44,0:08:15.40,Default,,0,0,0,,
Dialogue: 0,0:08:15.69,0:08:17.11,Default,,0,0,0,,Dạ...
Dialogue: 0,0:08:31.29,0:08:32.29,Default,,0,0,0,,Nơi này hồi xưa...
Dialogue: 0,0:08:32.67,0:08:35.59,Default,,0,0,0,,Từng được gọi là một thành phố hoa lệ ha
Dialogue: 0,0:08:35.71,0:08:37.17,Default,,0,0,0,,Tới rồi
Dialogue: 0,0:08:38.22,0:08:41.76,Default,,0,0,0,,Đâu nhất thiết phải làm việc ở chỗ như này chứ...
Dialogue: 0,0:08:41.89,0:08:44.55,Default,,0,0,0,,Vậy bên Phòng vệ có nhúng tay vào kế hoạch không?
Dialogue: 0,0:08:44.68,0:08:46.10,Default,,0,0,0,,Lực lượng Phòng vệ Nhật Bản?
Dialogue: 0,0:08:46.22,0:08:48.48,Default,,0,0,0,,Không, họ không được phép can thiệp
Dialogue: 0,0:08:48.60,0:08:50.44,Default,,0,0,0,,Bảo sao bên này cứ tự tung tự tác.
Dialogue: 0,0:08:55.36,0:08:59.11,Default,,0,0,0,,
Dialogue: 0,0:08:59.11,0:09:01.24,Default,,0,0,0,,
Dialogue: 0,0:08:59.11,0:09:01.24,Default,,0,0,0,,Hôm nay, xin chân thành cảm ơn \N　(Lễ công bố và kỷ niệm hoàn thành J.A.)
Dialogue: 0,0:09:01.24,0:09:01.28,Default,,0,0,0,,
Dialogue: 0,0:09:01.41,0:09:05.20,Default,,0,0,0,,Các vị đã đến tham dự buổi ra mắt sản phẩm \N(Đại diện NERV)
Dialogue: 0,0:09:06.20,0:09:08.37,Default,,0,0,0,,của Liên hiệp Ngành hóa học - công nghiệp nặng Nhật Bản
Dialogue: 0,0:09:09.16,0:09:11.71,Default,,0,0,0,,Lát nữa, mời quý vị đến phòng điều khiển
Dialogue: 0,0:09:11.83,0:09:13.83,Default,,0,0,0,,Để chiêm ngưỡng buổi vận hành thử nghiệm chính thức
Dialogue: 0,0:09:14.58,0:09:16.75,Default,,0,0,0,,Bây giờ mời quý vị đặt câu hỏi nếu có
Dialogue: 0,0:09:16.88,0:09:17.84,Default,,0,0,0,,Có!
Dialogue: 0,0:09:17.96,0:09:20.97,Default,,0,0,0,,Đây là tiến sĩ Akagi Ritsuko danh tiếng
Dialogue: 0,0:09:21.17,0:09:23.22,Default,,0,0,0,,rất vinh dự được tiếp đón chị
Dialogue: 0,0:09:23.34,0:09:25.55,Default,,0,0,0,,Tôi đặt câu hỏi được không?
Dialogue: 0,0:09:25.68,0:09:27.47,Default,,0,0,0,,Cứ tự nhiên, mời chị
Dialogue: 0,0:09:27.60,0:09:31.10,Default,,0,0,0,,Khi nãy anh trình bày là có lắp động cơ đốt trong phải không?
Dialogue: 0,0:09:31.23,0:09:33.90,Default,,0,0,0,,Đúng, đó là đặc trưng của cỗ máy này
Dialogue: 0,0:09:34.02,0:09:38.15,Default,,0,0,0,,đảm bảo rằng nó có thể chiến đấu trong vòng 150 ngày liên tục
Dialogue: 0,0:09:38.28,0:09:41.15,Default,,0,0,0,,Tuy nhiên, đối với một vũ khí chiến đấu trên mặt đất vốn dùng để đánh cận chiến
Dialogue: 0,0:09:41.28,0:09:42.90,Default,,0,0,0,,thì việc lắp lò phản ứng vào như vậy
Dialogue: 0,0:09:43.03,0:09:45.95,Default,,0,0,0,,nếu xét về tính an toàn thì tôi cho rằng là rủi ro quá lớn
Dialogue: 0,0:09:46.53,0:09:49.91,Default,,0,0,0,,Tôi thì cho rằng nó hữu dụng hơn so với một vũ khí chiến đấu hoạt động không đến 5 phút
Dialogue: 0,0:09:50.54,0:09:53.08,Default,,0,0,0,,Việc điều khiển từ xa sẽ gây ra hạn chế trong ứng phó khẩn cấp
Dialogue: 0,0:09:53.71,0:09:56.92,Default,,0,0,0,,So với việc tạo gánh nặng cho phi công, ảnh hưởng tới tinh thần
Dialogue: 0,0:09:57.04,0:09:58.63,Default,,0,0,0,,theo tôi là nhân đạo hơn
Dialogue: 0,0:09:58.75,0:10:01.34,Default,,0,0,0,,Haiz… thôi đi, trẻ con quá đấy.
Dialogue: 0,0:10:01.47,0:10:03.01,Default,,0,0,0,,Cũng có vấn đề khi con người điều khiển nó
Dialogue: 0,0:10:03.43,0:10:05.64,Default,,0,0,0,,Rơi vào trạng thái mất kiểm soát, cho phép cuồng hóa
Dialogue: 0,0:10:05.76,0:10:07.51,Default,,0,0,0,,Tôi lại cho rằng như này vẫn an toàn hơn
Dialogue: 0,0:10:07.64,0:10:08.93,Default,,0,0,0,,so với thứ vũ khí cực kì nguy hiểm thế kia chứ
Dialogue: 0,0:10:09.68,0:10:12.10,Default,,0,0,0,,Vũ khí mà lại không kiểm soát được thì hoàn toàn vô nghĩa
Dialogue: 0,0:10:12.68,0:10:14.94,Default,,0,0,0,,Chẳng khác gì bà điên cả, haha!
Dialogue: 0,0:10:14.94,0:10:15.60,Default,,0,0,0,,Chẳng khác gì bà điên cả, haha!
Dialogue: 0,0:10:14.94,0:10:15.60,Default,,0,0,0,,
Dialogue: 0,0:10:15.60,0:10:15.73,Default,,0,0,0,,
Dialogue: 0,0:10:15.73,0:10:17.40,Default,,0,0,0,,
Dialogue: 0,0:10:15.73,0:10:17.40,Default,,0,0,0,,Bó tay
Dialogue: 0,0:10:17.40,0:10:19.69,Default,,0,0,0,,
Dialogue: 0,0:10:19.82,0:10:21.78,Default,,0,0,0,,Vì thế mới có phi công và công nghệ
Dialogue: 0,0:10:22.24,0:10:26.62,Default,,0,0,0,,Chẳng lẽ cô nghĩ khoa học và tâm trí con người có thể kìm hãm được con yêu quái đó sao?
Dialogue: 0,0:10:26.74,0:10:27.99,Default,,0,0,0,,Thật không đó?
Dialogue: 0,0:10:28.12,0:10:29.24,Default,,0,0,0,,Ừ, dĩ nhiên rồi
Dialogue: 0,0:10:29.87,0:10:32.62,Default,,0,0,0,,Chính vì NERV dựa dẫm vào thứ gọi là tâm trí con người
Dialogue: 0,0:10:32.75,0:10:35.46,Default,,0,0,0,,Nên mới để cho chúng cuồng loạn như vừa rồi.
Dialogue: 0,0:10:35.58,0:10:38.92,Default,,0,0,0,,Hậu quả là Liên hợp quốc buộc phải bổ sung thêm một khoảng ngân sách khổng lồ
Dialogue: 0,0:10:39.04,0:10:42.42,Default,,0,0,0,,Ở một quốc gia nào đó, hơn 20.000 người đứng trước nguy cơ chết đói
Dialogue: 0,0:10:42.55,0:10:44.97,Default,,0,0,0,,Hơn nữa, mặc cho sự cố nghiêm trọng tới vậy,
Dialogue: 0,0:10:45.09,0:10:47.18,Default,,0,0,0,,đến giờ nguyên nhân cũng chưa được làm rõ
Dialogue: 0,0:10:47.72,0:10:51.35,Default,,0,0,0,,Ít nhất thì với tư cách là những người chịu trách nhiệm, hãy làm tròn bổn phận của các chị đi chứ
Dialogue: 0,0:10:51.60,0:10:52.72,Default,,0,0,0,,May cho các chị
Dialogue: 0,0:10:52.85,0:10:55.10,Default,,0,0,0,,NERV lại được bảo hộ pháp lý
Dialogue: 0,0:10:55.23,0:10:58.06,Default,,0,0,0,,Nên các chị chẳng cần chịu trách nhiệm gì cả
Dialogue: 0,0:10:58.19,0:10:59.36,Default,,0,0,0,,Dù anh có nói gì đi nữa
Dialogue: 0,0:10:59.86,0:11:02.78,Default,,0,0,0,,Thì ngoài vũ khí chủ lực của NERV ra, không gì có thể đánh bại được thực thể phe địch kia!
Dialogue: 0,0:11:03.36,0:11:05.20,Default,,0,0,0,,Ý chị là AT-Field sao?
Dialogue: 0,0:11:05.32,0:11:07.20,Default,,0,0,0,,Cái đó cũng chỉ còn là vấn đề về thời gian thôi
Dialogue: 0,0:11:07.20,0:11:07.82,Default,,0,0,0,,Cái đó cũng chỉ còn là vấn đề về thời gian thôi
Dialogue: 0,0:11:07.20,0:11:07.82,Default,,0,0,0,,
Dialogue: 0,0:11:07.82,0:11:07.95,Default,,0,0,0,,
Dialogue: 0,0:11:07.95,0:11:10.49,Default,,0,0,0,,
Dialogue: 0,0:11:07.95,0:11:10.49,Default,,0,0,0,,NERV sắp hết thời rồi
Dialogue: 0,0:11:10.49,0:11:12.70,Default,,0,0,0,,
Dialogue: 0,0:11:13.20,0:11:14.50,Default,,0,0,0,,
Dialogue: 0,0:11:14.50,0:11:15.33,Default,,0,0,0,,
Dialogue: 0,0:11:14.50,0:11:15.33,Default,,0,0,0,,
Dialogue: 0,0:11:15.33,0:11:15.46,Default,,0,0,0,,
Dialogue: 0,0:11:15.46,0:11:17.33,Default,,0,0,0,,
Dialogue: 0,0:11:15.46,0:11:17.33,Default,,0,0,0,,Khốn nạn!
Dialogue: 0,0:11:17.46,0:11:20.46,Default,,0,0,0,,Thật chứ mấy cái thằng khốn!
Dialogue: 0,0:11:20.59,0:11:24.34,Default,,0,0,0,,Chẳng phải tụi nó trả đũa do không nhận được quyền lợi như tụi mình sao?
Dialogue: 0,0:11:24.46,0:11:26.93,Default,,0,0,0,,Tức chết đi được!!
Dialogue: 0,0:11:27.05,0:11:28.51,Default,,0,0,0,,
Dialogue: 0,0:11:28.64,0:11:30.68,Default,,0,0,0,,Thôi đi, trẻ con quá đấy.
Dialogue: 0,0:11:31.26,0:11:33.72,Default,,0,0,0,,Tự mãn với bản thân, luôn muốn được khen ngợi
Dialogue: 0,0:11:34.27,0:11:36.35,Default,,0,0,0,,Hắn không là cái thá gì đâu
Dialogue: 0,0:11:36.48,0:11:37.52,Default,,0,0,0,,Nhưng mà sao chúng
Dialogue: 0,0:11:37.64,0:11:39.10,Default,,0,0,0,,biết luôn cả AT-Field cơ chứ?
Dialogue: 0,0:11:39.65,0:11:41.31,Default,,0,0,0,,Tin mật bị rò rỉ tùm lum hết rồi
Dialogue: 0,0:11:41.44,0:11:43.28,Default,,0,0,0,,Không biết cục tình báo đang làm ăn kiểu gì nữa.
Dialogue: 0,0:11:43.40,0:11:45.03,Default,,0,0,0,,
Dialogue: 0,0:11:54.20,0:11:56.83,Default,,0,0,0,,♪
Dialogue: 0,0:11:56.83,0:12:00.00,Default,,0,0,0,,♪
Dialogue: 0,0:11:56.83,0:12:00.00,Default,,0,0,0,,Bây giờ chúng tôi sẽ bắt đầu thử nghiệm khởi động J.A.
Dialogue: 0,0:12:00.00,0:12:00.50,Default,,0,0,0,,♪
Dialogue: 0,0:12:00.50,0:12:01.21,Default,,0,0,0,,♪
Dialogue: 0,0:12:00.50,0:12:01.21,Default,,0,0,0,,Không có bất kỳ rủi ro nào
Dialogue: 0,0:12:01.21,0:12:02.34,Default,,0,0,0,,Không có bất kỳ rủi ro nào
Dialogue: 0,0:12:03.25,0:12:05.80,Default,,0,0,0,,Quý vị hãy quan sát qua cửa sổ cho an toàn
Dialogue: 0,0:12:07.80,0:12:08.97,Default,,0,0,0,,Chuẩn bị khởi động
Dialogue: 0,0:12:09.22,0:12:10.30,Default,,0,0,0,,Bắt đầu thử nghiệm
Dialogue: 0,0:12:10.43,0:12:11.68,Default,,0,0,0,,Giải phóng toàn bộ năng lượng
Dialogue: 0,0:12:11.80,0:12:13.22,Default,,0,0,0,,Áp suất: Bình thường
Dialogue: 0,0:12:13.35,0:12:15.10,Default,,0,0,0,,Bộ phận làm mát, lưu thông bình thường
Dialogue: 0,0:12:15.22,0:12:16.85,Default,,0,0,0,,Mở hết các thanh điều khiển
Dialogue: 0,0:12:16.98,0:12:19.02,Default,,0,0,0,,Năng lượng vượt ngưỡng cực hạn
Dialogue: 0,0:12:19.14,0:12:20.27,Default,,0,0,0,,Đầu ra: Bình thường
Dialogue: 0,0:12:20.56,0:12:21.56,Default,,0,0,0,,Bắt đầu bước đi
Dialogue: 0,0:12:21.90,0:12:24.32,Default,,0,0,0,,Bước lên phía trước, tốc độ cực chậm. Chân phải, tiến lên!
Dialogue: 0,0:12:24.44,0:12:25.78,Default,,0,0,0,,Đã rõ, bước lên!
Dialogue: 0,0:12:25.90,0:12:28.07,Default,,0,0,0,,Bước lên trước với tốc độ cực chậm. Chân phải, tiến lên!
Dialogue: 0,0:12:32.82,0:12:34.24,Default,,0,0,0,,Ồ!!
Dialogue: 0,0:12:34.37,0:12:35.33,Default,,0,0,0,,Độ cân bằng: Ổn định
Dialogue: 0,0:12:35.45,0:12:36.49,Default,,0,0,0,,Năng lượng: Ổn định
Dialogue: 0,0:12:36.62,0:12:39.25,Default,,0,0,0,,Đã rõ! Tiếp tục, chân trái bước lên!
Dialogue: 0,0:12:39.37,0:12:40.46,Default,,0,0,0,,Tiếp tục phát huy!
Dialogue: 0,0:12:41.54,0:12:42.79,Default,,0,0,0,,
Dialogue: 0,0:12:43.21,0:12:44.67,Default,,0,0,0,,Đi đứng đàng hoàng đấy
Dialogue: 0,0:12:44.79,0:12:47.13,Default,,0,0,0,,Bảo sao hắn tự mãn như thế
Dialogue: 0,0:12:48.76,0:12:49.59,Default,,0,0,0,,
Dialogue: 0,0:12:49.76,0:12:50.72,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:12:50.84,0:12:53.76,Default,,0,0,0,,Có bất thường, áp suất bên trong lò phản ứng đang tăng lên
Dialogue: 0,0:12:54.18,0:12:56.18,Default,,0,0,0,,Nhiệt độ của nước làm mát cho Giai đoạn 1 cũng đang tăng lên
Dialogue: 0,0:12:56.97,0:12:59.60,Default,,0,0,0,,Mở van, bơm chất làm chậm
Dialogue: 0,0:12:59.73,0:13:02.77,Default,,0,0,0,,Không thể, không đưa đầu ra ống bơm lên được!
Dialogue: 0,0:13:05.52,0:13:07.61,Default,,0,0,0,,Không ổn rồi! \NNgắt nguồn năng lượng, dừng khẩn cấp!
Dialogue: 0,0:13:07.73,0:13:09.94,Default,,0,0,0,,Phát tín hiệu dừng, xác nhận để tiến hành!
Dialogue: 0,0:13:10.11,0:13:11.24,Default,,0,0,0,,Không nhận tín hiệu!
Dialogue: 0,0:13:11.36,0:13:12.61,Default,,0,0,0,,Mất kết nối vô tuyến!
Dialogue: 0,0:13:13.03,0:13:14.32,Default,,0,0,0,,Không điều khiển được!
Dialogue: 0,0:13:14.45,0:13:15.70,Default,,0,0,0,,Không thể nào...
Dialogue: 0,0:13:15.83,0:13:17.79,Default,,0,0,0,,Á!!!
Dialogue: 0,0:13:17.91,0:13:20.29,Default,,0,0,0,,Chạy đi! Chạy đi!
Dialogue: 0,0:13:20.41,0:13:21.50,Default,,0,0,0,,
Dialogue: 0,0:13:27.30,0:13:29.46,Default,,0,0,0,,
Dialogue: 0,0:13:30.34,0:13:32.97,Default,,0,0,0,,Con Robot mất nết y như người tạo ra nó ha!
Dialogue: 0,0:13:36.51,0:13:37.39,Default,,0,0,0,,
Dialogue: 0,0:13:37.93,0:13:39.18,Default,,0,0,0,,Bình điều áp phát sinh vấn đề!
Dialogue: 0,0:13:39.35,0:13:40.85,Default,,0,0,0,,Thanh điều khiển không hoạt động!
Dialogue: 0,0:13:40.98,0:13:43.10,Default,,0,0,0,,Cứ thế này sẽ có nguy cơ tan chảy lò phản ứng hạt nhân
Dialogue: 0,0:13:43.56,0:13:45.98,Default,,0,0,0,,Ôi, không thể tin được...
Dialogue: 0,0:13:46.11,0:13:48.65,Default,,0,0,0,,J.A. được lập trình để lường trước và xử lí mọi sai sót mà
Dialogue: 0,0:13:48.78,0:13:52.57,Default,,0,0,0,,J.A. được lập trình để lường trước và xử lí mọi sai sót mà
Dialogue: 0,0:13:52.70,0:13:54.36,Default,,0,0,0,,Không thể xảy ra tình huống như này được
Dialogue: 0,0:13:54.78,0:13:57.78,Default,,0,0,0,,Nhưng ngay lúc này, nguy cơ tan chảy lõi phản ứng đang cận kề rồi
Dialogue: 0,0:13:58.70,0:14:02.96,Default,,0,0,0,,Đến nước này chỉ còn cách đợi nó tự ngưng lại
Dialogue: 0,0:14:03.08,0:14:04.71,Default,,0,0,0,,Xác suất tự động dừng là bao nhiêu?
Dialogue: 0,0:14:04.83,0:14:06.71,Default,,0,0,0,,0.00002%
Dialogue: 0,0:14:06.84,0:14:07.79,Default,,0,0,0,,Phải chờ phép màu xảy ra
Dialogue: 0,0:14:08.25,0:14:10.55,Default,,0,0,0,,Phải dốc sức liều mạng thay vì chờ đợi phép màu thôi!
Dialogue: 0,0:14:10.67,0:14:11.72,Default,,0,0,0,,Hãy cho tôi biết cách dừng nó!
Dialogue: 0,0:14:12.72,0:14:14.22,Default,,0,0,0,,Đã thử mọi cách rồi
Dialogue: 0,0:14:14.34,0:14:15.18,Default,,0,0,0,,Không
Dialogue: 0,0:14:15.30,0:14:19.01,Default,,0,0,0,,Vẫn có thể đưa mọi thứ về con số 0, chắc chắn là còn cách cuối cùng
Dialogue: 0,0:14:19.14,0:14:20.77,Default,,0,0,0,,Cho tôi biết mật khẩu của nó đi
Dialogue: 0,0:14:20.89,0:14:23.56,Default,,0,0,0,,Việc xóa hết lập trình là tuyệt mật
Dialogue: 0,0:14:23.69,0:14:26.10,Default,,0,0,0,,Việc này nằm ngoài thẩm quyền của tôi. Tôi không có quyền tiết lộ
Dialogue: 0,0:14:26.56,0:14:27.90,Default,,0,0,0,,Vậy thì xin được cấp quyền đi
Dialogue: 0,0:14:28.11,0:14:28.98,Default,,0,0,0,,Ngay bây giờ!
Dialogue: 0,0:14:29.11,0:14:30.40,Default,,0,0,0,,
Dialogue: 0,0:14:30.65,0:14:33.19,Default,,0,0,0,,À, là tôi đây. Xin hãy nối máy cho anh Manda ở Tokyo-2.
Dialogue: 0,0:14:33.32,0:14:35.07,Default,,0,0,0,,Đúng, là Bộ trưởng Nội vụ
Dialogue: 0,0:14:36.24,0:14:37.53,Default,,0,0,0,,À, việc đó thì
Dialogue: 0,0:14:37.66,0:14:39.95,Default,,0,0,0,,Tôi đã giao cho Yasugi, hãy hỏi anh ta
Dialogue: 0,0:14:41.87,0:14:44.46,Default,,0,0,0,,Những quyết định quan trọng như vậy thì không thể nói miệng được.
Dialogue: 0,0:14:44.58,0:14:46.75,Default,,0,0,0,,Anh gửi công văn chính thức được chứ?
Dialogue: 0,0:14:46.92,0:14:47.75,Default,,0,0,0,,Vậy thì
Dialogue: 0,0:14:47.88,0:14:50.17,Default,,0,0,0,,Có sự cho phép của ông Yoshizawa là được đúng không?
Dialogue: 0,0:14:50.42,0:14:51.34,Default,,0,0,0,,Ừ ừ
Dialogue: 0,0:14:51.46,0:14:53.30,Default,,0,0,0,,Vì chúng tôi đã được sự chấp thuận của ông Witts từ trước rồi
Dialogue: 0,0:14:53.42,0:14:55.30,Default,,0,0,0,,Vâng, vâng, vậy thì
Dialogue: 0,0:14:55.43,0:14:56.43,Default,,0,0,0,,Đùn đẩy cho nhau à
Dialogue: 0,0:14:57.05,0:14:58.51,Default,,0,0,0,,Sắc lệnh đang được gửi xuống
Dialogue: 0,0:14:58.64,0:14:59.89,Default,,0,0,0,,Sắp được triển khai hợp lệ rồi
Dialogue: 0,0:15:00.43,0:15:01.93,Default,,0,0,0,,Nếu thế thì không kịp
Dialogue: 0,0:15:02.06,0:15:04.27,Default,,0,0,0,,Sau khi nó phát nổ rồi thì mọi thứ đã quá muộn
Dialogue: 0,0:15:07.19,0:15:08.27,Default,,0,0,0,,
Dialogue: 0,0:15:08.40,0:15:10.98,Default,,0,0,0,,Jet Alone đang tiến về hướng Atsugi
Dialogue: 0,0:15:11.69,0:15:12.78,Default,,0,0,0,,Không còn thời gian đâu
Dialogue: 0,0:15:12.90,0:15:15.28,Default,,0,0,0,,Từ giờ tôi sẽ phải tự ý hành động
Dialogue: 0,0:15:16.07,0:15:16.99,Default,,0,0,0,,Xin thứ lỗi anh
Dialogue: 0,0:15:17.70,0:15:18.62,Default,,0,0,0,,Ah! Hyuga?
Dialogue: 0,0:15:18.62,0:15:19.07,Default,,0,0,0,,Ah! Hyuga?
Dialogue: 0,0:15:18.62,0:15:19.07,Default,,0,0,0,,♪
Dialogue: 0,0:15:19.07,0:15:19.20,Default,,0,0,0,,♪
Dialogue: 0,0:15:19.20,0:15:20.58,Default,,0,0,0,,♪
Dialogue: 0,0:15:19.20,0:15:20.58,Default,,0,0,0,,Bên Atsugi tôi đã dàn xếp rồi
Dialogue: 0,0:15:20.58,0:15:20.70,Default,,0,0,0,,♪
Dialogue: 0,0:15:20.70,0:15:23.54,Default,,0,0,0,,♪
Dialogue: 0,0:15:20.70,0:15:23.54,Default,,0,0,0,,Đưa Shinji và Unit-01 có trang bị F sang đây
Dialogue: 0,0:15:23.54,0:15:23.66,Default,,0,0,0,,♪
Dialogue: 0,0:15:23.66,0:15:25.12,Default,,0,0,0,,♪
Dialogue: 0,0:15:23.66,0:15:25.12,Default,,0,0,0,,Đúng, tình trạng khẩn cấp
Dialogue: 0,0:15:25.12,0:15:25.25,Default,,0,0,0,,♪
Dialogue: 0,0:15:25.25,0:15:25.62,Default,,0,0,0,,♪
Dialogue: 0,0:15:25.25,0:15:25.62,Default,,0,0,0,,Vô ích thôi. Dừng lại đi, Đại Úy Katsuragi
Dialogue: 0,0:15:25.62,0:15:27.00,Default,,0,0,0,,Vô ích thôi. Dừng lại đi, Đại Úy Katsuragi
Dialogue: 0,0:15:27.58,0:15:29.42,Default,,0,0,0,,Quan trọng là cô định dừng nó bằng cách nào?
Dialogue: 0,0:15:30.29,0:15:32.59,Default,,0,0,0,,Bằng tay người, trực tiếp
Dialogue: 0,0:15:35.17,0:15:36.51,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:15:36.63,0:15:37.68,Default,,0,0,0,,Đúng
Dialogue: 0,0:15:37.80,0:15:40.80,Default,,0,0,0,,Nhưng bên trong ngập các chất ô nhiễm rồi
Dialogue: 0,0:15:41.05,0:15:41.89,Default,,0,0,0,,Rất nguy hiểm
Dialogue: 0,0:15:42.47,0:15:45.27,Default,,0,0,0,,Nếu suôn sẻ thì sẽ cứu được mọi người
Dialogue: 0,0:15:47.06,0:15:50.52,Default,,0,0,0,,Khi tín hiệu điều khiển ở đây bị ngắt, sẽ mở cửa được bằng tay
Dialogue: 0,0:15:50.65,0:15:53.32,Default,,0,0,0,,Cô có thể xâm nhập vào phía sau lưng của nó
Dialogue: 0,0:15:54.32,0:15:55.78,Default,,0,0,0,,"Hi vọng"
Dialogue: 0,0:15:57.15,0:15:59.07,Default,,0,0,0,,Mật khẩu để xóa lập trình
Dialogue: 0,0:16:00.07,0:16:00.99,Default,,0,0,0,,Cảm ơn
Dialogue: 0,0:16:06.45,0:16:07.66,Default,,0,0,0,,Mục tiêu là J.A.
Dialogue: 0,0:16:07.79,0:16:09.92,Default,,0,0,0,,Trong 5 phút nữa sẽ có nguy cơ tan chảy lò phản ứng
Dialogue: 0,0:16:10.54,0:16:12.34,Default,,0,0,0,,Vì vậy, chúng ta không thể để mục tiêu tiến gần hơn vào khu vực đông dân cư
Dialogue: 0,0:16:12.46,0:16:14.71,Default,,0,0,0,,Vì vậy, chúng ta không thể để mục tiêu tiến gần hơn vào khu vực đông dân cư
Dialogue: 0,0:16:14.84,0:16:16.38,Default,,0,0,0,, Hyuga \NVâng
Dialogue: 0,0:16:16.51,0:16:19.01,Default,,0,0,0,,Sau khi tách Eva ra, lập tức rút lui.
Dialogue: 0,0:16:19.13,0:16:21.14,Default,,0,0,0,,Bay lên độ cao an toàn\N Rõ
Dialogue: 0,0:16:21.26,0:16:22.60,Default,,0,0,0,,Shinji\NDạ
Dialogue: 0,0:16:22.72,0:16:25.81,Default,,0,0,0,,Chạy song song với mục tiêu, đặt tôi vào phía sau lưng nó
Dialogue: 0,0:16:25.93,0:16:28.56,Default,,0,0,0,,Từ giờ hãy giữ mục tiêu không cho chuyển động hết sức có thể
Dialogue: 0,0:16:29.48,0:16:31.19,Default,,0,0,0,,Chị sẽ leo lên đó sao, chị Misato?
Dialogue: 0,0:16:31.31,0:16:32.15,Default,,0,0,0,,Đúng vậy
Dialogue: 0,0:16:32.48,0:16:33.48,Default,,0,0,0,,Thế thì quá liều!
Dialogue: 0,0:16:33.82,0:16:36.65,Default,,0,0,0,,Biết là liều nhưng không còn cách nào khác tốt hơn đâu
Dialogue: 0,0:16:36.90,0:16:38.32,Default,,0,0,0,,Nhưng mà... nguy hiểm lắm đó!
Dialogue: 0,0:16:38.82,0:16:40.03,Default,,0,0,0,,Không sao đâu
Dialogue: 0,0:16:40.16,0:16:42.49,Default,,0,0,0,,Nếu là Eva, thì lỡ phát nổ trực diện nó cũng chịu được
Dialogue: 0,0:16:42.70,0:16:45.03,Default,,0,0,0,,Không phải, ý em là chị Misato đó!
Dialogue: 0,0:16:45.54,0:16:48.58,Default,,0,0,0,,Nhưng phải làm hết những gì có thể thôi
Dialogue: 0,0:16:48.71,0:16:50.46,Default,,0,0,0,,Nếu không thì hối tiếc lắm
Dialogue: 0,0:16:53.42,0:16:54.67,Default,,0,0,0,,Xác nhận mục tiêu bằng mắt thường
Dialogue: 0,0:16:59.22,0:17:00.38,Default,,0,0,0,,Rồi, đi thôi
Dialogue: 0,0:17:01.09,0:17:05.22,Default,,0,0,0,,♪
Dialogue: 0,0:17:05.22,0:17:06.47,Default,,0,0,0,,♪
Dialogue: 0,0:17:05.22,0:17:06.47,Default,,0,0,0,,Vị trí thả Eva
Dialogue: 0,0:17:06.47,0:17:06.72,Default,,0,0,0,,♪
Dialogue: 0,0:17:06.72,0:17:08.10,Default,,0,0,0,,♪
Dialogue: 0,0:17:06.72,0:17:08.10,Default,,0,0,0,,Thả ra!\N Rõ!
Dialogue: 0,0:17:08.10,0:17:08.43,Default,,0,0,0,,Thả ra!\N Rõ!
Dialogue: 0,0:17:27.49,0:17:28.33,Default,,0,0,0,,Bắt kịp rồi!
Dialogue: 0,0:17:28.54,0:17:31.58,Default,,0,0,0,,Chỉ còn chưa tới 4 phút! Chạy thẳng đến đó đi!
Dialogue: 0,0:17:36.38,0:17:37.34,Default,,0,0,0,,
Dialogue: 0,0:17:41.76,0:17:43.38,Default,,0,0,0,,Không sao đâu, làm đi!
Dialogue: 0,0:17:48.18,0:17:49.31,Default,,0,0,0,,
Dialogue: 0,0:17:49.43,0:17:51.02,Default,,0,0,0,,Á!\NChị Misato!
Dialogue: 0,0:17:54.40,0:17:55.56,Default,,0,0,0,,Phù...
Dialogue: 0,0:17:55.69,0:17:56.52,Default,,0,0,0,,Cẩn thận chị nhé
Dialogue: 0,0:18:01.57,0:18:02.40,Default,,0,0,0,,Nóng thật
Dialogue: 0,0:18:03.24,0:18:04.82,Default,,0,0,0,,Nguy rồi đây
Dialogue: 0,0:18:04.95,0:18:07.20,Default,,0,0,0,,Dừng lại! Cái thứ này...
Dialogue: 0,0:18:12.83,0:18:14.08,Default,,0,0,0,,Chị Misato, nhanh lên!
Dialogue: 0,0:18:16.29,0:18:17.13,Default,,0,0,0,,Ở đây nhỉ
Dialogue: 0,0:18:23.80,0:18:25.18,Default,,0,0,0,,
Dialogue: 0,0:18:28.18,0:18:31.06,Default,,0,0,0,,
Dialogue: 0,0:18:32.06,0:18:32.89,Default,,0,0,0,,
Dialogue: 0,0:18:32.06,0:18:32.89,Default,,0,0,0,,♪
Dialogue: 0,0:18:32.89,0:18:33.02,Default,,0,0,0,,♪
Dialogue: 0,0:18:33.02,0:18:35.56,Default,,0,0,0,,♪
Dialogue: 0,0:18:33.02,0:18:35.56,Default,,0,0,0,,Báo lỗi? Gì đây chứ
Dialogue: 0,0:18:35.56,0:18:35.69,Default,,0,0,0,,♪
Dialogue: 0,0:18:35.69,0:18:37.02,Default,,0,0,0,,♪
Dialogue: 0,0:18:35.69,0:18:37.02,Default,,0,0,0,,
Dialogue: 0,0:18:37.02,0:18:37.15,Default,,0,0,0,,♪
Dialogue: 0,0:18:37.15,0:18:39.07,Default,,0,0,0,,♪
Dialogue: 0,0:18:37.15,0:18:39.07,Default,,0,0,0,,
Dialogue: 0,0:18:39.07,0:18:40.65,Default,,0,0,0,,
Dialogue: 0,0:18:40.78,0:18:44.03,Default,,0,0,0,,Chắn chắn rồi, lập trình đã bị thay đổi
Dialogue: 0,0:18:44.15,0:18:44.99,Default,,0,0,0,,
Dialogue: 0,0:18:46.70,0:18:47.53,Default,,0,0,0,,Á!
Dialogue: 0,0:18:50.62,0:18:52.79,Default,,0,0,0,,Năng lượng trong lò phản ứng, còn 0.2 đạt ngưỡng giới hạn
Dialogue: 0,0:18:53.37,0:18:55.00,Default,,0,0,0,,Thanh điều khiển không hoạt động!
Dialogue: 0,0:18:55.46,0:18:57.79,Default,,0,0,0,,Vầy thì phải đánh liều thôi
Dialogue: 0,0:18:59.46,0:19:00.67,Default,,0,0,0,,
Dialogue: 0,0:19:01.30,0:19:02.63,Default,,0,0,0,,
Dialogue: 0,0:19:03.63,0:19:05.68,Default,,0,0,0,,
Dialogue: 0,0:19:07.84,0:19:09.14,Default,,0,0,0,,
Dialogue: 0,0:19:09.72,0:19:12.27,Default,,0,0,0,,
Dialogue: 0,0:19:15.14,0:19:16.64,Default,,0,0,0,,Chị Misato! Chạy đi!
Dialogue: 0,0:19:17.15,0:19:20.06,Default,,0,0,0,,Di chuyển đi!!
Dialogue: 0,0:19:24.53,0:19:25.36,Default,,0,0,0,,Chị Misato!
Dialogue: 0,0:19:26.65,0:19:28.53,Default,,0,0,0,,
Dialogue: 0,0:19:29.32,0:19:30.45,Default,,0,0,0,,
Dialogue: 0,0:19:30.91,0:19:32.70,Default,,0,0,0,,Còn 0.1 đạt cực hạn!
Dialogue: 0,0:19:32.95,0:19:34.70,Default,,0,0,0,,Không ổn rồi, sẽ phát nổ
Dialogue: 0,0:19:34.83,0:19:36.00,Default,,0,0,0,,Không được rồi sao...
Dialogue: 0,0:19:36.12,0:19:36.96,Default,,0,0,0,,Chị Misato!
Dialogue: 0,0:19:37.46,0:19:40.13,Default,,0,0,0,,
Dialogue: 0,0:19:41.59,0:19:42.84,Default,,0,0,0,,
Dialogue: 0,0:19:42.96,0:19:44.01,Default,,0,0,0,,
Dialogue: 0,0:19:58.31,0:19:59.73,Default,,0,0,0,,
Dialogue: 0,0:20:00.44,0:20:01.27,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:20:01.61,0:20:02.48,Default,,0,0,0,,Áp suất giảm!
Dialogue: 0,0:20:02.61,0:20:03.69,Default,,0,0,0,,Tất cả về vị trí ổn định!
Dialogue: 0,0:20:03.82,0:20:06.61,Default,,0,0,0,,Được cứu rồi!\N Tốt quá!
Dialogue: 0,0:20:07.24,0:20:08.95,Default,,0,0,0,,Mừng quá! Mừng quá! Mừng quá!
Dialogue: 0,0:20:09.78,0:20:10.62,Default,,0,0,0,,Ả ngốc này
Dialogue: 0,0:20:11.32,0:20:13.03,Default,,0,0,0,,Chị Misato, không sao chứ?
Dialogue: 0,0:20:13.16,0:20:14.20,Default,,0,0,0,,Chị Misato!
Dialogue: 0,0:20:14.33,0:20:17.96,Default,,0,0,0,,Ừ, nhưng mà bất ổn nhiều chút
Dialogue: 0,0:20:18.16,0:20:20.92,Default,,0,0,0,,Tốt rồi! Dù sao thì chị cũng an toàn rồi!
Dialogue: 0,0:20:21.04,0:20:24.21,Default,,0,0,0,,Tốt quá... Thực sự tốt quá
Dialogue: 0,0:20:24.34,0:20:26.88,Default,,0,0,0,,Nhưng chị đỉnh thật! Em phải nhìn chị bằng con mắt khác rồi
Dialogue: 0,0:20:27.01,0:20:28.84,Default,,0,0,0,,Phép màu đã thực sự xảy ra chị nhỉ!
Dialogue: 0,0:20:28.97,0:20:29.88,Default,,0,0,0,,Ừ
Dialogue: 0,0:20:30.34,0:20:33.18,Default,,0,0,0,,Phép màu vốn được chuẩn bị cho ai đó rồi
Dialogue: 0,0:20:34.93,0:20:37.60,Default,,0,0,0,,Đã hoàn tất thu hồi Unit-01 an toàn
Dialogue: 0,0:20:37.73,0:20:39.52,Default,,0,0,0,,Không lo bị ô nhiễm
Dialogue: 0,0:20:39.94,0:20:43.19,Default,,0,0,0,,Ngoài hành động của Đại Úy Katsuragi, mọi thứ đều theo đúng kịch bản
Dialogue: 0,0:20:43.31,0:20:44.82,Default,,0,0,0,,Cô vất vả rồi
Dialogue: 0,0:20:44.94,0:20:47.49,Default,,0,0,0,,
Dialogue: 0,0:20:55.20,0:20:56.29,Default,,0,0,0,,Chào buổi sángg...
Dialogue: 0,0:20:59.75,0:21:02.04,Default,,0,0,0,,
Dialogue: 0,0:21:02.17,0:21:03.58,Default,,0,0,0,,
Dialogue: 0,0:21:04.00,0:21:06.55,Default,,0,0,0,,Rồi~ Tiếp theo là, tắm buổi sáng~
Dialogue: 0,0:21:06.92,0:21:09.34,Default,,0,0,0,,Áo ngực và quần lót đâu rồi ta~
Dialogue: 0,0:21:09.34,0:21:10.34,Default,,0,0,0,,Áo ngực và quần lót đâu rồi ta~
Dialogue: 0,0:21:09.34,0:21:10.34,Default,,0,0,0,,
Dialogue: 0,0:21:10.34,0:21:11.55,Default,,0,0,0,,
Dialogue: 0,0:21:13.18,0:21:15.39,Default,,0,0,0,,Chào buổi sáng, Ikari!
Dialogue: 0,0:21:15.89,0:21:17.10,Default,,0,0,0,,Chào
Dialogue: 0,0:21:17.22,0:21:18.06,Default,,0,0,0,,Em đi đây
Dialogue: 0,0:21:18.60,0:21:20.10,Default,,0,0,0,,Em đi đây
